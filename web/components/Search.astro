---
import { indexRows } from '../lib/data.ts'
import { href } from '../lib/site.ts'

const shared = Object.fromEntries(indexRows().flatMap(row => (row.page === row.gene ? [] : [[row.page, row.protein]])))
---

<form class="search" role="search" action={href('browse/')} data-names={JSON.stringify(shared)} data-about={href('about/')}>
  <label class="visually-hidden" for="search">Search by gene symbol, disease, UniProt accession, Ensembl transcript or RefSeq transcript</label>
  <input
    id="search"
    type="search"
    name="q"
    placeholder="TP53, cystic fibrosis, P04637-2 or ENST00000420246"
    autocomplete="off"
    autocapitalize="none"
    spellcheck="false"
    aria-describedby="search-results"
  />
  <button type="submit" class="button primary">Look up</button>
  <div class="search-results" id="search-results" aria-live="polite"></div>
</form>

<script>
  import '../scripts/search.ts'
</script>
