---
import { Image } from 'astro:assets'

import Layout from '../layouts/Layout.astro'
import { browseQuery } from '../lib/browse.ts'
import { totals } from '../lib/data.ts'
import { GROUPS } from '../lib/features.ts'
import { isoformDiagram } from '../lib/isoform-diagram.ts'
import { INTERFACE_MISSING, MODELLED_MISSING, groupMissing } from '../lib/labels.ts'
import { posts } from '../lib/posts.ts'
import { geneHref, href } from '../lib/site.ts'

const t = totals()
const browse = (view: Parameters<typeof browseQuery>[0]) => href(`browse/${browseQuery(view)}`)
const scope = [
  [t.proteins, 'reviewed human proteins with a described alternative isoform', browse({})],
  [t.isoforms, 'alternative isoforms, each compared with its canonical sequence', browse({ sort: 'isoforms' })],
  [t.withTranscript, 'of those isoforms with an Ensembl or RefSeq transcript', browse({ sort: 'transcripts' })],
] as const
const lacking = [
  ...GROUPS.map(group => [t.lacking[group], groupMissing(group), browse({ has: group })] as const),
  [
    t.lacking.interface,
    `${INTERFACE_MISSING}, among the ${t.interfaceProteins.toLocaleString()} proteins that have one`,
    browse({ has: 'interface' }),
  ],
  [t.lacking.folded, MODELLED_MISSING, browse({ has: 'modelled' })],
] as const
const all = await posts()
---

<Layout>
  <section class="hero">
    <div class="hero-top">
      <div>
        <h1>Explore human protein isoforms</h1>
        <p class="lede">
          Compare each isoform with UniProt's canonical protein, residue by residue, across domains, sites, AlphaFold models
          and predicted partner interfaces.
        </p>
      </div>
      <Fragment set:html={isoformDiagram()} />
    </div>
    <figure class="hero-shot">
      <img
        src={href('preview.png')}
        width="2200"
        height="568"
        fetchpriority="high"
        alt="The ZDHHC16 gene page's map: topology, domains, sites, canonical pLDDT and numbered exons above four isoforms drawn on the canonical sequence, each bar cut at the exon junctions, with the DHHC domain highlighted down the rows"
      />
      <figcaption>
        Each gene page draws every isoform of a protein on its canonical sequence, under the canonical's domains, sites,
        model confidence and exons. Here, ZDHHC16, whose isoform 2 skips exon 8, with its DHHC domain highlighted.
        <a href={geneHref('ZDHHC16')}>Open the ZDHHC16 page</a>
      </figcaption>
    </figure>
  </section>

  <section>
    <h2>What you can explore</h2>
    <div class="tiles wide">
      {
        scope.map(([value, label, link]) => (
          <a class="tile" href={link}>
            <div class="value">{value.toLocaleString()}</div>
            <div class="label">{label}</div>
          </a>
        ))
      }
    </div>
    <h3>Alternative isoforms…</h3>
    <div class="tiles wide">
      {
        lacking.map(([value, label, link]) => (
          <a class="tile" href={link}>
            <div class="value">{value.toLocaleString()}</div>
            <div class="label">{label}</div>
          </a>
        ))
      }
    </div>
    <p class="muted">
      Missing means canonical residues with nothing in their place. A stretch replaced by other sequence is shown on each
      gene page but not counted here. Each tile opens the protein table filtered or sorted to match.
    </p>
  </section>

  <section>
    <h2>Worked examples</h2>
    <div class="post-cards">
      {
        all.map(post => (
          <a class="post-card" href={href(`blog/${post.id}/`)}>
            <Image src={post.data.hero} alt="" widths={[360, 720]} sizes="(max-width: 640px) calc(100vw - 32px), 360px" />
            <strong>{post.data.title}</strong>
            <span class="muted">{post.data.description}</span>
          </a>
        ))
      }
    </div>
  </section>
  <p class="note">
    Isoform explorer compares sequences. For where and how much each transcript is expressed, see{' '}
    <a href="https://gtexportal.org/">GTEx</a>.
  </p>
</Layout>
