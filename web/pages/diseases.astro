---
import { geneName } from '../../src/diseases.ts'
import { SYSTEMS } from '../../src/types.ts'
import Layout from '../layouts/Layout.astro'
import { diseases } from '../lib/data.ts'
import { diseaseHref } from '../lib/diseases.ts'

const all = diseases()
const proteins = new Set(all.flatMap(d => d.genes.map(g => g.page))).size
const groups = SYSTEMS.map(s => ({ ...s, count: all.filter(d => d.systems.some(k => k === s.key)).length }))
---

<Layout
  title="Diseases"
  nav="diseases"
  description="Diseases UniProt links to proteins with a described alternative isoform, grouped by body system, each with the isoforms of those proteins."
>
  <h1>Diseases</h1>
  <p class="lede">
    UniProt links {proteins.toLocaleString()} of the proteins on this site to {all.length.toLocaleString()} diseases. A
    disease page draws the isoforms of those proteins on the canonical sequence, residue by residue.
  </p>
  <div class="disease-groups" role="group" aria-label="Disease groups">
    {
      groups.map(g => (
        <button type="button" class="chip" data-group={g.key} aria-pressed="false">
          {g.label} <span class="muted">{g.count.toLocaleString()}</span>
        </button>
      ))
    }
  </div>
  <p class="muted small">
    Groups follow the <a href="https://mondo.monarchinitiative.org/">MONDO</a> disease ontology, through each disease's
    OMIM id; a disease can sit in several.
  </p>
  <p>
    <label>
      Filter by disease or gene
      <input type="search" class="disease-filter" placeholder="cystic fibrosis, CFTR" autocomplete="off" />
    </label>
  </p>
  <p class="muted disease-count" aria-live="polite"></p>
  <ul class="disease-list">
    {
      all.map(disease => (
        <li
          data-text={`${disease.name} ${disease.acronym} ${disease.genes.map(geneName).join(' ')}`.toLowerCase()}
          data-groups={disease.systems.join(' ')}
        >
          <a href={diseaseHref(disease)}>{disease.name}</a>{' '}
          <span class="muted">· {disease.genes.map(geneName).join(', ')}</span>
        </li>
      ))
    }
  </ul>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>('.disease-filter')
  const count = document.querySelector<HTMLElement>('.disease-count')
  const items = [...document.querySelectorAll<HTMLLIElement>('.disease-list li')]
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.disease-groups button')]
  let group = new URLSearchParams(location.search).get('group') ?? ''

  const apply = () => {
    const words = (input?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean)
    let shown = 0
    for (const item of items) {
      const text = item.dataset.text ?? ''
      const groups = (item.dataset.groups ?? '').split(' ')
      item.hidden = !(words.every(word => text.includes(word)) && (!group || groups.includes(group)))
      shown += item.hidden ? 0 : 1
    }
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.group === group))
    }
    if (count) {
      count.textContent = shown === items.length ? '' : `${shown.toLocaleString()} of ${items.length.toLocaleString()} diseases`
    }
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      group = group === button.dataset.group ? '' : (button.dataset.group ?? '')
      const url = new URL(location.href)
      if (group) {
        url.searchParams.set('group', group)
      } else {
        url.searchParams.delete('group')
      }
      history.replaceState(null, '', url)
      apply()
    })
  }
  input?.addEventListener('input', apply)
  apply()
</script>
