---
import Layout from '../layouts/Layout.astro'
import { COLUMNS, FILTERS } from '../lib/browse.ts'
import { totals } from '../lib/data.ts'
import { COLUMN_NOTES, LACKING_PHRASES, lackingTotals } from '../lib/labels.ts'
import { href } from '../lib/site.ts'

const t = totals()
---

<Layout title="Browse" nav="browse" description="Every protein with a described alternative isoform, with how its isoforms compare with the canonical sequence.">
  <h1>Browse</h1>
  <p class="lede">
    One row for each of the {t.proteins.toLocaleString()} proteins. Counts are of alternative isoforms, each measured
    against the canonical sequence, and include only residues with nothing in their place.
    See <a href={href('about/')}>About</a> for the rules.
  </p>
  <details class="column-notes">
    <summary>What each column counts</summary>
    <dl>
      {
        COLUMNS.map(c => (
          <>
            <dt>{c.label}</dt>
            <dd>{COLUMN_NOTES[c.key]}</dd>
          </>
        ))
      }
    </dl>
  </details>
  <form class="toolbar browse-toolbar" role="search" action="" data-index={href('data/index.json')}>
    <input type="search" name="q" placeholder="Filter by gene, accession or protein" aria-label="Filter by gene, accession or protein" autocomplete="off" />
    <label>
      Show
      <select name="has">
        <option value="">all proteins</option>
        {FILTERS.map(f => <option value={f.key}>proteins with an isoform {LACKING_PHRASES[f.key]}</option>)}
      </select>
    </label>
    <span class="muted" data-count aria-live="polite">Loading {t.proteins.toLocaleString()} proteins…</span>
  </form>
  <p class="scroll-hint muted" hidden>Scroll the table sideways for more columns →</p>
  <div class="table-wrap browse-wrap">
    <table class="browse" id="browse" data-phrases={JSON.stringify(LACKING_PHRASES)} data-totals={JSON.stringify(lackingTotals(t))}>
      <thead>
        <tr>
          {
            COLUMNS.map(c => (
              <th class={c.num ? 'num' : undefined} title={COLUMN_NOTES[c.key]} data-key={c.key}>
                <button type="button">{c.label}</button>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
  <p class="browse-more">
    <button type="button" class="button" hidden>Show more</button>
  </p>
  <noscript><p class="note">The table is drawn by JavaScript from <a href={href('data/index.json')}>index.json</a>.</p></noscript>
</Layout>

<script>
  import '../scripts/browse.ts'
</script>
