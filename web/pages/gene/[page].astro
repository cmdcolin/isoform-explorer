---
import '../../styles/gene.css'
import { isoformAtLocusUrl, isoformUrl, transcriptsUrl } from '../../../src/links.ts'
import type { Isoform } from '../../../src/types.ts'
import TranscriptList from '../../components/TranscriptList.astro'
import Layout from '../../layouts/Layout.astro'
import { gene, indexRows } from '../../lib/data.ts'
import { diseaseHref, diseasesOfPage } from '../../lib/diseases.ts'
import { GROUPS, GROUP_LABELS } from '../../lib/features.ts'
import { codingNote } from '../../lib/labels.ts'
import {
  FOLDED_PLDDT,
  UNFOLDED_PLDDT,
  answer,
  changeFeatures,
  changeText,
  changes,
  count,
  editEffects,
  editPreview,
  featureLabel,
  featureRuns,
  confidenceText,
  interfaceLossText,
  interfaceRows,
  listText,
  lossText,
  maneIsoform,
  modelText,
  plural,
  transcriptOf,
} from '../../lib/loss.ts'
import { blocks, isoformMap, isoformStrip, spanData } from '../../lib/maps.ts'
import { INTERFACE_EXPLORER, JBROWSE } from '../../lib/site.ts'
import { structureMap } from '../../lib/structures.ts'

export function getStaticPaths() {
  const only = (process.env.PAGES ?? '').split(',').filter(Boolean)
  return indexRows()
    .filter(row => !only.length || only.includes(row.page))
    .map(row => ({ params: { page: row.page } }))
}

const COLLAPSE = 12
const SUBUNIT_WORDS = 120
const record = gene(Astro.params.page ?? '')
const subunitText = record.subunit.flatMap(n => n.text.split(/\s+/))
const canonical = record.canonical
const mane = maneIsoform(record)
const maneElsewhere = mane && mane.accession !== canonical.accession ? mane : undefined
const symbol = record.gene !== record.accession
const genomeUrl = record.locus
  ? transcriptsUrl(record.locus, JBROWSE)
  : symbol
    ? transcriptsUrl(record.gene, JBROWSE)
    : ''
const proteinViewUrl = (transcript: string, structures: { url: string }[]) =>
  record.locus
    ? isoformAtLocusUrl(record.gene, transcript, structures, record.locus, JBROWSE)
    : isoformUrl(record.gene, transcript, structures, JBROWSE)
const explorerGene = record.explorer.gene
const explorerIsoforms = record.explorer.isoforms
const uniprot = `https://www.uniprot.org/uniprotkb/${record.accession}/entry`
const others = record.isoforms.length
const linkedDiseases = diseasesOfPage(record.page)
const events = listText(record.events.map(e => e.toLowerCase()))
const partners = Object.keys(record.interfaces).length
const noteKey = (n: { topic: string; text: string }) => `${n.topic}\n${n.text}`
const sharedNotes = [
  ...Map.groupBy(
    [canonical, ...record.isoforms].flatMap(i => i.notes.map(n => ({ note: n, accession: i.accession }))),
    entry => noteKey(entry.note),
  ).values(),
]
  .filter(entries => entries.length > 1)
  .map(entries => ({ note: entries[0]?.note ?? { topic: '', text: '' }, accessions: entries.map(e => e.accession) }))
const shared = new Set(sharedNotes.map(s => noteKey(s.note)))
const ownNotes = (i: { notes: { topic: string; text: string }[] }) => i.notes.filter(n => !shared.has(noteKey(n)))
const sharesNotes = (i: { notes: { topic: string; text: string }[] }) => i.notes.some(n => shared.has(noteKey(n)))

function titleOf(i: { name: string; synonyms: string[]; accession: string }) {
  const named = i.accession.endsWith(`-${i.name}`) ? '' : i.name
  return [named && `isoform ${named}`, ...i.synonyms].filter(Boolean).join(' · ')
}

function superposedUrl(i: Isoform) {
  const transcript = transcriptOf(i)
  return symbol && transcript && i.model && canonical.model
    ? proteinViewUrl(transcript, [{ url: i.model.cif }, { url: canonical.model.cif }])
    : ''
}

const canonicalTranscript = transcriptOf(canonical)
const canonical3d =
  symbol && canonicalTranscript && canonical.model
    ? proteinViewUrl(canonicalTranscript, [{ url: canonical.model.cif }])
    : ''

const sections = record.isoforms.map(i => {
  const blocksOf = changes(editEffects(i)).map(change => {
    const lost = changeFeatures(change, record.features)
    return {
      text: changeText(change),
      removes: change.missing + change.replaced > 0,
      span: spanData(change.effects.map(e => [e.edit.start, e.edit.end])),
      previews: change.effects.map(e => editPreview(e.edit)),
      groups: GROUPS.map(group => ({
        group,
        label: GROUP_LABELS[group],
        items: lost
          .filter(e => e.group === group)
          .map(e => ({ label: featureLabel(e.feature), loss: lossText(e), span: spanData(featureRuns(e.feature)) })),
      })).filter(g => g.items.length),
    }
  })
  const interfaces = interfaceRows(record, i)
  return {
    isoform: i,
    title: titleOf(i),
    answer: answer(record, i),
    strip: isoformStrip(record, i),
    changes: blocksOf,
    confidence: confidenceText(record, i),
    partners: interfaces.length,
    touched: interfaces.filter(r => r.missing + r.replaced > 0).map(r => ({ text: interfaceLossText(r), span: spanData(blocks(r.residues)) })),
    intact: interfaces.filter(r => r.missing + r.replaced === 0).map(r => r.name),
    notes: ownNotes(i),
    sharesNotes: sharesNotes(i),
    model: modelText(record, i),
    superposed: superposedUrl(i),
  }
})
const structures = structureMap(record, mane?.accession)
const description = `What ${others === 1 ? 'the one alternative isoform' : `each of the ${others} alternative isoforms`} of ${record.gene} (${record.protein}) lacks relative to the canonical protein: residues, UniProt features, model confidence${partners ? ' and predicted partner interfaces' : ''}.`
---

<Layout title={`${record.gene} isoforms`} description={description}>
  <div class="gene-head">
    <h1>{record.gene} <span class="muted">· {record.protein}</span></h1>
    <p class="lede">
      UniProt <a href={uniprot}>{record.accession}</a> describes {others + 1} isoforms of this {count(record.length)}-residue
      protein{events && <>, from {events}</>}. {others === 1 ? 'The section below lists what the one alternative isoform lacks relative to' : `Each section below lists what one of the ${others} alternative isoforms lacks relative to`}{' '}
      the canonical isoform, <a href={`#${canonical.accession}`}>{canonical.accession}</a>.
    </p>
    {
      maneElsewhere ? (
        <p class="note mane-note">
          <strong>MANE Select encodes <a href={`#${maneElsewhere.accession}`}>{maneElsewhere.accession}</a>, not UniProt's
          canonical isoform.</strong> Every loss on this page is measured against the canonical, {canonical.accession}, so the
          section for {maneElsewhere.accession} lists what the MANE Select protein lacks relative to it, and the canonical
          has no MANE Select transcript.
        </p>
      ) : mane ? (
        <p class="muted">
          The canonical isoform is the one the MANE Select transcript encodes ({[mane.transcripts.refseq[0], mane.transcripts.ensembl[0]].filter(Boolean).join(', ')}).
        </p>
      ) : (
        <p class="muted">UniProt maps no MANE Select transcript to any isoform of this protein.</p>
      )
    }
    {codingNote(record.coding) && <p class="muted">{codingNote(record.coding)}</p>}
    {
      linkedDiseases.length > 0 && (
        <p class="muted">
          UniProt links {record.gene} to{' '}
          {linkedDiseases.map((disease, k) => (
            <>
              {k > 0 && (k === linkedDiseases.length - 1 ? ' and ' : ', ')}
              <a href={diseaseHref(disease)}>{disease.name}</a>
            </>
          ))}
          .
        </p>
      )
    }
    {
      (explorerGene || explorerIsoforms) && (
        <p class="muted">
          Interface explorer shows{' '}
          {explorerGene && (
            <a href={`${INTERFACE_EXPLORER}gene/${encodeURIComponent(explorerGene)}/`}>
              {record.gene}'s predicted interfaces with its ClinVar variants
            </a>
          )}
          {explorerGene && explorerIsoforms && ' and '}
          {explorerIsoforms && (
            <a href={`${INTERFACE_EXPLORER}isoforms/${encodeURIComponent(explorerIsoforms)}/`}>
              which ClinVar pathogenic sites each of its isoforms lacks
            </a>
          )}
          ; this site shows no variants.
        </p>
      )
    }
    <div class="actions">
      <a class="button" href={uniprot}>UniProt entry</a>
      {genomeUrl && <a class="button" href={genomeUrl}>Transcripts on the genome</a>}
      {canonical.model && <a class="button" href={`https://alphafold.ebi.ac.uk/entry/${canonical.model.entry}`}>AlphaFold DB canonical model</a>}
    </div>
    {
      genomeUrl && !record.locus && (
        <p class="muted small">
          The genome view looks up the gene symbol {record.gene} in JBrowse's RefSeq and GENCODE tracks; where RefSeq names
          the gene differently, it finds no results.
        </p>
      )
    }
  </div>

  <h2>Isoforms on the canonical sequence</h2>
  <p class="muted">
    Features of the canonical protein sit above one row per isoform, all on the canonical's {count(record.length)} residues.
    Hover a feature, a partner row or a loss listed below to run its residues down the rows; click a row to jump to its
    section.
  </p>
  <div class="gene-map">
    {
      structures && (
        <fieldset class="view-toggle">
          <legend class="visually-hidden">Map view</legend>
          <label><input type="radio" name="map-view" value="protein" checked /> Protein</label>
          <label><input type="radio" name="map-view" value="gene" /> Gene + protein</label>
        </fieldset>
      )
    }
    <p class="scroll-hint">Scroll the map sideways to see all {count(record.length)} residues →</p>
    <div class="map-wrap">
      <Fragment set:html={structures} />
      <Fragment set:html={isoformMap(record, mane?.accession)} />
    </div>
    {
      structures && (
        <p class="structure-note muted small">
          Exons of one GENCODE 49 transcript per isoform{record.locus && <>, {record.locus}</>}, drawn in the direction of
          transcription. Thick boxes are coding; thin ones are untranslated and drawn at a fifth of the scale; introns are cut to a
          fixed width. The band joins the canonical's coding exons to the residues they encode.
        </p>
      )
    }
  </div>
  <div class="legend">
    <span><span class="swatch kept"></span>present</span>
    <span>gap: missing</span>
    <span><span class="swatch replaced-swatch"></span>replaced by other residues</span>
    <span><span class="swatch inserted"></span>residues the canonical lacks</span>
    {
      record.exons && (
        <span>
          <span class="swatch exon"></span>exons of {record.exons.transcript}; a white cut marks each junction
        </span>
      )
    }
    {
      canonical.model?.plddt && (
        <span>
          canonical pLDDT <span class="swatch b90"></span>≥ 90 <span class="swatch b70"></span>≥ {FOLDED_PLDDT}
          <span class="swatch b50"></span>≥ {UNFOLDED_PLDDT} <span class="swatch b0"></span>&lt; {UNFOLDED_PLDDT}
        </span>
      )
    }
    {
      partners > 0 && (
        <span>
          <span class="swatch" style="background:var(--interface)"></span>predicted interface with a partner; circles show
          the share of its residues present in the isoform
        </span>
      )
    }
  </div>
  {
    !canonical.model ? (
      <p class="muted">AlphaFold DB has no full-length model of the canonical protein, so there is no pLDDT row.</p>
    ) : !canonical.model.plddt ? (
      <p class="muted">The canonical model's confidence is not yet fetched, so there is no pLDDT row.</p>
    ) : null
  }
  {partners === 0 && <p class="muted">No AlphaFold DB complex of this protein has a confident predicted interface.</p>}
  {
    record.subunit.length > 0 && (
      <div class="shared-notes" id="subunit">
        <h2>UniProt on subunits and partners</h2>
        <p class="muted">
          UniProt attaches {plural(record.subunit.length, 'Subunit comment')} to {record.accession} as a whole, not to
          an isoform, so what it says here is not a statement about any one isoform below. Where UniProt names an
          isoform, the quote names it.
        </p>
        {subunitText.length > SUBUNIT_WORDS ? (
          <details>
            <summary>UniProt’s wording, {plural(subunitText.length, 'word')}</summary>
            {record.subunit.map(n => <p class="quote">“{n.text}.”</p>)}
          </details>
        ) : (
          record.subunit.map(n => <p class="quote">“{n.text}.”</p>)
        )}
      </div>
    )
  }
  {
    sharedNotes.length > 0 && (
      <div class="shared-notes" id="shared-notes">
        <h2>UniProt notes on several isoforms</h2>
        {sharedNotes.map(n => (
          <p class="quote">
            “{n.note.text}.” <cite>UniProt, {n.note.topic}; on {listText(n.accessions)}</cite>
          </p>
        ))}
      </div>
    )
  }

  <section class="isoform" id={canonical.accession} data-isoform={canonical.accession}>
    <h2>
      <a href={`#${canonical.accession}`}>{canonical.accession}</a> <span class="muted">canonical{titleOf(canonical) && ` · ${titleOf(canonical)}`} · {count(record.length)} residues</span>
      {canonical.transcripts.maneSelect && <span class="badge">MANE Select</span>}
    </h2>
    <p class="answer">
      {canonical.accession} is UniProt's canonical isoform, and every other section on this page is measured against its{' '}
      {count(record.length)} residues.
      {maneElsewhere && <> MANE Select encodes <a href={`#${maneElsewhere.accession}`}>{maneElsewhere.accession}</a> instead.</>}
    </p>
    <dl class="facts">
      <dt>Model</dt>
      <dd>
        {
          !canonical.model
            ? 'AlphaFold DB has no full-length model of the canonical sequence.'
            : canonical.model.meanPlddt === null
              ? `${canonical.model.entry}; its confidence is not yet fetched.`
              : `${canonical.model.entry}, mean pLDDT ${canonical.model.meanPlddt.toFixed(1)}.`
        }
      </dd>
      {
        canonical.notes.length > 0 && (
          <>
            <dt>UniProt's notes</dt>
            <dd>
              {ownNotes(canonical).map(n => (
                <p class="quote">
                  “{n.text}.” <cite>UniProt, {n.topic}</cite>
                </p>
              ))}
              {sharesNotes(canonical) && <p class="muted">Also UniProt's <a href="#shared-notes">notes on several isoforms</a>, above.</p>}
            </dd>
          </>
        )
      }
      <dt>Transcripts</dt>
      <dd>
        <TranscriptList
          transcripts={canonical.transcripts}
          none="UniProt maps no Ensembl or RefSeq transcript to the canonical isoform."
        />
      </dd>
    </dl>
    <div class="actions">
      {canonical3d && <a class="button" href={canonical3d}>Canonical model in JBrowse</a>}
    </div>
  </section>

  {
    sections.map(s => (
      <section class="isoform" id={s.isoform.accession} data-isoform={s.isoform.accession}>
        <h2>
          <a href={`#${s.isoform.accession}`}>{s.isoform.accession}</a>{' '}
          <span class="muted">
            {s.title && `${s.title} · `}
            {count(s.isoform.length)} residues
          </span>
          {s.isoform.transcripts.maneSelect && <span class="badge">MANE Select</span>}
        </h2>
        <p class="answer">{s.answer}</p>
        <Fragment set:html={s.strip} />
        {s.changes.map(c => (
          <div class="change" data-span={c.span}>
            <p class="change-head">{c.text}</p>
            {c.previews.map(p => (
              <span class="seq">{p}</span>
            ))}
            {c.groups.length ? (
              <ul class="losses">
                {c.groups.map(g =>
                  g.items.length > COLLAPSE ? (
                    <li>
                      <details>
                        <summary>
                          {g.label}: {plural(g.items.length, 'feature')}
                        </summary>
                        {g.items.map((item, k) => (
                          <>
                            {k > 0 && '; '}
                            <span data-span={item.span}>
                              {item.label}: {item.loss}
                            </span>
                          </>
                        ))}
                      </details>
                    </li>
                  ) : (
                    <li>
                      <span class="group">{g.label}:</span>{' '}
                      {g.items.map((item, k) => (
                        <>
                          {k > 0 && '; '}
                          <span data-span={item.span}>
                            {item.label}: {item.loss}
                          </span>
                        </>
                      ))}
                    </li>
                  ),
                )}
              </ul>
            ) : c.removes ? (
              <p class="muted">No UniProt feature of the canonical protein lies here.</p>
            ) : null}
          </div>
        ))}
        <dl class="facts">
          <dt>Canonical model confidence</dt>
          <dd>{s.confidence}</dd>
          {s.partners > 0 && (
            <>
              <dt>Partner interfaces</dt>
              <dd>
                {s.touched.length > 0 && s.touched.length <= COLLAPSE / 2 && (
                  <p>
                    {s.touched.map((r, k) => (
                      <>
                        {k > 0 && '; '}
                        <span data-span={r.span}>{r.text}</span>
                      </>
                    ))}
                    .
                  </p>
                )}
                {s.touched.length > COLLAPSE / 2 && (
                  <details>
                    <summary>{plural(s.touched.length, 'partner')} with interface residues missing or replaced</summary>
                    {s.touched.map((r, k) => (
                      <>
                        {k > 0 && '; '}
                        <span data-span={r.span}>{r.text}</span>
                      </>
                    ))}
                    .
                  </details>
                )}
                <p class={s.touched.length ? 'muted' : ''}>
                  {s.touched.length === 0
                    ? `Every predicted interface residue is present, for ${plural(s.partners, 'partner')}. `
                    : s.intact.length > 0 && `Every interface residue is present for ${listText(s.intact)}. `}
                  Each isoform was modelled alone, so a present residue shows only that the residue is there.
                </p>
              </dd>
            </>
          )}
          <dt>Own model</dt>
          <dd>{s.model}</dd>
          {s.isoform.notes.length > 0 && (
            <>
              <dt>UniProt's notes</dt>
              <dd>
                {s.sharesNotes && <p class="muted">See UniProt's <a href="#shared-notes">notes on several isoforms</a>, above.</p>}
                {s.notes.map(n => (
                  <p class="quote">
                    “{n.text}.” <cite>UniProt, {n.topic}</cite>
                  </p>
                ))}
              </dd>
            </>
          )}
          <dt>Transcripts</dt>
          <dd>
            <TranscriptList
              transcripts={s.isoform.transcripts}
              none="UniProt maps no Ensembl or RefSeq transcript to this isoform, so no transcript search leads here."
            />
          </dd>
        </dl>
        <div class="actions">
          <a class="button" href={`${uniprot}#${s.isoform.accession}`}>UniProt isoform</a>
          {s.isoform.model && (
            <a class="button" href={`https://alphafold.ebi.ac.uk/entry/${s.isoform.model.entry}`}>AlphaFold DB entry</a>
          )}
          {s.superposed && (
            <a class="button" href={s.superposed}>
              Superposed on the canonical in JBrowse
            </a>
          )}
        </div>
      </section>
    ))
  }
  <script>
    import '../../scripts/columns.ts'
  </script>
</Layout>
