---
import { CONFIDENT, CONTACT, MIN_PLDDT } from '../../src/interfaces.ts'
import { FOLDED_PLDDT, INTERFACE_LOST_SHARE, SWAP_SHARE } from '../../src/isoforms.ts'
import Layout from '../layouts/Layout.astro'
import { architectureSvg } from '../lib/architecture.ts'
import { totals } from '../lib/data.ts'
import { share } from '../lib/labels.ts'
import { INTERFACE_EXPLORER, JBROWSE, REPOSITORY, href } from '../lib/site.ts'

const t = totals()
const n = (value: number) => value.toLocaleString()

const svg = architectureSvg({ proteins: t.proteins, isoforms: t.isoforms, ipsae: CONFIDENT, contact: CONTACT })

const terms = [
  ['Missing', 'canonical residues with nothing in their place'],
  ['Replaced', `canonical residues swapped for other sequence at least ${share(SWAP_SHARE)} as long`],
  ['Novel', 'isoform residues absent from the canonical protein'],
  ['Feature lost', 'a UniProt feature of the canonical protein that overlaps missing residues'],
  ['Confidently modelled', `pLDDT ≥ ${FOLDED_PLDDT} in the canonical AlphaFold DB monomer`],
  ['Interface residue', `within ${CONTACT} Å of the partner, pLDDT ≥ ${MIN_PLDDT}, in a complex with ipSAE ≥ ${CONFIDENT}`],
  ['Interface lost', `at least ${share(INTERFACE_LOST_SHARE)} of one partner's interface residues missing`],
  ['nonsense_mediated_decay', "GENCODE 49's type for a transcript whose coding sequence ends more than 50 bases before a downstream splice site, quoted beside each Ensembl transcript that has it"],
] as const

const references = [
  ['The UniProt Consortium 2025. UniProt: the Universal Protein Knowledgebase in 2025. Nucleic Acids Res.', 'https://doi.org/10.1093/nar/gkae1010'],
  ['Varadi et al. 2024. AlphaFold Protein Structure Database in 2024. Nucleic Acids Res.', 'https://doi.org/10.1093/nar/gkad1011'],
  ['Han, Tsenkov, Venanzi et al. 2026. AlphaFold Database expands to proteome-scale quaternary structures. Preprint.', 'https://research.nvidia.com/labs/dbr/assets/data/manuscripts/afdb.html'],
  ["Dunbrack 2025. Rēs ipSAE loquuntur: what's wrong with AlphaFold's ipTM score and how to fix it. bioRxiv.", 'https://doi.org/10.1101/2025.02.10.637595'],
  ['Morales et al. 2022. A joint NCBI and EMBL-EBI transcript set for clinical genomics and research. Nature.', 'https://doi.org/10.1038/s41586-022-04558-8'],
  ['Diesh et al. 2023. JBrowse 2: a modular genome browser with views of synteny and structural variation. Genome Biol.', 'https://doi.org/10.1186/s13059-023-02914-z'],
] as const
---

<Layout title="About" nav="about">
  <h1>About</h1>
  <p class="lede">
    Isoform explorer draws each alternative isoform of the {n(t.proteins)} reviewed human UniProt entries that describe
    one on its canonical protein's sequence, and compares the two by residue, feature, model confidence and predicted
    partner interface.
    {t.modelsPending > 0 && <> Confidence for {n(t.modelsPending)} AlphaFold DB models is still being fetched.</>}
  </p>

  <figure class="architecture">
    <div class="architecture-scroll" role="img" aria-label="Pipeline diagram. UniProt entries, AlphaFold DB complexes and monomers, Ensembl transcript places and GENCODE 49 exons feed one step that compares each isoform with its canonical protein and writes one JSON file per protein. The Astro site reads those files and links to JBrowse 2, which shows GENCODE and RefSeq transcripts on hg38.">
      <Fragment set:html={svg} />
    </div>
    <figcaption>
      <span><a href={`${REPOSITORY}/blob/main/docs/running.md`}>Running the pipeline</a> lists each step's command.</span>
    </figcaption>
  </figure>

  <div class="prose">
    <h2>Terms</h2>
    <dl class="terms">
      {terms.map(([term, rule]) => (<><dt>{term}</dt><dd>{rule}</dd></>))}
    </dl>

    <h2>Related data</h2>
    <ul>
      <li>
        Expression by tissue: <a href="https://gtexportal.org/">GTEx</a>. Before using its per-transcript numbers, check the
        reads across the isoform's splice junction, as <a href={href('blog/2026-11-16-where-isoforms-are-made/')}>this post</a> explains.
      </li>
      <li>
        Diseases: UniProt's disease annotations, with the proteins UniProt links to each, on the
        <a href={href('diseases/')}>Diseases</a> pages.
      </li>
      <li>ClinVar variants on predicted interfaces: <a href={INTERFACE_EXPLORER}>Interface explorer</a>.</li>
      <li>Transcripts without a UniProt isoform: the GENCODE and RefSeq tracks in <a href={JBROWSE}>JBrowse 2</a>.</li>
    </ul>

    <h2>References</h2>
    <ul class="references">
      {
        references.map(([text, url]) => (
          <li>
            {text} <a href={url}>{url.replace('https://', '')}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
