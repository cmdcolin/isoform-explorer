---
import Search from '../components/Search.astro'
import Layout from '../layouts/Layout.astro'

const tries = ['TP53', 'cystic fibrosis', 'P04637-2', 'ENST00000420246.6', 'NM_001126114']
---

<Layout title="Search" nav="search">
  <section>
    <h1>Look up a gene, disease or transcript</h1>
    <p>A gene, a UniProt accession, or an Ensembl or RefSeq transcript opens the protein's page at that isoform. A disease name lists the matching disease pages.</p>
    <Search />
    <p class="search-tries muted">
      Try {tries.map((value, index) => (
        <>
          <button type="button" class="link-button" data-search-example="search">{value}</button>{index < tries.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>
  </section>
</Layout>
