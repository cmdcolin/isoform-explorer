cription":"BRCT 6"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Interacts with the C-terminal transactivation domain of PAX2 (By similarity). Forms a constitutive complex with PAGR1 independently of the MLL2/MLL3 complex (By similarity). Interacts with TP53BP1 (when phosphorylated at the N-terminus by ATM) (PubMed:15456759, PubMed:17690115, PubMed:23727112). Interacts with HLTF (PubMed:19723507). Component of the KMT2 family MLL2/MLL3 complex (also named ASCOM complex), at least composed of the HMTs KMT2D and/or KMT2C, the common subunits ASH2L, RBBP5, WDR5 and DPY30, and the complex type-specific subunits PAXIP1/PTIP, PAGR1, NCOA6 and KDM6A; required for the association of PAGR1 with the MLL2/MLL3 complex (PubMed:17178841, PubMed:17500065, PubMed:17761849, PubMed:17925232). Interacts with NUPR1; this interaction prevents PAXIP1 inhibition of PAX2 transcription factor activity (PubMed:11940591)"}],"isoforms":[{"accession":"Q6ZW49-1","name":"2","synonyms":[],"notes":[],"length":1035,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,1],[75,109,961]],"edits":[{"start":1,"end":108,"original":"MSDQAPKVPEEMFREVKYYAVGDIDPQVIQLLKAGKAKEV","replacement":"MVFLQNHVRFFLESLPAFLRVLIQAGALCWSLPELSQGEV","added":74}],"missing":0,"replaced":107,"novel":73,"foldedAbsent":101,"foldedMissing":0,"features":[[0,0,86],[1,0,15],[2,0,15]],"interfaces":{},"model":{"entry":"AF-Q6ZW49-1-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q6ZW49-1-F1-model_v6.cif","meanPlddt":66.3,"plddt":[[0,19],[50,1],[0,42],[50,2],[0,2],[50,3],[70,1],[50,1],[70,1],[50,3],[70,1],[50,2],[70,25],[90,3],[70,18],[90,4],[70,2],[90,2],[70,11],[90,1],[70,7],[50,3],[0,11],[50,2],[0,2],[50,2],[0,2],[50,1],[0,39],[50,1],[0,1],[50,1],[0,226],[50,1],[0,11],[50,1],[0,1],[50,4],[70,50],[50,6],[0,37],[50,2],[70,1],[90,5],[70,8],[90,10],[70,5],[50,5],[70,6],[90,1],[70,2],[90,21],[70,1],[90,2],[70,2],[90,19],[70,1],[90,2],[70,2],[90,17],[70,4],[90