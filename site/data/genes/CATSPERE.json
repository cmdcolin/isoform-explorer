ic channel. The auxiliary CATSPERB, CATSPERG, CATSPERD and CATSPERE subunits form a pavilion-like structure over the pore which stabilizes the complex through interactions with CATSPER4, CATSPER3, CATSPER1 and CATSPER2 respectively. CATSPERH interacts with CATSPERB, further stabilizing the complex. CATSPERT interacts at least with CATSPERD and is required for targeting the CatSper complex in the flagellar membrane (By similarity)"}],"isoforms":[{"accession":"Q5SY80-2","name":"2","synonyms":[],"notes":[],"length":832,"transcripts":{"ensembl":["ENST00000366533.8"],"refseq":["NM_173807.5"],"refseqProteins":["NP_776168.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,830]],"edits":[{"start":831,"end":951,"original":"NYKHCFSYAIGKPGDLNQPYEIINSSNGNHIFWPMGHSGM","replacement":"FL","added":2}],"missing":121,"replaced":0,"novel":2,"foldedAbsent":95,"foldedMissing":95,"features":[[1,73,0],[14,1,0],[17,1,0],[18,1,0],[19,1,0],[20,1,0],[21,21,0],[22,27,0]],"interfaces":{},"model":{"entry":"AF-Q5SY80-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q5SY80-2-F1-model_v6.cif","meanPlddt":88.4,"plddt":[[0,1],[50,2],[0,2],[50,2],[0,10],[50,1],[70,2],[90,6],[70,6],[90,12],[70,3],[90,36],[70,6],[90,8],[70,1],[90,11],[70,6],[90,18],[70,4],[90,24],[70,3],[50,1],[70,3],[90,3],[70,4],[90,1],[70,1],[90,8],[70,4],[50,1],[70,5],[90,4],[70,6],[90,5],[70,10],[90,23],[70,6],[90,14],[70,1],[90,2],[70,1],[90,9],[70,1],[90,15],[70,3],[90,15],[70,1],[90,7],[70,1],[90,16],[70,5],[90,1],[70,6],[90,15],[70,5],[90,15],[70,6],[90,20],[70,10],[90,16],[70,11],[90,25],[70,1],[90,3],[70,1],[90,6],[70,5],[90,16],[70,4],[90,28],[70,1],[90,1],[70,1],[90,7],[70,5],[90,7],[70,3],[90,18],[70,3],[90,11],[70,5],[90,1],[70,1],[90,1],[70,4],[90,53],[70,15],[90,14],[70,1],[90,4],[70,4],[90,7],[70,13],[50,4],[70,5],[90,9],[70,4],[90,9],[70,20],[90,3],[70,7],[90,2],[70,5],[50,1],[70,19],[50,10],[70,10],[50,7],[0,1],[50,1],[0,1]],"losingConfidence":1}},{"accession":"Q5SY80-3","name":"3","synonyms":[],"