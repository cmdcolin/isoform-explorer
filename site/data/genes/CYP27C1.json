{"page":"CYP27C1","gene":"CYP27C1","accession":"Q4G0S4","protein":"Cytochrome P450 27C1","length":542,"events":["Alternative promoter usage"],"canonical":{"accession":"Q4G0S4-2","name":"2","synonyms":[],"notes":[{"topic":"Function","text":"A cytochrome P450 monooxygenase that catalyzes the 3,4 desaturation of all-trans-retinol (also called vitamin A1) to all-trans-3,4-didehydroretinol (also called vitamin A2) in the skin. Desaturates with lower efficiency all-trans retinal and all-trans retinoic acid. Forms minor amounts of 3-hydroxy and 4-hydroxy all-trans-retinol derivatives. Mechanistically, uses molecular oxygen inserting one oxygen atom into a substrate and reducing the second into a water molecule. Two electrons are provided by NADPH via a two-protein mitochondrial transfer system comprising flavoprotein FDXR (adrenodoxin/ferredoxin reductase) and nonheme iron-sulfur protein FDX1 or FDX2 (adrenodoxin/ferredoxin)"}],"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"model":{"entry":"AF-Q4G0S4-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q4G0S4-F1-model_v6.cif","meanPlddt":85.4,"plddt":[[0,6],[50,1],[0,2],[50,3],[0,1],[50,2],[0,49],[50,1],[70,2],[90,10],[70,16],[90,19],[70,2],[50,1],[70,3],[90,22],[70,2],[50,1],[70,6],[90,12],[70,1],[90,14],[70,2],[90,1],[70,1],[90,77],[70,7],[50,6],[0,1],[50,4],[70,14],[90,30],[70,4],[90,142],[70,2],[50,8],[70,1],[90,47],[70,4],[90,14],[70,1]]}},"features":[{"type":"Transit peptide","start":1,"end":80,"description":"Mitochondrion"},{"type":"Binding site","start":488,"end":488,"description":"axial binding residue"}],"interfaces":{},"subunit":[],"isoforms":[{"accession":"Q4G0S4-1","name":"1","synonyms":[],"notes":[],"length":372,"transcripts":{"ensembl":["ENST00000335247.11","ENST00000409327.2"],"refseq":["NM_001001665.4","NM_001367501.1"],"refseqProteins":["NP_001001665.3","NP_001354430.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,171,372]],"edi