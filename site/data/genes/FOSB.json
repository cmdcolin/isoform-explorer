 to the AP-1 consensus sequence but does not stimulate transcription (By similarity). Forms heterodimers with JUND under oxidizing conditions (PubMed:32542236)"}],"length":237,"transcripts":{"ensembl":["ENST00000592436.5"],"refseq":["NM_001411069.1"],"maneSelect":false},"segments":[[1,1,237]],"edits":[{"start":238,"end":338,"original":"VRDLPGSAPAKEDGFSWLLPPPPPPPLPFQTSQDAPPNLT","replacement":"","added":0}],"missing":101,"replaced":0,"novel":0,"foldedAbsent":5,"foldedMissing":5,"features":[],"interfaces":{},"model":{"entry":"AF-P53539-11-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P53539-11-F1-model_v6.cif","meanPlddt":null,"plddt":null,"losingConfidence":null}}]}