{"page":"SLC5A10","gene":"SLC5A10","accession":"A0PJK1","protein":"Sodium/mannose cotransporter SLC5A10","length":596,"events":["Alternative splicing"],"canonical":{"accession":"A0PJK1-1","name":"1","synonyms":["IF2"],"notes":[{"topic":"Function","text":"Electrogenic Na+-coupled sugar symporter that actively transports D-mannose or D-fructose at the plasma membrane, with a Na+ to sugar coupling ratio of 1:1. Transporter activity is driven by a transmembrane Na+ electrochemical gradient set by the Na+/K+ pump. Exclusively recognizes sugar substrates having a pyranose ring with an axial hydroxyl group on carbon 2 (PubMed:22212718, PubMed:23451068, PubMed:24573086). Has likely evolved to enable renal reabsorption of D-mannose, an important constituent of oligosaccharide chains of glycoproteins. Contributes to dietary D-fructose reabsorption from glomerular filtrate across the brush border of the kidney (PubMed:22212718, PubMed:23451068)"}],"transcripts":{"ensembl":["ENST00000395645.4"],"refseq":["NM_001042450.4"],"refseqProteins":["NP_001035915.1"],"maneSelect":true},"model":{"entry":"AF-A0PJK1-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-A0PJK1-F1-model_v6.cif","meanPlddt":87.8,"plddt":[[0,12],[50,3],[70,2],[90,1],[70,3],[90,1],[70,33],[90,13],[70,10],[90,34],[70,4],[90,13],[70,1],[90,15],[70,47],[90,2],[70,1],[90,2],[70,2],[90,2],[70,1],[90,34],[70,7],[90,13],[70,4],[90,31],[70,2],[90,39],[70,1],[90,1],[70,1],[90,2],[70,10],[90,14],[70,19],[90,1],[70,1],[90,16],[70,1],[90,2],[70,3],[90,1],[70,1],[90,3],[70,1],[90,6],[70,2],[90,1],[70,13],[50,5],[70,6],[90,2],[70,1],[90,43],[70,21],[90,29],[70,1],[90,3],[70,2],[90,3],[70,3],[50,2],[0,3],[50,2],[0,4],[50,1],[0,1],[50,4],[70,6],[90,21],[70,1]]}},"features":[{"type":"Topological domain","start":1,"end":15,"description":"Extracellular"},{"type":"Glycosylation","start":4,"end":4,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Transmembrane","start":16,"end":36,"description":"Helical"},{"type":"Topological doma