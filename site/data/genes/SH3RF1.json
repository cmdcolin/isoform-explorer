ic complex) with a 1:1 ratio. Interacts with SIAH1. Interacts with HERP1. Probably part of a signaling complex that may contain SH3RF1, MAPK8IP, DLK1, MAP2K4/MKK4, MAP2K7/MKK7, MAPK8/JNK1, MAPK9/JNK2, AKT1 and AKT2 (PubMed:12514131, PubMed:14504284, PubMed:16230351, PubMed:16571722, PubMed:17420289, PubMed:17535800). Found in a complex with RAC2, MAP3K7/TAK1, MAP2K7/MKK7, MAPK8IP1/JIP1, MAPK8/JNK1 and MAPK9/JNK2. Found in a complex with RAC1, MAP3K11/MLK3, MAP2K7/MKK7, MAPK8IP1/JIP1 and MAPK8/JNK1. Interacts with SH3RF2 (By similarity)"}],"isoforms":[{"accession":"Q7Z6J0-3","name":"2","synonyms":[],"notes":[],"length":441,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,393]],"edits":[{"start":394,"end":888,"original":"TLNPPLPPPPLLAATVLASTPPGATAAAAAAGMGPRPMAG","replacement":"APPPLLLLLEWDRGPWQDPLTRLHIYGRRLAPVCMLLYIH","added":48}],"missing":495,"replaced":0,"novel":48,"foldedAbsent":117,"foldedMissing":117,"features":[[5,104,0],[6,62,0],[7,1,0],[8,1,0],[9,60,0]],"interfaces":{},"model":{"entry":"AF-Q7Z6J0-3-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q7Z6J0-3-F1-model_v6.cif","meanPlddt":64.4,"plddt":[[50,1],[70,9],[90,6],[70,2],[90,21],[70,1],[90,2],[70,4],[90,10],[70,3],[90,6],[70,1],[90,1],[70,10],[50,3],[0,2],[50,1],[0,25],[50,1],[0,25],[50,1],[70,2],[90,9],[70,5],[90,12],[70,6],[90,7],[70,2],[90,13],[70,7],[90,10],[70,3],[50,1],[70,1],[50,1],[70,3],[90,26],[70,1],[90,13],[70,2],[90,2],[70,4],[50,2],[0,60],[50,3],[0,4],[50,1],[0,25],[50,1],[0,6],[50,2],[0,2],[50,1],[0,54],[50,1],[0,1],[50,8],[0,1],[50,1],[0,3]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000154447.16"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":1,"gencode":4,"mapped":1},"explorer":{"gene":null,"isoforms":null},"locus":"chr4:169094259-169270956","exons":{"transcript":"ENST00000284637.14","first":2,"junctions":[393,669,765,1068,1179,1346,1517,1777,2139,2498]},"structures":{"Q7Z6J0-1":