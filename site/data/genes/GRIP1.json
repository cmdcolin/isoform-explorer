 EPHA7, EPHB2, KIF5A, KIF5B, KIF5C, GRIA2, GRIA3, GRIPAP1/GRASP1, PPFIA1, PPFIA4, FRAS1, PLCD4, PTPRF and liprins-alpha. Can form homomultimers or heteromultimers with GRIP2. Forms a ternary complex with GRIA2 and CSPG4 (By similarity). Interacts with ATAD1 in an ATP-dependent manner. ATAD1-catalyzed ATP hydrolysis disrupts binding to ATAD1 and to GRIA2 and leads to AMPAR complex disassembly (By similarity). Interacts with EFNB1, EFNB3 and the C-terminal tail of PRLHR. Interacts with SLC30A9 (By similarity). Interacts with BUD23. Forms a complex with NSG1, GRIA2 and STX12; controls the intracellular fate of AMPAR and the endosomal sorting of the GRIA2 subunit toward recycling and membrane targeting. Interacts with NSG1 (By similarity)"}],"isoforms":[{"accession":"Q9Y3R0-2","name":"2","synonyms":[],"notes":[],"length":1113,"transcripts":{"ensembl":[],"refseq":["NM_001379346.1"],"refseqProteins":["NP_001366275.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,911],[912,927,202]],"edits":[{"start":912,"end":926,"original":"EKADRRVSLRNMTLL","replacement":"","added":0}],"missing":15,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMissing":0,"features":[],"interfaces":{},"model":{"entry":"AF-Q9Y3R0-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9Y3R0-2-F1-model_v6.cif","meanPlddt":62.3,"plddt":[[0,8],[50,1],[0,1],[50,2],[0,30],[50,6],[70,4],[90,2],[70,20],[50,1],[70,4],[90,1],[70,19],[90,2],[70,1],[90,2],[70,2],[90,2],[70,4],[90,1],[70,2],[90,1],[70,12],[90,4],[70,5],[50,3],[0,1],[50,1],[0,1],[50,2],[70,4],[90,6],[70,8],[90,3],[70,8],[50,1],[70,6],[90,1],[70,18],[90,1],[70,1],[90,1],[70,1],[90,2],[70,12],[90,1],[70,10],[90,6],[70,7],[50,1],[70,1],[50,4],[70,10],[50,2],[70,11],[50,4],[70,6],[90,1],[70,53],[50,4],[0,118],[50,4],[0,2],[50,3],[70,12],[50,3],[70,7],[50,11],[70,33],[50,3],[70,26],[50,9],[70,8],[50,4],[70,8],[50,8],[70,33],[50,3],[70,11],[50,1],[70,1],[50,1],[70,8],[50,2],[0,9],[50,2],[70,10],[50,1],[70,12],[50,2],[70,4],[90,1],[70,29],[50