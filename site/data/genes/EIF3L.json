{"page":"EIF3L","gene":"EIF3L","accession":"Q9Y262","protein":"Eukaryotic translation initiation factor 3 subunit L","length":564,"events":["Alternative splicing"],"canonical":{"accession":"Q9Y262-1","name":"1","synonyms":[],"notes":[],"transcripts":{"ensembl":["ENST00000652021.1","ENST00000624234.3"],"refseq":["NM_016091.4"],"refseqProteins":["NP_057175.1"],"maneSelect":true,"decay":[],"onlyDecay":false},"model":{"entry":"AF-Q9Y262-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9Y262-F1-model_v6.cif","meanPlddt":68.8,"plddt":[[0,16],[50,1],[0,7],[50,5],[70,7],[50,3],[0,8],[50,106],[70,12],[50,13],[70,22],[50,22],[70,15],[50,1],[70,3],[50,2],[70,2],[50,19],[70,31],[50,12],[70,39],[50,11],[70,21],[50,1],[70,1],[50,1],[70,22],[50,1],[70,13],[50,21],[70,57],[50,24],[70,11],[50,9],[70,20],[50,3],[0,2]]}},"features":[{"type":"Modified residue","start":2,"end":2,"description":"N-acetylserine"},{"type":"Modified residue","start":21,"end":21,"description":"Phosphoserine"},{"type":"Domain","start":331,"end":537,"description":"PCI"},{"type":"Modified residue","start":465,"end":465,"description":"N6-acetyllysine"},{"type":"Modified residue","start":549,"end":549,"description":"N6-acetyllysine"}],"interfaces":{"EIF3K":[224,225,228,229,232,281,284,285,286,287,288,289,292,325,326,327,381,423,424,441,442,443,445,446,449,450,453,484,487,488,490,491,492,494,495,496,498,500,513,520,521,522,523,524,525,526,529,531,532,533]},"subunit":[{"topic":"Subunit","text":"Component of the eukaryotic translation initiation factor 3 (eIF-3) complex, which is composed of 13 subunits: EIF3A, EIF3B, EIF3C, EIF3D, EIF3E, EIF3F, EIF3G, EIF3H, EIF3I, EIF3J, EIF3K, EIF3L and EIF3M. The eIF-3 complex appears to include 3 stable modules: module A is composed of EIF3A, EIF3B, EIF3G and EIF3I; module B is composed of EIF3F, EIF3H, and EIF3M; and module C is composed of EIF3C, EIF3D, EIF3E, EIF3K and EIF3L. EIF3C of module C binds EIF3B of module A and EIF3H of module B, thereby linking the three modules. EIF3J is a labile subunit that binds to the eIF-3 complex via EIF3B. The eIF-3 complex interacts with RPS6KB1 under conditions of nutrient depletion. Mitogenic stimulation leads to binding and activation of a complex composed of MTOR and RPTOR, leading to phosphorylation and release of RPS6KB1 and binding of EIF4B to eIF-3. Interacts with RRN3"}],"isoforms":[{"accession":"Q9Y262-2","name":"2","synonyms":[],"notes":[],"length":516,"transcripts":{"ensembl":["ENST00000381683.10"],"refseq":["NM_001242923.2"],"refseqProteins":["NP_001229852.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,145],[146,194,371]],"edits":[{"start":146,"end":193,"original":"GGPSLEQRFESYYNYCNLFNYILNADGPAPLELPNQWLWD","replacement":"","added":0}],"missing":48,"replaced":0,"novel":0,"foldedAbsent":27,"foldedMissing":27,"features":[],"interfaces":{},"model":{"entry":"AF-Q9Y262-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9Y262-2-F1-model_v6.cif","meanPlddt":67.5,"plddt":[[0,14],[50,1],[0,1],[50,1],[0,8],[50,5],[70,1],[50,7],[0,9],[50,6],[70,2],[50,2],[70,4],[50,17],[0,1],[50,13],[70,1],[50,49],[0,2],[50,34],[70,11],[50,1],[70,4],[50,1],[70,2],[50,1],[70,1],[50,21],[70,27],[50,12],[70,39],[50,10],[70,22],[50,1],[70,1],[50,1],[70,36],[50,21],[70,57],[50,24],[70,11],[50,9],[70,20],[50,3],[0,2]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000100129.18"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000100129","name":"EIF3L","chromosome":"chr22","readthrough":false}],"gencode":5,"mapped":3},"explorer":{"gene":null,"isoforms":null},"locus":"chr22:37848868-37889407","exons":{"transcript":"ENST00000652021.1","first":1,"junctions":[33,82,293,373,435,505,579,751,906,1077,1575,1656]},"structures":{"Q9Y262-1":{"transcript":"ENST00000652021.1","strand":1,"coding":[37849450,37888464],"exons":[[37849419,37849482],[37850015,37850063],[37851280,37851490],[37855565,37855644],[37858679,37858740],[37862969,37863038],[37863272,37863345],[37870176,