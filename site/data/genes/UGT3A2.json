{"page":"UGT3A2","gene":"UGT3A2","accession":"Q3SY77","protein":"UDP-glycosyltransferase 3A2","length":523,"events":["Alternative splicing"],"canonical":{"accession":"Q3SY77-1","name":"1","synonyms":[],"notes":[{"topic":"Function","text":"Involved in biotransformation reactions in which lipophilic substrates are conjugated with sugars to increase water solubility and enhance excretion. Such reactions are of major importance in the elimination of potentially toxic xenobiotics and endogenous compounds. UGT3A2 catalyzes the addition of sugar residues from UDP-glucose and UDP-xylose to a broad range of acceptor substrates including 4-methylumbelliferone, 1-hydroxypyrene, bioflavones, and estrogens (PubMed:21088224). It has negligible activity toward bile acids and androgens (PubMed:21088224). To a lesser extent, is also able to use UDP-galactose but is inactive with UDP-glucuronic acid or UDP-N-acetylglucosamine as sugar donors (PubMed:21088224, PubMed:22621930)"}],"transcripts":{"ensembl":["ENST00000282507.8"],"refseq":["NM_174914.4"],"refseqProteins":["NP_777574.2"],"maneSelect":true,"decay":[],"onlyDecay":false},"model":{"entry":"AF-Q3SY77-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q3SY77-F1-model_v6.cif","meanPlddt":90.7,"plddt":[[0,9],[50,1],[0,9],[50,2],[70,1],[90,7],[70,8],[90,19],[70,3],[50,10],[70,3],[90,5],[70,4],[90,4],[70,1],[90,3],[70,1],[90,2],[70,2],[90,2],[70,2],[90,1],[70,6],[90,41],[70,2],[90,22],[70,2],[90,100],[70,4],[90,24],[70,2],[50,6],[70,5],[90,17],[70,10],[90,9],[70,3],[90,60],[70,1],[90,94],[70,9],[50,6],[0,1]]}},"features":[{"type":"Signal","start":1,"end":22,"description":""},{"type":"Topological domain","start":23,"end":483,"description":"Extracellular"},{"type":"Glycosylation","start":52,"end":52,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Transmembrane","start":484,"end":504,"description":"Helical"},{"type":"Topological domain","start":505,"end":523,"description":"Cytoplasmic"}],"interfaces":{"UGT3A1":[178,181,182,183,1