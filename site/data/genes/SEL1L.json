6471130)"},{"topic":"Subunit","text":"(Microbial infection) Interacts with human cytomegalovirus protein UL148"}],"isoforms":[{"accession":"Q9UBV2-2","name":"2","synonyms":[],"notes":[],"length":301,"transcripts":{"ensembl":["ENST00000555824.5"],"refseq":["NM_001244984.2"],"refseqProteins":["NP_001231913.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,297]],"edits":[{"start":298,"end":794,"original":"GYRYWAGIGVLQSCESALTHYRLVANHVASDISLTGGSVV","replacement":"VSRL","added":4}],"missing":497,"replaced":0,"novel":4,"foldedAbsent":446,"foldedMissing":446,"features":[[1,440,0],[2,441,0],[13,29,0],[14,186,0],[15,37,0],[16,37,0],[17,1,0],[18,36,0],[19,36,0],[20,36,0],[21,1,0],[22,36,0],[23,81,0],[24,36,0],[25,57,0],[26,21,0],[27,35,0]],"interfaces":{},"model":{"entry":"AF-Q9UBV2-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9UBV2-2-F1-model_v6.cif","meanPlddt":73.4,"plddt":[[50,20],[0,34],[50,1],[0,2],[50,1],[0,53],[50,3],[70,6],[90,1],[70,5],[90,8],[70,1],[90,9],[70,1],[90,2],[70,3],[90,8],[70,1],[90,8],[70,7],[90,23],[70,1],[90,34],[70,1],[90,65],[70,2],[50,1]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000071537.15"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":1,"gencode":15,"mapped":2},"explorer":{"gene":null,"isoforms":"SEL1L"},"locus":"chr14:81471547-81533871","exons":{"transcript":"ENST00000336735.9","first":1,"junctions":[70,108,340,508,614,777,831,891,973,1128,1185,1254,1332,1395,1483,1632,1798,1873,2046,2175]},"structures":{"Q9UBV2-1":{"transcript":"ENST00000336735.9","strand":-1,"coding":[81476972,81533744],"exons":[[81471547,81477181],[81479612,81479740],[81484225,81484397],[81485672,81485746],[81486289,81486454],[81487390,81487538],[81487855,81487942],[81489252,81489314],[81490388,81490465],[81492480,81492548],[81495081,81495137],[81497892,81498046],[81498413,81498494],[81499459,81499518],[81499609,81499662],[81502721,81502883],[81504201,81504306],[81506074,81506241],[81526733,81526964],[81527701,815