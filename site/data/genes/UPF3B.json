ponent of the mRNA splicing-dependent exon junction complex (EJC); the core complex contains CASC3, EIF4A3, MAGOH or MAGOHB, and RBM8A. The EJC core components EIF4A3 and the MAGOH-RBM8A dimer form a composite binding site for UPF3B which overlaps with the EJC binding site for WIBG (PubMed:16601204, PubMed:18066079, PubMed:20479275, PubMed:23917022). Interacts with EST1A, UPF2 and RBM8A (PubMed:12554878, PubMed:15004547, PubMed:18066079). Interacts with CPSF6 (PubMed:19864460). Interacts with DHX34; the interaction is RNA-independent"}],"isoforms":[{"accession":"Q9BZI7-2","name":"2","synonyms":[],"notes":[],"length":470,"transcripts":{"ensembl":["ENST00000345865.6"],"refseq":["NM_023010.4"],"refseqProteins":["NP_075386.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,269],[270,283,201]],"edits":[{"start":270,"end":282,"original":"VHRFLLQAVNQKN","replacement":"","added":0}],"missing":13,"replaced":0,"novel":0,"foldedAbsent":8,"foldedMissing":8,"features":[],"interfaces":{},"model":{"entry":"AF-Q9BZI7-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9BZI7-2-F1-model_v6.cif","meanPlddt":66.1,"plddt":[[0,1],[50,1],[0,1],[50,1],[0,1],[50,1],[0,2],[50,4],[0,26],[50,2],[0,1],[50,2],[0,4],[50,2],[70,2],[90,8],[70,2],[90,8],[70,10],[90,4],[70,10],[90,8],[70,4],[90,16],[70,3],[90,11],[70,4],[50,3],[0,1],[50,5],[70,12],[90,3],[70,6],[50,8],[70,32],[50,2],[70,1],[50,1],[70,1],[50,13],[70,1],[50,1],[70,1],[50,4],[70,2],[50,1],[70,6],[50,1],[70,5],[50,8],[0,7],[50,1],[0,18],[50,1],[0,31],[50,1],[0,1],[50,1],[0,5],[50,1],[0,1],[50,6],[70,32],[90,1],[70,2],[90,1],[70,1],[90,1],[70,1],[90,1],[70,17],[50,7],[0,11],[50,17],[70,1],[50,2],[70,3],[50,7],[0,4],[50,2],[0,22],[50,2],[0,1],[50,3]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000125351.15"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000125351","name":"UPF3B","chromosome":"chrX","readthrough":false}],"gencode":10,"mapped":2},"explorer":{"gene":null,"isofor