{"page":"TRIM39","gene":"TRIM39","accession":"Q9HCM9","protein":"E3 ubiquitin-protein ligase TRIM39","length":518,"disease":false,"events":["Alternative splicing"],"canonical":{"accession":"Q9HCM9-1","name":"1","synonyms":["TIM39alpha"],"notes":[{"topic":"Function","text":"E3 ubiquitin-protein ligase (PubMed:22529100). May facilitate apoptosis by inhibiting APC/C-Cdh1-mediated poly-ubiquitination and subsequent proteasome-mediated degradation of the pro-apoptotic protein MOAP1 (PubMed:19100260, PubMed:22529100). Regulates the G1/S transition of the cell cycle and DNA damage-induced G2 arrest by stabilizing CDKN1A/p21 (PubMed:23213251). Positively regulates CDKN1A/p21 stability by competing with DTL for CDKN1A/p21 binding, therefore disrupting DCX(DTL) E3 ubiquitin ligase complex-mediated CDKN1A/p21 ubiquitination and degradation (PubMed:23213251)"}],"transcripts":{"ensembl":["ENST00000376656.8","ENST00000383602.6","ENST00000396547.5","ENST00000413715.5","ENST00000424575.5","ENST00000426469.5","ENST00000445206.5","ENST00000451715.5","ENST00000547030.3","ENST00000548002.1","ENST00000549841.3","ENST00000550282.5","ENST00000552337.2","ENST00000552520.2","ENST00000883589.1","ENST00000929421.1","ENST00000929423.1","ENST00000929424.1","ENST00000944929.1"],"refseq":["NM_021253.4"],"refseqProteins":["NP_067076.2"],"maneSelect":false},"model":{"entry":"AF-Q9HCM9-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9HCM9-F1-model_v6.cif","meanPlddt":84.9,"plddt":[[0,10],[50,4],[70,11],[90,35],[70,3],[90,9],[70,5],[90,15],[70,20],[90,20],[70,2],[90,1],[70,1],[90,52],[70,1],[90,2],[70,2],[90,1],[70,18],[90,1],[70,2],[90,2],[70,1],[90,20],[70,1],[90,3],[70,2],[90,1],[70,9],[50,11],[0,1],[50,2],[0,14],[50,1],[0,2],[50,7],[70,16],[90,4],[70,2],[50,2],[0,6],[50,1],[0,2],[50,10],[70,4],[90,23],[70,7],[90,1],[70,1],[90,19],[70,4],[90,20],[70,1],[90,1],[70,5],[90,29],[70,3],[90,7],[70,6],[90,5],[70,9],[90,3],[70,1],[90,14],[70,2],[50,3],[70,1],[90,1],[70,1],[90,5],[70,2],[50,4],[0,1]]}},"f