 in the presence of thrombin (By similarity). ITGA2B:ITGB3 interacts with SELP (via C-type lectin domain); the interaction mediates cell-cell interaction and adhesion (PubMed:37184585)"}],"isoforms":[{"accession":"P08514-2","name":"2","synonyms":[],"notes":[],"length":1005,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,947],[948,982,58]],"edits":[{"start":948,"end":981,"original":"RPLDQFVLQSHAWFNVSSLPYAVPPLSLPRGEAQ","replacement":"","added":0}],"missing":34,"replaced":0,"novel":0,"foldedAbsent":34,"foldedMissing":34,"features":[[2,34,0],[45,34,0],[46,34,0],[48,1,0]],"interfaces":{},"model":{"entry":"AF-P08514-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P08514-2-F1-model_v6.cif","meanPlddt":87.7,"plddt":[[0,30],[50,1],[70,1],[90,247],[70,1],[90,70],[70,1],[90,14],[70,5],[90,1],[70,2],[90,54],[70,1],[90,65],[70,3],[90,3],[70,1],[90,6],[70,4],[90,17],[70,5],[90,14],[70,3],[90,19],[70,4],[90,13],[70,2],[90,2],[70,5],[90,11],[70,3],[50,4],[70,3],[90,2],[70,3],[90,7],[70,1],[90,1],[70,6],[90,1],[70,2],[90,12],[70,2],[90,3],[70,4],[90,17],[70,1],[90,8],[70,2],[90,9],[70,2],[50,1],[70,4],[90,4],[70,2],[50,3],[70,2],[90,6],[70,3],[90,15],[70,7],[90,13],[70,1],[90,28],[70,6],[50,2],[0,10],[50,2],[70,3],[90,10],[70,4],[90,11],[70,1],[90,1],[70,7],[90,8],[70,2],[90,10],[70,4],[50,2],[0,33],[50,2],[70,4],[90,2],[70,3],[90,10],[70,1],[90,1],[70,3],[90,10],[70,7],[50,11],[0,2],[50,2],[70,10],[90,3],[70,1],[90,2],[70,10],[50,1],[70,2],[50,1],[0,4],[50,7],[0,1],[50,1],[0,1]],"losingConfidence":0}},{"accession":"P08514-3","name":"3","synonyms":["tr-alpha-IIb"],"notes":[],"length":953,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,909]],"edits":[{"start":910,"end":1039,"original":"SCDSAPCTVVQCDLQEMARGQRAMVTVLAFLWLPSLYQRP","replacement":"VSRLSGLWPGLPGTHGAEGMGGGRGVRVCCGPLWATLGPW","added":44}],"missing":130,"replaced":0,"novel