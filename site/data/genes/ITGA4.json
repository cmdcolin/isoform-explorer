on":"SG1"},{"type":"Disulfide bond","start":622,"end":627,"description":""},{"type":"Glycosylation","start":626,"end":626,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Glycosylation","start":645,"end":645,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Glycosylation","start":660,"end":660,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Disulfide bond","start":698,"end":711,"description":""},{"type":"Glycosylation","start":806,"end":806,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Glycosylation","start":821,"end":821,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Disulfide bond","start":852,"end":890,"description":""},{"type":"Disulfide bond","start":897,"end":902,"description":""},{"type":"Transmembrane","start":978,"end":1001,"description":"Helical"},{"type":"Topological domain","start":1002,"end":1032,"description":"Cytoplasmic"},{"type":"Motif","start":1003,"end":1007,"description":"GFFKR motif"},{"type":"Modified residue","start":1021,"end":1021,"description":"Phosphoserine"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Heterodimer of an alpha and a beta subunit. The alpha subunit can sometimes be cleaved into two non-covalently associated fragments. Alpha-4 associates with either beta-1 or beta-7. Alpha-4 interacts with PXN, LPXN, and TGFB1I1/HIC5. Interacts with CSPG4 through CSPG4 chondroitin sulfate glycosaminoglycan. Interacts with JAML; integrin alpha-4/beta-1 may regulate leukocyte to endothelial cells adhesion by controlling JAML homodimerization. ITGA4:ITGB1 is found in a ternary complex with CX3CR1 and CX3CL1 (PubMed:23125415). Interacts with MDK (PubMed:15466886). ITGA4:ITGB1 interacts with MDK; this interaction mediates MDK-induced osteoblast cells migration through PXN phosphorylation (PubMed:15466886). Integrin ITGA4:ITGB1 interacts with SVEP1 (via Sushi domain 21); thereby inhibits Ca(2+) intracellular signaling and as a result represses vasocontraction (PubMed:35802072). ITGA4:ITGB1 interacts with SELP (PubMed:37184585). ITGA4:ITGB1 interacts with BCAM (PubMed:17158232)"}],"isoforms":[{"accession":"P13612-2","name":"2","synonyms":[],"notes":[],"length":195,"transcripts":{"ensembl":["ENST00000339307.8"],"refseq":["NM_001316312.2"],"refseqProteins":["NP_001303241.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,185]],"edits":[{"start":186,"end":1032,"original":"DYVKKFGENFASCQAGISSFYTKDLIVMGAPGSSYWTGSL","replacement":"GSISKYRART","added":10}],"missing":847,"replaced":0,"novel":10,"foldedAbsent":743,"foldedMissing":743,"features":[[2,792,0],[8,1,0],[9,52,0],[10,1,0],[11,54,0],[12,60,0],[13,1,0],[14,1,0],[15,1,0],[16,1,0],[17,58,0],[18,1,0],[19,1,0],[20,1,0],[21,1,0],[22,63,0],[23,1,0],[24,1,0],[25,1,0],[26,1,0],[27,1,0],[28,1,0],[29,2,0],[30,2,0],[31,1,0],[32,1,0],[33,2,0],[34,11,0],[35,2,0],[36,1,0],[37,1,0],[38,1,0],[39,2,0],[40,1,0],[41,1,0],[42,2,0],[43,2,0],[44,24,0],[45,31,0],[46,5,0],[47,1,0]],"interfaces":{},"model":{"entry":"AF-P13612-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P13612-2-F1-model_v6.cif","meanPlddt":89.8,"plddt":[[0,3],[50,11],[70,19],[90,77],[70,2],[90,72],[70,2],[50,3],[0,1],[50,3],[0,2]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000115232.14"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000115232","name":"ITGA4","chromosome":"chr2","readthrough":false}],"gencode":2,"mapped":2},"explorer":{"gene":null,"isoforms":null},"locus":"chr2:181457207-181538940","exons":{"transcript":"ENST00000397033.7","first":1,"junctions":[197,319,426,556,624,754,840,903,1041,1153,1248,1339,1385,1540,1695,1845,1922,2073,2169,2249,2339,2430,2538,2664,2784,2883,3003]},"structures":{"P13612-1":{"transcript":"ENST00000397033.7","strand":1,"coding":[181457655,181535527],"exons":[[181457386,181457851],[181458196,181458317],[181474960,181475066],[181475159,181475288],[181478757,181478824],[181480137,181480266],[181481598,181481683],[181482360,181482422],[181482514,181482651