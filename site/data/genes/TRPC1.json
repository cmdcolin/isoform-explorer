ity). Interacts with ITPR3 (PubMed:10766822). Interacts with MX1 and RNF24 (PubMed:15757897, PubMed:17850865). Interacts with FKBP4 (PubMed:19945390). Interacts with PLSCR1 (By similarity). Interacts with PKD2L2 (PubMed:16883570). Forms a heterotetramer with PKD2 with a 2:2 stoichiometry; has distinct channel properties separate from PKD2 or TRPC1 homomers alone (PubMed:19193631, PubMed:19850920)"}],"isoforms":[{"accession":"P48995-2","name":"Short","synonyms":["TRPC1A"],"notes":[{"topic":"Function","text":"Forms a receptor-activated non-selective calcium permeant cation channel. Also activated by intracellular calcium store depletion"},{"topic":"Subunit","text":"Interacts with isoform 2 of TRPC3"}],"length":759,"transcripts":{"ensembl":["ENST00000273482.10"],"refseq":["NM_003304.5"],"refseqProteins":["NP_003295.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,109],[110,144,650]],"edits":[{"start":110,"end":143,"original":"SADALLVAIDSEVVGAVDILLNHRPKRSSRPTIV","replacement":"","added":0}],"missing":34,"replaced":0,"novel":0,"foldedAbsent":21,"foldedMissing":21,"features":[[0,34,0],[3,33,0]],"interfaces":{},"model":{"entry":"AF-P48995-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P48995-2-F1-model_v6.cif","meanPlddt":78.9,"plddt":[[0,40],[50,4],[70,26],[50,4],[70,3],[50,1],[70,5],[50,1],[70,22],[50,7],[0,11],[50,2],[70,21],[50,3],[70,1],[50,1],[70,30],[90,12],[70,1],[90,1],[70,1],[90,19],[70,1],[90,35],[70,4],[50,6],[0,7],[50,3],[70,2],[90,2],[70,1],[90,22],[70,1],[90,1],[70,10],[90,19],[70,19],[90,18],[70,9],[50,4],[70,10],[90,12],[70,2],[90,1],[70,7],[90,1],[70,8],[90,17],[70,1],[90,2],[70,18],[90,1],[70,2],[90,2],[70,1],[90,15],[70,2],[90,3],[70,2],[90,9],[70,2],[90,1],[70,3],[90,1],[70,3],[90,2],[70,1],[90,11],[70,6],[50,10],[70,1],[50,3],[70,2],[50,6],[70,8],[90,1],[70,9],[50,15],[70,9],[90,1],[70,2],[90,2],[70,1],[90,3],[70,1],[90,18],[70,3],[90,11],[70,1],[90,1],[70,5],[50,3],[70,10],[50,7],[70,3],[50,1],[70,2],[50,1],[70,2],[50,3],[70,3