{"page":"DKC1","gene":"DKC1","accession":"O60832","protein":"H/ACA ribonucleoprotein complex subunit DKC1","length":514,"events":["Alternative splicing"],"canonical":{"accession":"O60832-1","name":"1","synonyms":[],"notes":[{"topic":"Function","text":"Catalytic subunit of H/ACA small nucleolar ribonucleoprotein (H/ACA snoRNP) complex, which catalyzes pseudouridylation of rRNA (PubMed:25219674, PubMed:32554502). This involves the isomerization of uridine such that the ribose is subsequently attached to C5, instead of the normal N1 (PubMed:25219674). Each rRNA can contain up to 100 pseudouridine ('psi') residues, which may serve to stabilize the conformation of rRNAs. Required for ribosome biogenesis and telomere maintenance (PubMed:19179534, PubMed:25219674). Also required for correct processing or intranuclear trafficking of TERC, the RNA component of the telomerase reverse transcriptase (TERT) holoenzyme (PubMed:19179534)"}],"transcripts":{"ensembl":["ENST00000369550.10"],"refseq":["NM_001363.5"],"refseqProteins":["NP_001354.1"],"maneSelect":true},"model":{"entry":"AF-O60832-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-O60832-F1-model_v6.cif","meanPlddt":79.4,"plddt":[[0,3],[50,1],[0,18],[50,4],[70,16],[50,3],[70,4],[90,17],[70,2],[90,6],[70,1],[90,88],[70,3],[90,20],[70,4],[90,68],[70,1],[90,99],[70,2],[90,18],[70,39],[50,5],[0,36],[50,1],[0,55]]}},"features":[{"type":"Modified residue","start":2,"end":2,"description":"N-acetylalanine"},{"type":"Region","start":2,"end":21,"description":"Nucleolar localization"},{"type":"Cross-link","start":20,"end":20,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO2)"},{"type":"Modified residue","start":21,"end":21,"description":"Phosphoserine"},{"type":"Cross-link","start":39,"end":39,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO2)"},{"type":"Cross-link","start":43,"end":43,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO2)"}