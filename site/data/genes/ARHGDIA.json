ude when RHOA is prenylated (PubMed:20400958, PubMed:20628200, PubMed:23434736, PubMed:26646181). Interacts with PSMD10; the interaction increases ARHGDIA association with RHOA, leading to ARHGDIA-mediated inactivation of RHOA and ROCK and prolonged AKT activation (PubMed:20628200). Interacts with KANK2; the interaction is direct and may regulate the interaction of ARHGDIA with RHOA, RAC1 and CDC42 (PubMed:25961457). Interacts with RHOC (PubMed:20400958). Interacts with CDC42 (PubMed:23434736). Interacts with NGFR (via death domain); NGFR binding decreases the affinity for RHOA (PubMed:26646181)"}],"isoforms":[{"accession":"P52565-2","name":"2","synonyms":[],"notes":[],"length":160,"transcripts":{"ensembl":["ENST00000400721.8"],"refseq":["NM_001185078.3"],"refseqProteins":["NP_001172007.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,138],[140,184,21]],"edits":[{"start":139,"end":183,"original":"IDKTDYMVGSYGPRAEEYEFLTPVEEAPKGMLARGSYSIK","replacement":"N","added":1}],"missing":45,"replaced":0,"novel":1,"foldedAbsent":45,"foldedMissing":45,"features":[[8,1,0],[9,1,0],[10,1,0],[11,1,0],[12,1,0]],"interfaces":{"CDC42":[19,0,50],"RAC1":[19,0,54],"RAC2":[19,0,50],"RAC3":[15,0,46],"RHOA":[19,0,49],"RHOC":[17,0,52],"RHOF":[10,0,40],"RHOG":[17,0,48],"RHOQ":[15,0,45]},"model":{"entry":"AF-P52565-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P52565-2-F1-model_v6.cif","meanPlddt":81.8,"plddt":[[0,2],[50,4],[70,11],[50,7],[70,6],[90,1],[70,1],[90,2],[70,2],[90,2],[70,1],[90,17],[70,2],[50,5],[70,4],[90,14],[70,5],[90,4],[70,13],[90,3],[70,1],[90,11],[70,3],[90,3],[70,1],[90,3],[70,7],[50,6],[0,2],[50,1],[70,15],[50,1]],"losingConfidence":2}}],"ensemblGenes":["ENSG00000141522.14"],"unmapped":{"ensembl":[],"refseq":["NM_001301240.2","NM_001301241.2","NM_001301242.2","NM_001301243.2"],"refseqProteins":["NP_001288169.1","NP_001288170.1","NP_001288171.1","NP_001288172.1"]},"coding":{"genes":[{"id":"ENSG00000141522","name":"ARHGDIA","chromosome":"chr17","read