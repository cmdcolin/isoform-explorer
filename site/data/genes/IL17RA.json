ption":"N-linked (GlcNAc...) asparagine"},{"type":"Glycosylation","start":242,"end":242,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Disulfide bond","start":245,"end":276,"description":""},{"type":"Glycosylation","start":265,"end":265,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Disulfide bond","start":277,"end":303,"description":""},{"type":"Disulfide bond","start":290,"end":294,"description":""},{"type":"Transmembrane","start":321,"end":341,"description":"Helical"},{"type":"Topological domain","start":342,"end":866,"description":"Cytoplasmic"},{"type":"Domain","start":377,"end":534,"description":"SEFIR"},{"type":"Modified residue","start":708,"end":708,"description":"Phosphoserine"},{"type":"Modified residue","start":736,"end":736,"description":"Phosphoserine"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Forms heterodimers with IL17RC; the heterodimer binds IL17A and IL17F homodimers as well as the heterodimer formed by IL17A and IL17F (PubMed:16785495, PubMed:18684971, PubMed:32187518). Forms complexes with 2:1 binding stoichiometry: two receptor chains for one interleukin molecule (PubMed:32187518). IL17A homodimer preferentially drives the formation of IL17RA-IL17RC heterodimeric receptor complex, whereas IL17F homodimer forms predominantly complexes with IL17RC homodimer (PubMed:32187518). IL17A homodimer adopts an asymmetrical ternary structure with one IL17RA molecule, allowing for high affinity interactions of one IL17A monomer with one IL17RA molecule (via D1 and D2 domains), while disfavoring binding of a second IL17RA molecule on the other IL17A monomer (PubMed:23695682). IL17A-IL17F forms complexes with IL17RA-IL17RC, but with lower affinity when compared to IL17A homodimer (PubMed:32187518). IL17RA chain cannot distinguish between IL17A and IL17F molecules, potentially enabling the formation of topologically distinct complexes (PubMed:28827714). Interacts with TRAF3IP2 (PubMed:24120361). Forms heterodimers with IL17RE; the heterodimer binds IL17C (PubMed:16785495, PubMed:18684971, PubMed:21993848)"},{"topic":"Subunit","text":"(Microbial infection) Interacts with SARS coronavirus-2/SARS-CoV-2 virus protein ORF8"}],"isoforms":[{"accession":"Q96F46-2","name":"2","synonyms":[],"notes":[{"topic":"Miscellaneous","text":"Soluble isoform lacking the transmembrane segment"}],"length":832,"transcripts":{"ensembl":["ENST00000612619.2"],"refseq":["NM_001289905.2"],"refseqProteins":["NP_001276834.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,314],[315,349,518]],"edits":[{"start":315,"end":348,"original":"DYMPLWVYWFITGISILLVGSVILLIVCMTWRLA","replacement":"","added":0}],"missing":34,"replaced":0,"novel":0,"foldedAbsent":27,"foldedMissing":27,"features":[[1,6,0],[15,21,0],[16,7,0]],"interfaces":{},"model":{"entry":"AF-Q96F46-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q96F46-2-F1-model_v6.cif","meanPlddt":68.4,"plddt":[[0,30],[50,2],[70,1],[90,1],[70,3],[50,3],[70,2],[90,3],[70,2],[90,5],[70,6],[90,1],[70,4],[90,21],[70,5],[90,11],[70,4],[90,1],[70,2],[90,11],[70,6],[90,9],[70,4],[50,1],[70,3],[90,27],[70,3],[90,14],[70,1],[90,8],[70,1],[90,1],[70,6],[90,10],[70,3],[90,10],[70,1],[90,12],[70,5],[90,27],[70,5],[90,12],[70,8],[90,7],[70,2],[50,2],[0,6],[50,1],[0,28],[50,2],[70,1],[90,25],[70,5],[90,5],[70,6],[90,1],[70,4],[90,13],[70,3],[90,18],[70,8],[90,2],[70,3],[50,3],[70,2],[90,13],[70,8],[90,18],[70,6],[90,8],[70,2],[90,1],[70,7],[50,3],[0,3],[50,6],[70,2],[50,1],[70,9],[90,25],[70,2],[50,1],[0,149],[50,7],[0,1],[50,3],[0,1],[50,2],[0,72],[50,2],[70,1],[50,1],[70,1],[50,2],[70,2],[50,1],[70,3],[50,2],[70,1],[50,5],[0,1],[50,2],[0,16]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000177663.16"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":1,"gencode":4,"mapped":2},"explorer":{"gene":null,"isoforms":"IL17RA"},"locus":"chr22:17085000-17115693","exons":{"transcript":"ENST00000319363.11","first":1,"junctions":[138,163,310,423,550,5