with TRIM28 and KDM3A. Interacts (via the RD1 domain) with BAZ1A (via its N-terminal); the interaction corepresses a number of NCOR1-regulated genes. Interacts with BCL6, C1D, DACH1, HEXIM1, HDAC7, RORA, RORC, SAP30, SIAH2, SIN3A and SIN3B. May interact with DEAF1. Interacts with RXRA. Interacts with SETD5 (By similarity). Interacts with VDR (PubMed:28698609). Interacts with ZBTB7A (PubMed:20812024). Interacts with AR (PubMed:20812024). Interacts with HDAC3 (By similarity)"}],"isoforms":[{"accession":"O75376-2","name":"2","synonyms":[],"notes":[],"length":2337,"transcripts":{"ensembl":["ENST00000395851.5"],"refseq":["NM_001190440.2"],"refseqProteins":["NP_001177369.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,727],[744,728,1114],[1859,1962,479]],"edits":[{"start":727,"end":727,"original":"E","replacement":"EGAENSSDTESAPSPSP","added":17},{"start":1842,"end":1961,"original":"SKHEAARLEENLRSRSAAVSEQQQLEQKTLEVEKRSVQCL","replacement":"I","added":1}],"missing":120,"replaced":0,"novel":17,"foldedAbsent":0,"foldedMissing":0,"features":[[28,120,0],[31,5,0]],"interfaces":{},"model":{"entry":"AF-O75376-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-O75376-2-F1-model_v6.cif","meanPlddt":40.8,"plddt":[[0,131],[50,1],[0,1],[50,1],[0,41],[50,2],[70,2],[90,25],[70,8],[50,5],[0,15],[50,1],[70,17],[50,1],[70,2],[50,12],[70,9],[90,25],[70,1],[90,2],[70,2],[90,2],[70,2],[90,16],[70,2],[90,9],[70,1],[90,2],[70,2],[90,1],[70,3],[90,1],[70,13],[50,6],[0,7],[50,4],[70,29],[50,2],[70,4],[50,1],[70,9],[50,1],[70,18],[90,27],[70,2],[90,14],[70,1],[90,6],[70,1],[90,2],[70,2],[50,3],[0,17],[50,1],[0,2],[50,8],[70,1],[50,15],[0,27],[50,1],[0,38],[50,1],[0,13],[50,3],[70,3],[90,2],[70,1],[90,40],[70,4],[90,4],[70,3],[90,1],[70,4],[50,2],[0,82],[50,1],[0,57],[50,1],[0,1],[50,1],[0,84],[50,1],[0,53],[50,4],[70,16],[50,6],[0,1],[50,1],[0,623],[50,1],[0,1],[50,2],[70,1],[50,2],[70,8],[50,3],[0,59],[50,1],[0,7],[50,1],[0,17],[50,4],[70,15],[50,5],[0,15],[50,1],[0,38],[50,1],