980, PubMed:29775578, PubMed:29779948, PubMed:31182716, PubMed:31387940, PubMed:32513959, PubMed:33268465, PubMed:34700328, PubMed:34857742, PubMed:35486881, PubMed:37816714, PubMed:38418882, PubMed:38326650, PubMed:35512830, PubMed:37844242, PubMed:40440427, PubMed:40963025). Interacts with TMF1 (PubMed:15467733). As part of the Elongin BC E3 ubiquitin ligase complex; interacts with NRBP1 (PubMed:22510880). May form oligomers as a KLHDC2/KLHDC3-ELOB-ELOC complex; this interaction is autoinhibitory for the E3 ligase complex as the substrate-binding site of KLHDC2/KLHDC3 is blocked in the oligomer (By similarity)"},{"topic":"Subunit","text":"(Microbial infection) Interacts with HIV-1 Vif; forming an active cullin-5-RING E3 ubiquitin-protein ligase complex (ECS complex)"},{"topic":"Subunit","text":"(Microbial infection) Substrate adapter protein can be a viral protein such as HIV Vif"},{"topic":"Subunit","text":"(Microbial infection) Interacts with human respiratory syncytial virus (HRSV) protein NS1"},{"topic":"Subunit","text":"(Microbial infection) Interacts with molluscum contagiosum virus MC132"},{"topic":"Subunit","text":"(Microbial infection) Interacts with herpes virus 8 virus protein LANA1"}],"isoforms":[{"accession":"Q15369-2","name":"2","synonyms":[],"notes":[],"length":96,"transcripts":{"ensembl":["ENST00000520210.1","ENST00000688584.1"],"refseq":["NM_001204863.2","NM_001204864.2"],"refseqProteins":["NP_001191792.1","NP_001191793.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,17,96]],"edits":[{"start":1,"end":16,"original":"MDGEEKTYGGCEGPDA","replacement":"","added":0}],"missing":16,"replaced":0,"novel":0,"foldedAbsent":8,"foldedMissing":8,"features":[],"interfaces":{},"model":{"entry":"AF-Q15369-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q15369-2-F1-model_v6.cif","meanPlddt":92.2,"plddt":[[90,28],[70,4],[50,8],[70,2],[90,54]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000154582.19"],"unmapped":{"ensembl":[],"refseq":[],"refs