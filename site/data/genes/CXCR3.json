{"page":"CXCR3","gene":"CXCR3","accession":"P49682","protein":"C-X-C chemokine receptor type 3","length":368,"disease":false,"events":["Alternative splicing"],"canonical":{"accession":"P49682-1","name":"1","synonyms":["CXCR3-A"],"notes":[{"topic":"Function","text":"Receptor for the C-X-C chemokines CXCL9, CXCL10 and CXCL11, and mediates the proliferation, survival and angiogenic activity of human mesangial cells (HMC) through a heterotrimeric G-protein signaling pathway (PubMed:12782716). Probably promotes cell chemotaxis response. Upon activation by PF4, induces activated T-lymphocyte migration mediated via downstream Ras/extracellular signal-regulated kinase (ERK) signaling"},{"topic":"Subunit","text":"Interacts with PF4/CXCL4"}],"transcripts":{"ensembl":["ENST00000373693.4"],"refseq":["NM_001504.2"],"maneSelect":true},"model":{"entry":"AF-P49682-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P49682-F1-model_v6.cif","meanPlddt":80.5,"plddt":[[0,10],[50,3],[70,1],[50,2],[70,1],[50,7],[0,3],[50,2],[0,7],[50,5],[70,8],[90,27],[70,1],[90,2],[70,10],[90,58],[70,9],[50,8],[70,3],[90,27],[70,5],[90,5],[70,9],[90,24],[70,8],[50,2],[70,5],[50,1],[70,8],[90,1],[70,2],[90,17],[70,3],[90,2],[70,5],[90,1],[70,1],[90,16],[70,28],[50,5],[0,26]]}},"features":[{"type":"Topological domain","start":1,"end":53,"description":"Extracellular"},{"type":"Glycosylation","start":22,"end":22,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Modified residue","start":27,"end":27,"description":"Sulfotyrosine"},{"type":"Modified residue","start":29,"end":29,"description":"Sulfotyrosine"},{"type":"Glycosylation","start":32,"end":32,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Transmembrane","start":54,"end":80,"description":"Helical; Name=1"},{"type":"Topological domain","start":81,"end":89,"description":"Cytoplasmic"},{"type":"Transmembrane","start":90,"end":110,"description":"Helical; Name=2"},{"type":"Topological domain","start":111,"end":125,"description":"Extracellular