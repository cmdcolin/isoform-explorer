iption":"Phosphoserine"},{"type":"Modified residue","start":113,"end":113,"description":"Phosphoserine"},{"type":"Modified residue","start":116,"end":116,"description":"Phosphoserine"},{"type":"Modified residue","start":136,"end":136,"description":"Phosphoserine"},{"type":"Transmembrane","start":213,"end":233,"description":"Helical"},{"type":"Topological domain","start":234,"end":717,"description":"Perinuclear space"},{"type":"Coiled coil","start":273,"end":296,"description":""},{"type":"Coiled coil","start":348,"end":440,"description":""},{"type":"Coiled coil","start":475,"end":506,"description":""},{"type":"Region","start":507,"end":717,"description":"Sufficient for interaction with SYNE1 and SYNE2"},{"type":"Domain","start":555,"end":716,"description":"SUN"},{"type":"Disulfide bond","start":563,"end":563,"description":"Interchain (with C-6862 in SYNE2)"},{"type":"Disulfide bond","start":601,"end":705,"description":""},{"type":"Glycosylation","start":636,"end":636,"description":"N-linked (GlcNAc...) asparagine"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Core component of the LINC complex which is composed of inner nuclear membrane SUN domain-containing proteins coupled to outer nuclear membrane KASH domain-containing nesprins. SUN and KASH domain-containing proteins seem to bind each other promiscuously; however, differentially expression of LINC complex constituents is giving rise to specific assemblies. At least SUN1/2-containing core LINC complexes are proposed to be hexameric composed of three protomers of each KASH and SUN domain-containing protein. Interacts with SYNE2; the SUN2:SYNE2/KASH2 LINC complex is a heterohexamer; the homotrimeric cloverleave-like conformation of the SUN domain is a prerequisite for LINC complex formation in which three separate SYNE2/KASH2 peptides bind at the interface of adjacent SUN domains. Component of a probable SUN2:KASH5 LINC complex. Interacts with SYNE1 and SYNE3; probably forming respective LINC complexes. Interacts with A-type lamin. Interaction with lamins B1 and C is hardly detectable (By similarity). Interacts with EMD and RAB5A. Interacts with TMEM43 (PubMed:21391237). Interacts with TMEM201 (PubMed:35311970)"}],"isoforms":[{"accession":"Q9UH99-2","name":"2","synonyms":[],"notes":[],"length":738,"transcripts":{"ensembl":["ENST00000405018.5","ENST00000956739.1"],"refseq":["NM_001199579.2","NM_001394428.1"],"refseqProteins":["NP_001186508.1","NP_001381357.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,141],[163,142,576]],"edits":[{"start":141,"end":141,"original":"V","replacement":"VEDSEGRGSKVTETEPVSSFPA","added":22}],"missing":0,"replaced":0,"novel":21,"foldedAbsent":0,"foldedMissing":0,"features":[],"interfaces":{},"model":{"entry":"AF-Q9UH99-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9UH99-2-F1-model_v6.cif","meanPlddt":67.1,"plddt":[[0,180],[50,1],[0,1],[50,8],[70,2],[50,2],[70,10],[90,1],[70,14],[50,4],[0,1],[50,7],[70,22],[50,5],[0,1],[50,2],[0,27],[50,5],[70,36],[50,5],[0,9],[50,1],[70,11],[90,2],[70,2],[90,2],[70,1],[90,51],[70,16],[90,1],[70,1],[90,22],[70,1],[90,4],[70,3],[90,1],[70,6],[90,2],[70,15],[50,3],[0,9],[50,2],[70,12],[90,1],[70,2],[90,1],[70,8],[50,8],[0,1],[50,3],[0,6],[50,3],[70,8],[90,2],[70,1],[90,3],[70,1],[90,1],[70,6],[90,13],[70,10],[50,6],[70,5],[50,1],[70,1],[50,3],[70,3],[90,8],[70,1],[90,1],[70,2],[90,34],[70,4],[90,14],[70,1],[50,1],[70,1],[50,3],[70,2],[90,20],[70,2],[50,2],[70,2],[90,30],[70,1],[50,1]],"losingConfidence":0}},{"accession":"Q9UH99-3","name":"3","synonyms":[],"notes":[],"length":713,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,682]],"edits":[{"start":683,"end":717,"original":"TMATYQVVELRILTNWGHPEYTCIYRFRVHGEPAH","replacement":"SSFPLCPWRLLPILGVCIYVAYHGGLGSWER","added":31}],"missing":0,"replaced":35,"novel":31,"foldedAbsent":32,"foldedMissing":0,"features":[[11,0,35],[15,0,35],[16,0,34],[18,0,1]],"interfaces"