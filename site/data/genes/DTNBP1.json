y not be a physiological binding partner (PubMed:16980328). Interacts (isoform 1 and isoform 2 only) with the DNA-dependent protein kinase complex DNA-PK; the interaction phosphorylates DTNBP1 in vitro. Interacts directly in this complex with XRCC5 and XRCC6. Interacts with AP3M1, AP3B2 and TRIM32. Interacts with XPO1; the interaction exports DTNBP1 out of the nucleus"}],"isoforms":[{"accession":"Q96EV8-2","name":"2","synonyms":[],"notes":[{"topic":"Miscellaneous","text":"May be due to intron retention"}],"length":303,"transcripts":{"ensembl":["ENST00000338950.9"],"refseq":["NM_183040.2"],"refseqProteins":["NP_898861.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,271]],"edits":[{"start":272,"end":351,"original":"PESSTCQNEITLQVPNPSELRAKPPSSSSTCTDSATRDIS","replacement":"RVDKLALAEPGQYRCHSPPKVRRENHLPVTYA","added":32}],"missing":80,"replaced":0,"novel":32,"foldedAbsent":1,"foldedMissing":1,"features":[[2,60,0],[4,1,0],[5,1,0],[6,1,0]],"interfaces":{},"model":{"entry":"AF-Q96EV8-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q96EV8-2-F1-model_v6.cif","meanPlddt":78,"plddt":[[50,1],[70,20],[50,11],[0,9],[50,4],[70,4],[90,149],[70,1],[90,2],[70,1],[90,2],[70,3],[90,1],[70,7],[50,5],[0,11],[50,22],[70,3],[50,3],[0,24],[50,5],[0,5],[50,1],[0,3],[50,6]],"losingConfidence":0}},{"accession":"Q96EV8-3","name":"3","synonyms":["Dysbindin 1-B"],"notes":[],"length":270,"transcripts":{"ensembl":[],"refseq":["NM_001271667.2"],"refseqProteins":["NP_001258596.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,82,270]],"edits":[{"start":1,"end":81,"original":"MLETLRERLLSVQQDFTSGLKTLSDKSREAKVKSKPRTVP","replacement":"","added":0}],"missing":81,"replaced":0,"novel":0,"foldedAbsent":56,"foldedMissing":56,"features":[[0,1,0]],"interfaces":{},"model":{"entry":"AF-Q96EV8-3-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q96EV8-3-F1-model_v6.cif","meanPlddt":75.1,"plddt":[[50,1],[70,3],[90,1],[70,1],[90,107],[70,1],[90,19],[70,4],[50,6],[0,2],[50,1],[0,1