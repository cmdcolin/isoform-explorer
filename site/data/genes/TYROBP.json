tal ion by the subunits of the oligomer (PubMed:25981043). Interacts with TREM1 (PubMed:10799849). Interacts with TREM2 (PubMed:11602640, PubMed:25957402). Interacts with SIRPB1 (PubMed:10604985). Interacts with CLECSF5 (PubMed:10449773). Interacts with SIGLEC14 (PubMed:17012248). Interacts with CD300LB and CD300E (PubMed:15557162, PubMed:16920917, PubMed:17928527). Interacts with CD300C2 (By similarity). Interacts (via ITAM domain) with SYK (via SH2 domains); activates SYK mediating neutrophil and macrophage integrin-mediated activation (By similarity). Interacts with KLRC2, KIR2DS3 and KIR2DS5 (PubMed:18624290, PubMed:20890284). Interacts with CD300H (PubMed:26221034). Interacts with KIR2DS1 (PubMed:23715743). Interacts with KLRD1 (PubMed:15940674, PubMed:9655483). Interacts with SIGLEC1 (PubMed:26358190)"}],"isoforms":[{"accession":"O43914-2","name":"2","synonyms":["KARAP-b"],"notes":[],"length":112,"transcripts":{"ensembl":["ENST00000589517.1"],"refseq":["NM_198125.3"],"refseqProteins":["NP_937758.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,76],[77,78,36]],"edits":[{"start":77,"end":77,"original":"A","replacement":"","added":0}],"missing":1,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMissing":0,"features":[[6,1,0]],"interfaces":{},"model":{"entry":"AF-O43914-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-O43914-2-F1-model_v6.cif","meanPlddt":64.5,"plddt":[[0,4],[50,19],[0,1],[50,1],[0,3],[50,1],[0,2],[50,5],[70,5],[90,1],[70,1],[90,18],[70,6],[50,6],[0,1],[50,1],[0,3],[50,1],[0,2],[50,28],[0,1],[50,2]],"losingConfidence":0}},{"accession":"O43914-3","name":"3","synonyms":[],"notes":[],"length":102,"transcripts":{"ensembl":["ENST00000544690.6"],"refseq":["NM_001173514.2"],"refseqProteins":["NP_001166985.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,19],[20,31,83]],"edits":[{"start":20,"end":30,"original":"SGLRPVQAQAQ","replacement":"","added":0}],"missing":11,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMis