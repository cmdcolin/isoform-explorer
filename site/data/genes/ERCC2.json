1, GTF2E2, GTF2F1, GTF2F2, TCEA1, ERCC2, ERCC3, GTF2H2, GTF2H3, GTF2H4, GTF2H5, GTF2A1, GTF2A2, GTF2B and TBP; this large multi-subunit PIC complex mediates DNA unwinding and targets Pol II core to the transcription start site where the first phosphodiester bond forms"},{"topic":"Subunit","text":"(Microbial infection) Interacts with Epstein-Barr virus EBNA2"}],"isoforms":[{"accession":"P18074-2","name":"2","synonyms":[],"notes":[],"length":405,"transcripts":{"ensembl":["ENST00000485403.6"],"refseq":["NM_001130867.2"],"refseqProteins":["NP_001124339.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,25,389]],"edits":[{"start":1,"end":24,"original":"MKLNVDGLLVYFPYDYIYPEQFSY","replacement":"","added":0},{"start":414,"end":760,"original":"FTIIIEPFDDRTPTIANPILHFSCMDASLAIKPVFERFQS","replacement":"QAQHCGSSRNQKRSHP","added":16}],"missing":371,"replaced":0,"novel":16,"foldedAbsent":367,"foldedMissing":367,"features":[[0,18,0],[7,200,0],[8,14,0]],"interfaces":{"GTF2H1":[53,0,99],"GTF2H2":[36,0,36],"GTF2H2C":[32,0,32],"H4C15":[28,0,28]},"model":{"entry":"AF-P18074-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P18074-2-F1-model_v6.cif","meanPlddt":84.2,"plddt":[[70,1],[90,18],[70,4],[90,16],[70,1],[90,3],[70,1],[90,6],[70,1],[90,22],[70,6],[90,7],[70,1],[90,13],[70,5],[90,1],[70,2],[90,2],[70,20],[90,7],[70,10],[90,21],[70,1],[90,2],[70,2],[90,1],[70,3],[90,7],[70,10],[50,2],[70,1],[50,5],[70,2],[90,6],[70,5],[90,2],[70,8],[90,23],[70,18],[50,4],[0,4],[50,20],[70,8],[90,19],[70,9],[90,13],[70,28],[90,6],[70,1],[90,2],[70,6],[50,4],[0,1],[50,1],[0,13]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000104884.18"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":1,"gencode":11,"mapped":2},"explorer":{"gene":"ERCC2","isoforms":"ERCC2"},"locus":"chr19:45349837-45370588","exons":{"transcript":"ENST00000391945.10","first":1,"junctions":[5,105,183,246,360,477,594,718,815,949,1118,1237,1307,1377,1479,1543,1665,1758,1831,1902,2046,2190]},"