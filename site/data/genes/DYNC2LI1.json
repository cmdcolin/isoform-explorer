tabilizes the dynein-2 complex structure (PubMed:29742051)"}],"isoforms":[{"accession":"Q8TCX1-2","name":"2","synonyms":[],"notes":[],"length":352,"transcripts":{"ensembl":["ENST00000605786.5"],"refseq":["NM_001193464.2"],"refseqProteins":["NP_001180393.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,169],[171,170,182]],"edits":[{"start":169,"end":169,"original":"P","replacement":"PQ","added":2}],"missing":0,"replaced":0,"novel":1,"foldedAbsent":0,"foldedMissing":0,"features":[],"interfaces":{},"model":{"entry":"AF-Q8TCX1-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q8TCX1-2-F1-model_v6.cif","meanPlddt":85,"plddt":[[0,1],[50,2],[70,2],[90,6],[70,6],[50,2],[0,8],[50,2],[70,1],[90,22],[70,1],[90,1],[70,8],[90,7],[70,6],[50,2],[70,3],[90,7],[70,8],[90,7],[70,2],[90,2],[70,1],[90,37],[70,2],[90,1],[70,3],[90,1],[70,13],[50,2],[70,8],[90,65],[70,8],[90,4],[70,1],[90,8],[70,1],[90,8],[70,4],[50,9],[70,4],[90,13],[70,2],[50,2],[0,5],[50,3],[70,1],[50,1],[70,15],[90,9],[70,4],[50,5],[0,6]],"losingConfidence":0}},{"accession":"Q8TCX1-3","name":"3","synonyms":[],"notes":[],"length":334,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,331],[334,351,1]],"edits":[{"start":332,"end":351,"original":"ELEQYKRSSSKSWKQIELDS","replacement":"VLS","added":3}],"missing":19,"replaced":0,"novel":2,"foldedAbsent":12,"foldedMissing":12,"features":[],"interfaces":{},"model":{"entry":"AF-Q8TCX1-3-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q8TCX1-3-F1-model_v6.cif","meanPlddt":87,"plddt":[[0,1],[50,2],[70,2],[90,6],[70,6],[50,2],[0,8],[50,2],[70,1],[90,24],[70,9],[90,7],[70,5],[50,2],[70,3],[90,7],[70,8],[90,8],[70,1],[90,2],[70,1],[90,40],[70,2],[90,2],[70,1],[90,4],[70,10],[90,72],[70,8],[90,4],[70,1],[90,18],[70,3],[50,9],[70,3],[90,14],[70,2],[50,2],[0,1],[50,1],[0,1],[50,4],[70,24],[50,1]],"losingConfidence":0}},{"accession":"Q8TCX1-4","name":"4","synonyms":[],"notes":[],"length":201