description":"GDP"},{"type":"Binding site","start":97,"end":97,"description":"GTP"},{"type":"Binding site","start":120,"end":120,"description":"GTP"},{"type":"Binding site","start":179,"end":179,"description":"GDP"},{"type":"Binding site","start":179,"end":179,"description":"GTP"},{"type":"Binding site","start":180,"end":180,"description":"GDP"},{"type":"Binding site","start":180,"end":180,"description":"GTP"},{"type":"Binding site","start":182,"end":182,"description":"GDP"},{"type":"Binding site","start":182,"end":182,"description":"GTP"},{"type":"Binding site","start":220,"end":220,"description":"GDP"},{"type":"Binding site","start":221,"end":221,"description":"GDP"},{"type":"Binding site","start":221,"end":221,"description":"GTP"}],"interfaces":{"LAMTOR3":[281,282,284,285,288,289,292,293,295,296,297,298,299,300,301,314,315,316,317,318,319,320,321,322,323],"RRAGA":[89,90,92,93,182,184,222,223,279,281,282,284,285,288,289,292,293,295,296,297,299,300,301,302,303,304,305,306,307,309,310,312,314,315,316,317,318,319,320,321,322,323,327,341],"RRAGB":[89,90,92,93,182,184,222,223,279,281,282,284,285,288,289,292,293,295,296,297,299,300,301,302,303,304,305,306,307,309,310,312,314,315,316,317,318,319,320,321,322,323,327,341]},"subunit":[{"topic":"Subunit","text":"Forms a heterodimer with RRAGA in a sequence-independent manner and RRAGB (PubMed:11073942, PubMed:14660641). Heterodimerization stabilizes RRAG proteins (PubMed:11073942, PubMed:14660641, PubMed:25561175, PubMed:25567906). The GDP-bound form of RRAGD (in complex with the GTP-bound form of RRAGA or RRAGB), interacts with RPTOR, thereby promoting recruitment of mTORC1 to the lysosomes (PubMed:18497260). Component of the lysosomal folliculin complex (LFC), composed of FLCN, FNIP1 (or FNIP2), RagA/RRAGA or RagB/RRAGB GDP-bound, RagC/RRAGC or RagD/RRAGD GTP-bound, and Ragulator (By similarity). Interacts with NOL8 (PubMed:14660641). Interacts with SH3BP4; the interaction with this negative regulator is most probably direct, preferentially occurs with the inactive GDP-bound form of RRAGD and is negatively regulated by amino acids (PubMed:22575674). The Rag heterodimer interacts with SLC38A9; the probable amino acid sensor (PubMed:25561175, PubMed:25567906). Interacts with SESN1, SESN2 and SESN3 (PubMed:25259925). The GDP-bound form interacts with TFEB (By similarity). The GDP-bound form interacts with TFE3 (PubMed:32612235)"}],"isoforms":[{"accession":"Q9NQL2-2","name":"2","synonyms":[],"notes":[],"length":249,"transcripts":{"ensembl":["ENST00000359203.3"],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,152,249]],"edits":[{"start":1,"end":151,"original":"MSQVLGKPQPQDEDDAEEEEEEDELVGLADYGDGPDSSDA","replacement":"","added":0}],"missing":151,"replaced":0,"novel":0,"foldedAbsent":70,"foldedMissing":70,"features":[[0,1,0],[1,1,0],[2,1,0],[3,1,0],[4,1,0],[5,1,0],[6,1,0],[7,1,0],[8,1,0],[9,1,0],[10,1,0],[11,1,0],[12,1,0],[13,1,0],[14,1,0],[15,1,0],[16,1,0],[17,1,0],[18,1,0]],"interfaces":{"RRAGA":[4,0,44],"RRAGB":[4,0,44]},"model":{"entry":"AF-Q9NQL2-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9NQL2-2-F1-model_v6.cif","meanPlddt":88.7,"plddt":[[50,1],[90,30],[70,1],[90,23],[70,6],[90,10],[70,2],[90,13],[70,3],[90,39],[70,1],[90,20],[70,10],[90,57],[70,13],[50,10],[0,10]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000025039.16"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":1,"gencode":6,"mapped":4},"explorer":{"gene":"RRAGD","isoforms":"RRAGD"},"locus":"chr6:89361102-89412735","exons":{"transcript":"ENST00000369415.9","first":1,"junctions":[148,444,644,759,902,1051]},"structures":{"Q9NQL2-1":{"transcript":"ENST00000369415.9","strand":-1,"coding":[89368056,89411993],"exons":[[89364616,89368207],[89372437,89372585],[89377671,89377813],[89379224,89379338],[89380168,89380367],[89387295,89387590],[89411846,89412273]]},"Q9NQL2-2":{"transcript":"ENST00000359203.3","strand":-1,"coding":[89368056,89380358],"exon