PubMed:12628186). Interacts with TREX1; this interaction is initiated only following translocation to the nucleus (PubMed:16818237). NDP kinase isoenzymes result from random association of two different kinds of polypeptides (PubMed:1851158). Interacts (oxidized form) with TXNRD1; this interaction is probably indirect and TXN is necessary for reduction of oxidized form through the NADPH-TXNRD1-TXN system (PubMed:19956735). Interacts with FBXO24 (PubMed:25582197)"}],"isoforms":[{"accession":"P15531-2","name":"2","synonyms":["NM23-H1B"],"notes":[],"length":177,"transcripts":{"ensembl":["ENST00000013034.3","ENST00000336097.7"],"refseq":["NM_198175.1"],"refseqProteins":["NP_937818.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,1],[27,2,151]],"edits":[{"start":1,"end":1,"original":"M","replacement":"MVLLSTLGIVFQGEGPPISSCDTGTM","added":26}],"missing":0,"replaced":0,"novel":25,"foldedAbsent":0,"foldedMissing":0,"features":[],"interfaces":{},"model":{"entry":"AF-P15531-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P15531-2-F1-model_v6.cif","meanPlddt":91.1,"plddt":[[50,1],[0,4],[50,2],[0,1],[50,1],[0,5],[50,1],[0,1],[50,1],[0,1],[50,7],[70,2],[90,149],[70,1]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000239672.9"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000239672","name":"NME1","chromosome":"chr17","readthrough":false}],"gencode":18,"mapped":9},"explorer":{"gene":null,"isoforms":null},"locus":"chr17:51152949-51162737","exons":{"transcript":"ENST00000393196.8","first":2,"junctions":[126,228,341]},"structures":{"P15531-1":{"transcript":"ENST00000393196.8","strand":1,"coding":[51155655,51161845],"exons":[[51153559,51153662],[51155651,51155780],[51159980,51160081],[51161160,51161272],[51161728,51162168]]},"P15531-2":{"transcript":"ENST00000336097.7","strand":1,"coding":[51154374,51161845],"exons":[[51153576,51153662],[51154225,51154444],[51155651,51155780],[51159980,51160081],[51161160,51161272],[