ulfide bond","start":146,"end":158,"description":""},{"type":"Disulfide bond","start":149,"end":166,"description":""},{"type":"Glycosylation","start":151,"end":151,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Repeat","start":167,"end":196,"description":"TNFR-Cys 4"},{"type":"Disulfide bond","start":168,"end":179,"description":""},{"type":"Disulfide bond","start":182,"end":195,"description":""},{"type":"Disulfide bond","start":185,"end":191,"description":""},{"type":"Transmembrane","start":212,"end":232,"description":"Helical"},{"type":"Topological domain","start":233,"end":455,"description":"Cytoplasmic"},{"type":"Region","start":338,"end":348,"description":"N-SMase activation domain (NSD)"},{"type":"Domain","start":356,"end":441,"description":"Death"},{"type":"Glycosylation","start":376,"end":376,"description":"(Microbial infection) N-beta-linked (GlcNAc) arginine"}],"interfaces":{"TNF":[85,86,87,88,96,98,99,100,101,102,103,104,106,107,108,109,139,140,142,390,391,392,393,395,396,398]},"subunit":[{"topic":"Subunit","text":"Homotrimer; binding of TNF/TNFSF2 or LTA/TNFSF1 to the extracellular domain leads to clustering to form tetramer-of-trimeric complexes and formation of death domain pentamers, which seed the recruitment of TRADD-death domain and RIPK1-death domain (PubMed:31937565, PubMed:41922760, PubMed:7768931). TRADD- and RIPK1-interacting proteins, such as TRAFs and FADD, are then recruited to form the complex I (TNF-R1 signaling complex also known as TNF-RSC), which activates at least three distinct signaling cascades, NF-kappa-B, apoptosis and necroptosis, depending on the context (PubMed:12887920, PubMed:41922760). Interacts (via death domain) with TRADD (via death domain) (PubMed:24130170, PubMed:41922760, PubMed:7758105). Interacts (via death domain) with RIPK1 (via death domain) (PubMed:41922760). Interacts with BAG4, BABAM2, FEM1B, GRB2, SQSTM1 and TRPC4AP (PubMed:10356400, PubMed:10359574, PubMed:10542291, PubMed:15465831, PubMed:9915703). Interacts directly with NOL3 (via CARD domain); inhibits TNF-signaling pathway (By similarity). Interacts with SH3RF2; facilitating the recruitment of RIPK1 and TRADD to TNFRSF1A in a TNF-dependent process (PubMed:24130170). Interacts with PGLYRP1; this interaction is important for cell death induction (PubMed:26183779). Interacts (via death domain) with MADD (via death domain) (PubMed:9115275)"},{"topic":"Subunit","text":"(Microbial infection) Interacts with mumps virus protein SH; this interaction inhibits downstream NF-kappa-B pathway activation"},{"topic":"Subunit","text":"(Microbial infection) Interacts with HCV core protein"},{"topic":"Subunit","text":"(Microbial infection) Interacts with human cytomegalovirus/HHV-5 protein UL138"},{"topic":"Subunit","text":"(Microbial infection) Interacts with S.aureus protein A; this interaction leads to the stimulation of both surface expression and shedding of TNFRSF1A"}],"isoforms":[{"accession":"P19438-2","name":"2","synonyms":[],"notes":[],"length":347,"transcripts":{"ensembl":[],"refseq":["NM_001346091.2"],"refseqProteins":["NP_001333020.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,109,347]],"edits":[{"start":1,"end":108,"original":"MGLSTVPDLLLPLVLLELLVGIYPSGVIGLVPHLGDREKR","replacement":"","added":0}],"missing":108,"replaced":0,"novel":0,"foldedAbsent":66,"foldedMissing":66,"features":[[0,29,0],[1,79,0],[2,68,0],[3,40,0],[4,2,0],[5,1,0],[6,2,0],[7,2,0],[8,26,0],[9,2,0],[10,1,0],[11,1,0]],"interfaces":{"TNF":[15,0,26]},"model":{"entry":"AF-P19438-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P19438-2-F1-model_v6.cif","meanPlddt":68.6,"plddt":[[50,1],[70,2],[90,17],[70,1],[90,6],[70,1],[90,1],[70,3],[90,29],[70,2],[90,2],[70,5],[90,3],[70,15],[50,2],[0,9],[50,4],[70,5],[90,16],[70,6],[50,9],[0,5],[50,1],[0,15],[50,1],[0,83],[50,3],[70,7],[90,1],[70,9],[90,6],[70,1],[90,9],[70,10],[90,6],[70,1],[90,1],[70,6],[50,3],[70,7],[90,3],[70,1],[90,1],[70,15],[50,1],[0,10],[50,1],[0,1]],"losingConfide