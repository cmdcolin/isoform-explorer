6,237,240,241,242,245,247,248,249,252,257,258,259,260,261,329,331],"PKIB":[85,128,130,131,134,167,169,170,171,188,198,199,200,201,202,203,204,205,206,210,211,212,213,214,230,231,234,235,236,237,240,241,242,243,244,245,247,248,249,252,257,258,259,260,276,329,331],"PKIG":[85,128,130,131,134,137,167,169,170,171,188,197,199,200,201,202,203,204,205,206,211,212,213,231,234,235,236,237,240,241,242,244,245,247,248,249,252,253,257,258,259,260,329,331],"PRKAR1B":[84,85,87,88,128,130,131,133,134,167,169,170,171,188,190,193,194,195,197,198,199,200,201,202,203,204,205,206,211,212,213,214,217,231,235,236,237,240,243,244,245,248,249,252,277,278,279,280,281,282,283,284,285,287,291,329,331],"PRKAR2A":[51,52,84,85,87,88,128,130,131,134,167,169,170,171,188,195,197,198,199,200,201,202,203,204,205,206,211,212,213,214,215,216,217,230,231,235,236,237,240,243,244,245,248,249,252,257,258,259,260,267,271,277,278,279,280,281,282,283,284,285,291,329,331],"PRKAR2B":[84,85,87,88,128,130,131,134,137,167,169,170,171,188,193,194,195,197,198,199,200,201,202,203,204,205,206,211,212,213,214,215,217,230,231,235,236,237,240,244,245,248,249,252,257,258,259,278,279,280,281,282,284,285,286,287,291,329,331]},"subunit":[{"topic":"Subunit","text":"A number of inactive tetrameric holoenzymes are produced by the combination of homo- or heterodimers of the different regulatory subunits associated with two catalytic subunits. cAMP causes the dissociation of the inactive holoenzyme into a dimer of regulatory subunits bound to four cAMP and two free monomeric catalytic subunits. The cAMP-dependent protein kinase catalytic subunit binds PJA2. Both isoforms 1 and 2 forms activate cAMP-sensitive PKAI and PKAII holoenzymes by interacting with regulatory subunit (R) of PKA, PRKAR1A/PKR1 and PRKAR2A/PKR2, respectively. Interacts with PRKAR1A and PRKAR2B (PubMed:33058759). Interacts with NFKB1, NFKB2 and NFKBIA in platelets; these interactions are disrupted by thrombin and collagen. Binds to ABL1 in spermatozoa and with CDC25B in oocytes. Interacts with APOBEC3G and AICDA. Interacts with RAB13; downstream effector of RAB13 involved in tight junction assembly. Found in a complex at least composed of MROH2B, PRKACA isoform 2 and TCP11 (By similarity). Interacts with MROH2B (By similarity). Isoform 2 interacts with TCP11 (By similarity). Interacts with HSF1 (PubMed:21085490). Interacts with TBC1D31; in regulation of OFD1 (PubMed:33934390). Interacts in free form with SMO (via C-terminus); the interaction leads to sequestration of PRKACA at the membrane, preventing PRKACA-mediated phosphorylation of GLI transcription factors (PubMed:36202993, PubMed:39138140)"}],"isoforms":[{"accession":"P17612-2","name":"2","synonyms":["C-alpha-2","C-alpha-S","C(s)"],"notes":[{"topic":"Function","text":"Phosphorylates and activates ABL1 in sperm flagellum to promote spermatozoa capacitation"}],"length":343,"transcripts":{"ensembl":["ENST00000589994.6","ENST00000672938.1"],"refseq":["NM_207518.3"],"refseqProteins":["NP_997401.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,1],[8,16,336]],"edits":[{"start":1,"end":15,"original":"MGNAAAAKKGSEQES","replacement":"MASNSSD","added":7}],"missing":14,"replaced":0,"novel":6,"foldedAbsent":3,"foldedMissing":3,"features":[[0,1,0],[1,1,0],[2,1,0]],"interfaces":{},"model":{"entry":"AF-P17612-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P17612-2-F1-model_v6.cif","meanPlddt":96.1,"plddt":[[0,3],[50,2],[70,4],[90,35],[70,3],[90,266],[70,1],[90,29]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000072062.17","ENSG00000288516.1"],"unmapped":{"ensembl":[],"refseq":["NM_001304349.2"],"refseqProteins":["NP_001291278.1"]},"coding":{"genes":[{"id":"ENSG00000072062","name":"PRKACA","chromosome":"chr19","readthrough":false}],"gencode":10,"mapped":2},"explorer":{"gene":"PRKACA","isoforms":"PRKACA"},"locus":"chr19:14091688-14117762","exons":{"transcript":"ENST00000308677.9","first":1,"junctions":[46,108,237,336,419,546,642,765,930]},"structures":{"P176