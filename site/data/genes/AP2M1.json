M10; this interaction facilitates ADAM10 endocytosis from the plasma membrane during long-term potentiation in hippocampal neurons (PubMed:23676497). Probably interacts with ACE2 (via endocytic sorting signal motif); the interaction is inhibited by ACE2 phosphorylation (PubMed:33436498). Interacts with RALBP1; the interaction is direct (PubMed:10910768). Interacts with TMEM106B (via N-terminus) (PubMed:25066864)"}],"isoforms":[{"accession":"Q96CW1-2","name":"2","synonyms":[],"notes":[],"length":433,"transcripts":{"ensembl":["ENST00000382456.7","ENST00000439647.5","ENST00000621863.5"],"refseq":["NM_001025205.2"],"refseqProteins":["NP_001020376.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,140],[141,143,293]],"edits":[{"start":141,"end":142,"original":"QH","replacement":"","added":0}],"missing":2,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMissing":0,"features":[],"interfaces":{},"model":{"entry":"AF-Q96CW1-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q96CW1-2-F1-model_v6.cif","meanPlddt":89.4,"plddt":[[90,24],[70,7],[90,2],[70,2],[90,1],[70,8],[90,6],[70,1],[90,9],[70,1],[90,61],[70,12],[50,2],[0,4],[50,2],[70,17],[90,1],[70,3],[90,21],[70,3],[90,27],[70,4],[50,7],[0,10],[50,2],[70,3],[90,11],[70,9],[90,18],[70,2],[90,12],[70,1],[90,1],[70,2],[90,39],[70,1],[90,34],[70,5],[50,1],[70,5],[90,51],[70,1]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000161203.15"],"unmapped":{"ensembl":[],"refseq":["NM_001311198.2"],"refseqProteins":["NP_001298127.1"]},"coding":{"genes":1,"gencode":22,"mapped":4},"explorer":{"gene":"AP2M1","isoforms":"AP2M1"},"locus":"chr3:184174689-184184091","exons":{"transcript":"ENST00000292807.9","first":2,"junctions":[74,340,423,429,565,707,827,963,1061,1173]},"structures":{"Q96CW1-1":{"transcript":"ENST00000292807.9","strand":1,"coding":[184176994,184183616],"exons":[[184174855,184174959],[184176951,184177067],[184178857,184179122],[184180169,184180251],[184180645,184180650],[184180849,184180984],[184181085,184181