CC2; the CX3 complex consists of RAD51C and XRCC3 (PubMed:11751635, PubMed:11842113, PubMed:14704354). The BCDX2 subcomplex RAD51B:RAD51C interacts with RAD51 (PubMed:12427746, PubMed:16395335). Interacts with SWSAP1; involved in homologous recombination repair (PubMed:21965664). Interacts directly with PALB2 which may serve as a scaffold for a HR complex containing PALB2, BRCA2, RAD51C, RAD51 and XRCC3 (PubMed:24141787). Interacts with HELQ (PubMed:24005041). Interacts with DNA damage up-regulated protein DDUP (PubMed:35849344)"}],"isoforms":[{"accession":"O43502-2","name":"2","synonyms":[],"notes":[],"length":135,"transcripts":{"ensembl":["ENST00000421782.3"],"refseq":["NM_002876.4"],"refseqProteins":["NP_002867.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,134]],"edits":[{"start":135,"end":376,"original":"CMQLAVDVQIPECFGGVAGEAVFIDTEGSFMVDRVVDLAT","replacement":"W","added":1}],"missing":242,"replaced":0,"novel":1,"foldedAbsent":216,"foldedMissing":216,"features":[[2,2,0],[4,5,0]],"interfaces":{"XRCC2":[29,0,35],"XRCC3":[55,0,60]},"model":{"entry":"AF-O43502-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-O43502-2-F1-model_v6.cif","meanPlddt":84.9,"plddt":[[0,7],[50,3],[70,2],[90,2],[70,1],[90,20],[70,1],[90,2],[70,2],[90,25],[70,5],[50,2],[0,7],[50,4],[70,2],[90,7],[70,5],[90,20],[70,1],[90,16],[70,1]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000108384.17"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000108384","name":"RAD51C","chromosome":"chr17","readthrough":false}],"gencode":11,"mapped":2},"explorer":{"gene":"RAD51C","isoforms":"RAD51C"},"locus":"chr17:58692573-58735611","exons":{"transcript":"ENST00000337432.9","first":1,"junctions":[145,404,571,705,837,904,965,1026]},"structures":{"O43502-1":{"transcript":"ENST00000337432.9","strand":1,"coding":[58692644,58734222],"exons":[[58692602,58692788],[58694931,58695189],[58696693,58696859],[58703196,58703329],[58709859,58709990],[58720746,