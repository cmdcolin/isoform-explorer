 EPHB2; with ERBB2 and through its PDZ domain with the C-terminal tail of PRLHR. Interacts with UNC5A. Interacts (via AH domain) with NCS1/FREQ; in a calcium-dependent manner. Interacts with F-actin and associates with the ARP2/3 complex. Interacts (via PDZ domain) with ARF1 (activated); the interaction blocks Arp2/3 complex inhibition. Interacts with SORCS3 (By similarity)"}],"isoforms":[{"accession":"Q9NRD5-2","name":"2","synonyms":[],"notes":[],"length":364,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,278]],"edits":[{"start":279,"end":415,"original":"ALGEPLYRVSTGNYEYRLILRCRQEARARFSQMRKDVLEK","replacement":"VSVGGGGGLVLPPTWSARDSRWLRPTRERPGGLGWTLVPG","added":86}],"missing":0,"replaced":137,"novel":86,"foldedAbsent":77,"foldedMissing":0,"features":[[4,0,79],[5,0,1]],"interfaces":{},"model":{"entry":"AF-Q9NRD5-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9NRD5-2-F1-model_v6.cif","meanPlddt":70.4,"plddt":[[0,6],[50,1],[0,1],[50,9],[70,3],[90,7],[70,14],[50,3],[70,12],[90,1],[70,2],[90,5],[70,4],[90,6],[70,1],[90,1],[70,12],[90,1],[70,5],[90,8],[70,2],[50,8],[70,15],[50,5],[70,2],[50,1],[70,1],[50,10],[70,6],[90,1],[70,1],[90,95],[70,2],[90,1],[70,14],[50,1],[70,1],[50,6],[0,90]],"losingConfidence":4}}],"ensemblGenes":["ENSG00000100151.17"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000100151","name":"PICK1","chromosome":"chr22","readthrough":false}],"gencode":15,"mapped":3},"explorer":{"gene":null,"isoforms":null},"locus":"chr22:38057200-38076050","exons":{"transcript":"ENST00000356976.8","first":2,"junctions":[41,153,282,349,439,493,556,690,783,834,979]},"structures":{"Q9NRD5-1":{"transcript":"ENST00000356976.8","strand":1,"coding":[38057810,38075132],"exons":[[38057404,38057587],[38057753,38057850],[38059234,38059345],[38065002,38065130],[38067704,38067770],[38069033,38069122],[38070838,38070891],[38071682,38071744],[38072477,38072610]