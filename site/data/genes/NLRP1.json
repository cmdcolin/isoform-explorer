0,5],[70,9],[90,5],[70,6],[90,1],[70,1],[90,4],[70,6],[50,2],[0,20],[50,2],[70,6],[90,1],[70,2],[90,2],[70,1],[90,2],[70,2],[90,1],[70,1],[90,4],[70,1],[90,1],[70,8],[90,2],[70,2],[90,1],[70,1],[90,2],[70,5],[90,6],[70,10],[90,1],[70,1],[90,3],[70,1],[90,2],[70,3],[90,1],[70,3],[90,1],[70,4],[50,3],[0,10]]}},"features":[{"type":"Domain","start":1,"end":92,"description":"Pyrin"},{"type":"Chain","start":1,"end":1212,"description":"NACHT, LRR and PYD domains-containing protein 1, N-terminus"},{"type":"Modified residue","start":93,"end":93,"description":"Phosphoserine; by MAPK11 and MAPK14"},{"type":"Modified residue","start":99,"end":99,"description":"Phosphoserine; by MAPK11 and MAPK14"},{"type":"Modified residue","start":101,"end":101,"description":"Phosphoserine; by MAPK11 and MAPK14"},{"type":"Modified residue","start":107,"end":107,"description":"Phosphoserine; by MAPK14"},{"type":"Motif","start":111,"end":117,"description":"ZAKalpha motif 1"},{"type":"Modified residue","start":112,"end":112,"description":"Phosphothreonine; by MAPK11, MAPK14 and MAP3K20"},{"type":"Modified residue","start":113,"end":113,"description":"Phosphoserine; by MAP3K20"},{"type":"Modified residue","start":114,"end":114,"description":"Phosphothreonine; by MAP3K20"},{"type":"Modified residue","start":129,"end":129,"description":"Phosphothreonine; by MAP3K20"},{"type":"Site","start":130,"end":131,"description":"(Microbial infection) Cleavage; by human rhinovirus 14 (HRV-14) Protease 3C"},{"type":"Modified residue","start":132,"end":132,"description":"Phosphoserine; by MAP3K20"},{"type":"Modified residue","start":163,"end":163,"description":"Phosphoserine; by MAPK14"},{"type":"Modified residue","start":168,"end":168,"description":"Phosphoserine; by MAPK11 and MAPk14"},{"type":"Modified residue","start":170,"end":170,"description":"Phosphoserine; by MAPK11 and MAPK14"},{"type":"Modified residue","start":173,"end":173,"description":"Phosphoserine; by MAPK11"},{"type":"Motif","start":177,"end":183,"description":"ZAKalpha motif 2"},{"type":"Modified residue","start":178,"end":178,"description":"Phosphothreonine; by MAPK11"},{"type":"Modified residue","start":179,"end":179,"description":"Phosphoserine; by MAPK11 and MAP3K20"},{"type":"Modified residue","start":180,"end":180,"description":"Phosphothreonine; by MAPK11 and MAP3K20"},{"type":"Domain","start":328,"end":637,"description":"NACHT"},{"type":"Site","start":333,"end":334,"description":"(Microbial infection) Cleavage; by coronavirus SARS-CoV-2 proteinase nsp5"},{"type":"Binding site","start":334,"end":341,"description":"ATP"},{"type":"Repeat","start":809,"end":830,"description":"LRR 1"},{"type":"Repeat","start":838,"end":858,"description":"LRR 2"},{"type":"Repeat","start":866,"end":887,"description":"LRR 3"},{"type":"Repeat","start":895,"end":915,"description":"LRR 4"},{"type":"Repeat","start":923,"end":944,"description":"LRR 5"},{"type":"Repeat","start":950,"end":973,"description":"LRR 6"},{"type":"Region","start":1079,"end":1212,"description":"ZU5"},{"type":"Domain","start":1079,"end":1364,"description":"FIIND"},{"type":"Site","start":1212,"end":1213,"description":"Cleavage; by autolysis"},{"type":"Region","start":1213,"end":1364,"description":"UPA"},{"type":"Chain","start":1213,"end":1473,"description":"NACHT, LRR and PYD domains-containing protein 1, C-terminus"},{"type":"Domain","start":1374,"end":1463,"description":"CARD"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Interacts (via LRR repeats) with BCL2 and BCL2L1 (via the loop between motifs BH4 and BH3); these interactions reduce NLRP1 inflammasome-induced CASP1 activation and IL1B release, possibly by impairing NLRP1 interaction with PYCARD (PubMed:17418785). Interacts with NOD2; this interaction is enhanced in the presence of muramyl dipeptide (MDP) and increases IL1B release (PubMed:18511561). Interacts with EIF2AK2/PKR; this interaction requires EIF2AK2 activity, is accompanied by EIF2AK2 autophosphorylation and promotes inflammasome assembly in response to danger-associated signals (PubMed:22801494). Interacts with MEFV; this interaction targets NLRP1 to degradation by autophagy, hence preventing excessive IL1B- and IL18-mediated inflammation (PubMed:17431422, PubMed:26347139). Binds (via LRR domain) to dsDNA and dsRNA (PubMed:33243852). Interacts with DPP9; leading to inhibit activation of the inflammasome (PubMed:30291141, PubMed:31525884, PubMed:33731932). DPP9 acts via formation of a ternary complex, composed of a DPP9 homodimer, one full-length NLRP1 protein, and one cleaved C-terminus of NLRP1 (NACHT, LRR and PYD domains-containing protein 1, C-terminus) (PubMed:33731932). Interacts with DPP8; leading to inhibit activation of the inflammasome, probably via formation of a ternary complex with DPP8 (PubMed:31525884)"},{"topic":"Subunit","text":"(Microbial infection) Interacts with vaccinia virus protein F1 (PubMed:16439990)"}],"isoforms":[{"accession":"Q9C000-2","name":"2","synonyms":["NAC alpha","DEFCAP-S","NALP1-S","NLRP1deltaEx14"],"notes":[{"topic":"Function","text":"It is unclear whether is involved in inflammasome formation. It is not cleaved within the FIIND domain, does not assemble into specks, nor promote IL1B release (PubMed:22665479). However, in an vitro cell-free system, it has been shown to be activated by MDP (PubMed:17349957)"}],"length":1429,"transcripts":{"ensembl":["ENST00000269280.9","ENST00000571451.7","ENST00000576905.6"],"refseq":["NM_014922.5"],"refseqProteins":["NP_055737.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,1261],[1262,1306,168]],"edits":[{"start":1262,"end":1305,"original":"AIDDLEMKFQFVRIHKPPPLTPLYMGCRYTVSGSGSGMLE","replacement":"","added":0}],"missing":44,"replaced":0,"novel":0,"foldedAbsent":40,"foldedMissing":40,"features":[[31,44,0],[33,44,0],[34,44,0]],"interfaces":{},"model":{"entry":"AF-Q9C000-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9C000-2-F1-model_v6.cif","meanPlddt":66.2,"plddt":[[0,3],[50,2],[70,14],[90,2]