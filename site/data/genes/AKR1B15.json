{"page":"AKR1B15","gene":"AKR1B15","accession":"C9JRZ8","protein":"Aldo-keto reductase family 1 member B15","length":316,"events":["Alternative splicing"],"canonical":{"accession":"C9JRZ8-1","name":"1","synonyms":["AKR1B15.1"],"notes":[{"topic":"Function","text":"Catalyzes the NADPH-dependent reduction of a variety of carbonyl substrates, like aromatic aldehydes, alkenals, ketones and alpha-dicarbonyl compounds (PubMed:21276782, PubMed:26222439). In addition, catalyzes the reduction of androgens and estrogens with high positional selectivity (shows 17-beta-hydroxysteroid dehydrogenase activity) as well as 3-keto-acyl-CoAs (PubMed:25577493). Displays strong enzymatic activity toward all-trans-retinal and 9-cis-retinal (PubMed:26222439). May play a physiological role in retinoid metabolism (PubMed:26222439)"}],"transcripts":{"ensembl":["ENST00000652743.1"],"refseq":["NM_001367821.1"],"refseqProteins":["NP_001354750.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"model":{"entry":"AF-C9JRZ8-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-C9JRZ8-F1-model_v6.cif","meanPlddt":97.8,"plddt":[[50,1],[70,1],[90,314]]}},"features":[{"type":"Binding site","start":20,"end":22,"description":"NADP(+)"},{"type":"Binding site","start":44,"end":44,"description":"NADP(+)"},{"type":"Active site","start":49,"end":49,"description":"Proton donor"},{"type":"Site","start":78,"end":78,"description":"Lowers pKa of active site Tyr"},{"type":"Modified residue","start":125,"end":125,"description":"N6-acetyllysine"},{"type":"Binding site","start":160,"end":161,"description":"NADP(+)"},{"type":"Binding site","start":184,"end":184,"description":"NADP(+)"},{"type":"Binding site","start":210,"end":217,"description":"NADP(+)"},{"type":"Binding site","start":261,"end":273,"description":"NADP(+)"},{"type":"Modified residue","start":263,"end":263,"description":"N6-acetyllysine"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Monomer"}],"isoforms":[{"accession":"C9JRZ8-2","name":"2","synonyms