18216018). Interacts with RRP1B (PubMed:23604122). Interacts (when phosphorylated in its RS domain) with TNPO3; promoting nuclear import (PubMed:24449914). Interacts with ILDR1 (via C-terminus) and ILDR2 (By similarity). Interacts with FAM120; this interaction bridges newly transcribed lipogenic genes from RNA polymerase II to the SRSF1 and U1-70K-containing RNA-splicing machinery (PubMed:37595559)"}],"isoforms":[{"accession":"Q07955-2","name":"ASF-2","synonyms":[],"notes":[],"length":292,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,184]],"edits":[{"start":185,"end":248,"original":"GETAYIRVKVDGPRSPSYGRSRSRSRSRSRSRSRSNSRSR","replacement":"FCLSNREKLPTSGLKLMGPEVQVMEDLDLEAVVVAEAVAE","added":108}],"missing":0,"replaced":64,"novel":108,"foldedAbsent":11,"foldedMissing":0,"features":[[13,0,11],[16,0,50],[17,0,1],[18,0,1],[19,0,1],[20,0,1],[21,0,1],[22,0,1],[23,0,1],[24,0,1],[25,0,1]],"interfaces":{},"model":{"entry":"AF-Q07955-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q07955-2-F1-model_v6.cif","meanPlddt":61.2,"plddt":[[0,12],[50,3],[70,34],[50,4],[70,36],[50,2],[0,25],[50,4],[70,9],[50,1],[70,1],[50,1],[70,43],[50,7],[0,15],[50,5],[0,15],[50,1],[0,3],[50,6],[0,1],[50,1],[0,17],[50,12],[0,17],[50,1],[0,1],[50,1],[0,3],[50,1],[0,10]],"losingConfidence":2}},{"accession":"Q07955-3","name":"ASF-3","synonyms":[],"notes":[{"topic":"Miscellaneous","text":"May be due to intron retention"}],"length":201,"transcripts":{"ensembl":["ENST00000578794.2","ENST00000581979.5","ENST00000582730.6"],"refseq":["NM_001078166.2"],"refseqProteins":["NP_001071634.1"],"maneSelect":false,"decay":["ENST00000578794.2","ENST00000581979.5"],"onlyDecay":false},"segments":[[1,1,184]],"edits":[{"start":185,"end":248,"original":"GETAYIRVKVDGPRSPSYGRSRSRSRSRSRSRSRSNSRSR","replacement":"VGYTRILFFDQNWIQWS","added":17}],"missing":64,"replaced":0,"novel":17,"foldedAbsent":11,"foldedMissing":11,"features":[[13,11,0],[16,50,0]