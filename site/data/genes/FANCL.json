G, but not with FANCC, nor FANCE, interacts with HES1; this interaction may be essential for the stability and nuclear localization of FA core complex proteins (PubMed:18550849). Interacts with FANCI (PubMed:21775430). Directly interacts (via the RING-type zinc finger) with UBE2T and UBE2W (PubMed:16916645, PubMed:17938197, PubMed:19111657, PubMed:21775430, PubMed:24389026)"}],"isoforms":[{"accession":"Q9NW38-2","name":"2","synonyms":[],"notes":[],"length":380,"transcripts":{"ensembl":["ENST00000402135.8"],"refseq":["NM_001114636.2"],"refseqProteins":["NP_001108108.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,178],[184,179,197]],"edits":[{"start":178,"end":178,"original":"T","replacement":"TPQVNS","added":6}],"missing":0,"replaced":0,"novel":5,"foldedAbsent":0,"foldedMissing":0,"features":[],"interfaces":{},"model":{"entry":"AF-Q9NW38-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9NW38-2-F1-model_v6.cif","meanPlddt":89.6,"plddt":[[0,1],[50,5],[70,6],[90,9],[70,1],[90,8],[70,4],[90,9],[70,7],[90,6],[70,2],[90,1],[70,3],[90,1],[70,2],[90,1],[70,1],[90,26],[70,5],[50,2],[0,2],[50,3],[70,8],[90,16],[70,5],[90,20],[70,7],[90,12],[70,5],[50,7],[70,2],[90,34],[70,1],[90,13],[70,3],[90,59],[70,3],[50,7],[70,3],[90,7],[70,1],[90,2],[70,3],[90,8],[70,2],[90,1],[70,1],[90,15],[70,2],[90,4],[70,2],[90,15],[70,2],[50,2],[0,3]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000115392.14"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000115392","name":"FANCL","chromosome":"chr2","readthrough":false}],"gencode":37,"mapped":2},"explorer":{"gene":null,"isoforms":"FANCL"},"locus":"chr2:58159243-58241410","exons":{"transcript":"ENST00000233741.9","first":1,"junctions":[96,155,216,273,374,471,540,691,775,821,903,1020,1092]},"structures":{"Q9NW38-1":{"transcript":"ENST00000233741.9","strand":-1,"coding":[58159765,58241313],"exons":[[58159247,58159800],[58160108,58160179],[58161522,58161638],[58162866,58162947],[58