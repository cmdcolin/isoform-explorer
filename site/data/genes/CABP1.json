Binding site","start":244,"end":244,"description":"Mg(2+)"},{"type":"Binding site","start":249,"end":249,"description":"Ca(2+)"},{"type":"Domain","start":279,"end":296,"description":"EF-hand 2"},{"type":"Domain","start":302,"end":337,"description":"EF-hand 3"},{"type":"Binding site","start":315,"end":315,"description":"Ca(2+)"},{"type":"Binding site","start":317,"end":317,"description":"Ca(2+)"},{"type":"Binding site","start":319,"end":319,"description":"Ca(2+)"},{"type":"Binding site","start":321,"end":321,"description":"Ca(2+)"},{"type":"Modified residue","start":323,"end":323,"description":"Phosphoserine"},{"type":"Binding site","start":326,"end":326,"description":"Ca(2+)"},{"type":"Domain","start":339,"end":370,"description":"EF-hand 4"},{"type":"Binding site","start":352,"end":352,"description":"Ca(2+)"},{"type":"Binding site","start":353,"end":353,"description":"Ca(2+)"},{"type":"Binding site","start":354,"end":354,"description":"Ca(2+)"},{"type":"Binding site","start":356,"end":356,"description":"Ca(2+)"},{"type":"Binding site","start":357,"end":357,"description":"Ca(2+)"},{"type":"Binding site","start":358,"end":358,"description":"Ca(2+)"},{"type":"Binding site","start":360,"end":360,"description":"Ca(2+)"},{"type":"Binding site","start":363,"end":363,"description":"Ca(2+)"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Homodimer; when bound to calcium or magnesium. Interacts (via C-terminus) with ITPR1, ITPR2 and ITPR3. This binding is calcium dependent and the interaction correlates with calcium concentration. An additional calcium-independent interaction with the N-terminus of ITPR1 results in a decreased InsP(3) binding to the receptor. Interacts with CACNA1A (via C-terminal CDB motif) in the pre- and postsynaptic membranes. Interacts with CACNA1C (via C-terminal C and IQ motifs). The binding to the C motif is calcium independent whereas the binding to IQ requires the presence of calcium and is mutually exclusive with calmodulin binding. Interacts with CACNA1D (By similarity). Interacts with TRPC5 (via C-terminus). Interacts (via EF-hands 1 and 2) at microtubules with MAP1LC3B. Interacts with MYO1C (By similarity). Interacts (via EF-hands 1 and 2) with NSMF (via the central NLS-containing motif region), the interaction occurs in a calcium dependent manner after synaptic NMDA receptor stimulation and prevents nuclear import of NSMF. Interacts with SPACA9 (By similarity)"}],"isoforms":[{"accession":"Q9NZU7-1","name":"L-CaBP1","synonyms":["Caldendrin-S2"],"notes":[],"length":227,"transcripts":{"ensembl":["ENST00000288616.7"],"refseq":["NM_031205.4"],"refseqProteins":["NP_112482.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,2],[76,219,152]],"edits":[{"start":1,"end":218,"original":"MGGGDGAAFKRPGDGARLQRVLGLGSRREPRSLPAGGPAP","replacement":"MGNCVKYPLRNLSRKMCQEEQTSYMVVQTSEEGLAADAEL","added":75}],"missing":216,"replaced":0,"novel":73,"foldedAbsent":1,"foldedMissing":1,"features":[[3,1,0],[4,1,0]],"interfaces":{},"model":{"entry":"AF-Q9NZU7-1-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9NZU7-1-F1-model_v6.cif","meanPlddt":66.7,"plddt":[[0,40],[50,11],[0,2],[50,5],[0,3],[50,3],[0,1],[50,1],[0,6],[50,4],[70,5],[50,1],[70,31],[50,2],[70,1],[50,1],[70,33],[50,5],[0,1],[50,7],[70,8],[90,1],[70,1],[90,10],[70,7],[50,1],[70,17],[90,1],[70,1],[90,7],[70,7],[50,3]],"losingConfidence":0}},{"accession":"Q9NZU7-2","name":"S-CaBP1","synonyms":["Caldendrin-S1"],"notes":[],"length":167,"transcripts":{"ensembl":["ENST00000351200.6"],"refseq":["NM_004276.5"],"refseqProteins":["NP_004267.2"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,2],[16,219,152]],"edits":[{"start":1,"end":218,"original":"MGGGDGAAFKRPGDGARLQRVLGLGSRREPRSLPAGGPAP","replacement":"MGNCVKYPLRNLSRK","added":15}],"missing":216,"replaced":0,"novel":13,"foldedAbsent":1,"foldedMissing":1,"features":[[3,1,0],[4,1,0]],"interfaces":{},"model":{"entry":"AF-Q9NZU7-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9NZU7-2-F1-m