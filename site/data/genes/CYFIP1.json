owth. Interacts with NYAP1, NYAP2 and MYO16. Interacts with TMEM108 (via N-terminus); the interaction associates TMEM108 with the WAVE1 complex (By similarity)"}],"isoforms":[{"accession":"Q7L576-2","name":"2","synonyms":["4"],"notes":[],"length":822,"transcripts":{"ensembl":["ENST00000617556.4"],"refseq":["NM_001033028.3"],"refseqProteins":["NP_001028200.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,2],[127,558,696]],"edits":[{"start":1,"end":557,"original":"MAAQVTLEDALSNVDLLEELPLPDQQPCIEPPPSSLLYQP","replacement":"MAESLGSAELLRQLKSLGMERLLHAVNTFLRQSCTYLPLL","added":126}],"missing":555,"replaced":0,"novel":124,"foldedAbsent":519,"foldedMissing":519,"features":[],"interfaces":{"BRK1":[42,0,69],"NCKAP1":[24,0,173],"NCKAP1L":[23,0,167],"WASF1":[40,0,129],"WASF2":[48,0,137],"WASF3":[42,0,124]},"model":{"entry":"AF-Q7L576-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q7L576-2-F1-model_v6.cif","meanPlddt":85.3,"plddt":[[0,7],[50,9],[70,1],[50,11],[0,86],[50,9],[70,5],[90,8],[70,5],[50,5],[70,9],[90,2],[70,1],[90,16],[70,1],[90,28],[70,1],[90,103],[70,2],[90,128],[70,8],[90,1],[70,3],[50,1],[70,2],[90,155],[70,2],[90,1],[70,1],[90,46],[70,1],[90,1],[70,1],[90,52],[70,1],[90,52],[70,1],[90,28],[70,2],[50,2],[0,7],[50,1],[70,4],[90,1],[70,8],[50,2],[0,1]],"losingConfidence":0}},{"accession":"Q7L576-3","name":"3","synonyms":["5"],"notes":[],"length":447,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,807,447]],"edits":[{"start":1,"end":806,"original":"MAAQVTLEDALSNVDLLEELPLPDQQPCIEPPPSSLLYQP","replacement":"","added":0}],"missing":806,"replaced":0,"novel":0,"foldedAbsent":762,"foldedMissing":762,"features":[[0,1,0]],"interfaces":{"BRK1":[57,0,69],"NCKAP1":[57,0,173],"NCKAP1L":[55,0,167],"WASF1":[95,0,129],"WASF2":[104,0,137],"WASF3":[97,0,124]},"model":{"entry":"AF-Q7L576-3-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q7L576-3-F1-model_v6.cif","meanPlddt":91.8,"plddt":[[70