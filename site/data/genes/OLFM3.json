CACNG3, CACNG4, CACNG8 or GSG1L. This inner core of AMPAR complex is complemented by outer core constituents binding directly to the GluA/GRIA proteins at sites distinct from the interaction sites of the inner core constituents. Outer core constituents include at least PRRT1, PRRT2, CKAMP44/SHISA9, FRRS1L and NRN1. The proteins of the inner and outer core serve as a platform for other, more peripherally associated AMPAR constituents, including OLFM3. Alone or in combination, these auxiliary subunits control the gating and pharmacology of the AMPAR complex and profoundly impact their biogenesis and protein processing. Homodimer. Interacts with MYOC (By similarity). Interacts with OLFM2 (PubMed:21228389)"}],"isoforms":[{"accession":"Q96PB7-2","name":"2","synonyms":[],"notes":[],"length":235,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,217]],"edits":[{"start":218,"end":478,"original":"TCGKLMKITGPVTVKTSGTRFGAWMTDPLASEKNNRVWYM","replacement":"IDLKKRKEEEKRQQKGEA","added":18}],"missing":261,"replaced":0,"novel":18,"foldedAbsent":251,"foldedMissing":251,"features":[[5,253,0],[6,2,0],[7,1,0],[8,1,0]],"interfaces":{},"model":{"entry":"AF-Q96PB7-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q96PB7-2-F1-model_v6.cif","meanPlddt":79.1,"plddt":[[0,1],[50,8],[70,13],[50,8],[0,21],[50,7],[70,7],[50,15],[70,7],[90,43],[70,2],[90,1],[70,1],[90,1],[70,4],[90,2],[70,2],[90,40],[70,8],[50,3],[70,1],[50,1],[70,5],[90,22],[70,9],[50,3]],"losingConfidence":0}},{"accession":"Q96PB7-3","name":"3","synonyms":[],"notes":[],"length":458,"transcripts":{"ensembl":["ENST00000370103.9"],"refseq":["NM_058170.4"],"refseqProteins":["NP_477518.2"],"maneSelect":true,"decay":[],"onlyDecay":false},"segments":[[1,1,1],[24,44,435]],"edits":[{"start":1,"end":43,"original":"MSPPLLKLGAVLSTMAMISNWMSQTLPSLVGLNTTRLSTP","replacement":"MQATSNLLNLLLLSLFAGLDPSK","added":23}],"missing":0,"replaced":42,"novel":22,"foldedAbsent":0,"fold