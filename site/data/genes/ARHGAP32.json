description":"Phosphoserine"},{"type":"Modified residue","start":856,"end":856,"description":"Phosphoserine"},{"type":"Modified residue","start":892,"end":892,"description":"Phosphoserine"},{"type":"Modified residue","start":952,"end":952,"description":"Phosphoserine"},{"type":"Modified residue","start":1203,"end":1203,"description":"Phosphoserine"},{"type":"Region","start":1391,"end":1711,"description":"Interaction with GAB2"},{"type":"Modified residue","start":1523,"end":1523,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":1533,"end":1533,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":1585,"end":1585,"description":"Phosphoserine"},{"type":"Region","start":1685,"end":2087,"description":"Interaction with FYN"},{"type":"Modified residue","start":2037,"end":2037,"description":"Omega-N-methylarginine"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Interacts with NTRK1 (via cytoplasmic domain); the interaction is independent of the phosphorylation state of NTRK1 (PubMed:12446789). Interacts with SHC3 (via SH2 domain) (PubMed:12446789). Interacts with RASA1 (via SH3 domain); the interaction is necessary for the Ras activation and cell transforming activities of ARHGAP32 (By similarity). Interacts with GAB1 and GAB2 (PubMed:12819203). Interacts with CRK and CRKL (PubMed:12446789, PubMed:12819203). Found in a complex with CRKL and BCAR1; upon EGF stimulation BCAR1 may be replaced by EGFR (PubMed:12446789, PubMed:12819203). Interacts with NCK1 (via SH3 domain); NCK1 recruits phosphorylated BCAR1 to the complex (PubMed:12819203). Isoform 2 interacts with FYN; the interaction appears to be dependent on tyrosine phosphorylation of ARHGAP32 (PubMed:12788081). Interacts with EGFR; the interaction requires EGF stimulation and is increased by SHC3 (PubMed:12446789). Interacts with CDC42; the interaction requires constitutively active CDC42. Interacts with CTNNB1 (PubMed:12531901). Interacts with GRIN2B (PubMed:12857875). Interacts with DLG4 and CDH2 (By similarity). Interacts with GPHN (By similarity)"}],"isoforms":[{"accession":"A7KAX9-2","name":"2","synonyms":[],"notes":[],"length":1738,"transcripts":{"ensembl":["ENST00000392657.7","ENST00000527272.1"],"refseq":["NM_014715.4"],"refseqProteins":["NP_055530.2"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,350,1738]],"edits":[{"start":1,"end":349,"original":"METESESSTLGDDSVFWLESEVIIQVTDCEEEEREEKFRK","replacement":"","added":0}],"missing":349,"replaced":0,"novel":0,"foldedAbsent":180,"foldedMissing":180,"features":[[0,115,0],[1,63,0]],"interfaces":{},"model":{"entry":"AF-A7KAX9-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-A7KAX9-2-F1-model_v6.cif","meanPlddt":42.2,"plddt":[[0,1],[50,2],[70,1],[50,1],[70,1],[50,3],[70,1],[50,8],[70,2],[90,9],[70,5],[90,16],[70,1],[90,23],[70,6],[90,1],[70,4],[90,96],[70,3],[50,8],[70,8],[90,18],[70,1],[50,8],[0,20],[50,5],[70,4],[50,4],[0,29],[50,1],[0,2],[50,1],[0,18],[50,1],[0,1],[50,1],[0,367],[50,3],[70,20],[50,4],[0,249],[50,2],[0,296],[50,1],[0,29],[50,4],[70,4],[50,3],[70,3],[50,2],[0,19],[50,3],[0,1],[50,3],[0,66],[50,2],[70,16],[50,4],[0,2],[50,1],[0,320]],"losingConfidence":1}},{"accession":"A7KAX9-3","name":"3","synonyms":[],"notes":[],"length":322,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,291,276]],"edits":[{"start":1,"end":290,"original":"METESESSTLGDDSVFWLESEVIIQVTDCEEEEREEKFRK","replacement":"","added":0},{"start":567,"end":2087,"original":"FSGRISMAMQEGAASLSRPKSLLVSSPSTKLLTLEEAQAR","replacement":"LPHFSARTELIVPFPLRLLRKQFTPPLLGPMSPLNPLVQI","added":46}],"missing":1811,"replaced":0,"novel":46,"foldedAbsent":160,"foldedMissing":160,"features":[[0,115,0],[1,32,0],[2,1,0],[4,1,0],[5,1,0],[6,1,0],[7,1,0],[8,1,0],[9,1,0],[10,1,0],[11,1,0],[12,1,0],[13,321,0],[14,1,0],[15,1,0],[16,1,0],[17,403,0],[18,1,0]],"interfaces":{},"model":{"entry":"AF-A7KAX9-3-F1","cif":"https://alphafold