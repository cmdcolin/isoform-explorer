ink","start":282,"end":282,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in UFM1)"},{"type":"Cross-link","start":339,"end":339,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in ubiquitin)"},{"type":"Cross-link","start":384,"end":384,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO)"},{"type":"Cross-link","start":416,"end":416,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO2)"},{"type":"Cross-link","start":467,"end":467,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO)"},{"type":"Cross-link","start":480,"end":480,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in ubiquitin)"},{"type":"Modified residue","start":570,"end":570,"description":"Asymmetric dimethylarginine"},{"type":"Motif","start":570,"end":594,"description":"GAR"},{"type":"Modified residue","start":572,"end":572,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":574,"end":574,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":576,"end":576,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":577,"end":577,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":580,"end":580,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":587,"end":587,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":592,"end":592,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":594,"end":594,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":619,"end":619,"description":"Phosphoserine"},{"type":"Cross-link","start":625,"end":625,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO2)"},{"type":"Modified residue","start":641,"end":641,"description":"Phosphoserine"},{"type":"Modified residue","start":649,"end":649,"description":"Phosphoserine; by PLK1"},{"type":"Modified residue","start":673,"end":673,"description":"N6-lactoyllysine"},{"type":"Modified residue","start":676,"end":676,"description":"Phosphoserine; by ATM"},{"type":"Modified residue","start":678,"end":678,"description":"Phosphoserine; by ATM"},{"type":"Modified residue","start":688,"end":688,"description":"Phosphoserine; by CDK2"},{"type":"Modified residue","start":689,"end":689,"description":"Phosphoserine"},{"type":"Modified residue","start":701,"end":701,"description":"Phosphoserine"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Component of the MRN complex composed of two heterodimers RAD50 and MRE11 associated with a single NBN (PubMed:10839544, PubMed:26215093, PubMed:28867292, PubMed:9590181, PubMed:9651580, PubMed:9705271). The MRN complexes dimerize on DNA to form joined MRN-MRN oligomers required for DNA double-strand break repair (PubMed:36577401). As part of the MRN complex, interacts with MCM9; the interaction recruits the complex to DNA repair sites (PubMed:26215093). Component of the BASC complex, at least composed of BRCA1, MSH2, MSH6, MLH1, ATM, BLM, RAD50, MRE11 and NBN (PubMed:10783165). Found in a complex with TERF2 (PubMed:10888888). Interacts with DCLRE1C/Artemis and DCLRE1B/Apollo (PubMed:15456891, PubMed:15723659, PubMed:18469862). Interacts with ATF2 (PubMed:15916964). Interacts with EXD2 (PubMed:26807646). Interacts with MRNIP (PubMed:27568553). Interacts with SAMHD1; leading to stimulate 3'-5' exonuclease activity (PubMed:28834754, PubMed:29670289). Interacts (when ubiquitinated) with UBQLN4 (via its UBA domain) (PubMed:30612738). Interacts with CYREN (via XLF motif) (By similarity). Interacts with GFI1; promoting methylation by PRMT1 (PubMed:29651020). Interacts with DYNLL1; inhibiting the activity of MRE11 (PubMed:30464262, PubMed:37696958). Interacts with C1QBP and RAD50; interaction takes place in absence of DNA damage to form the MRC (MRE11-RAD50-C1QBP) complex that inhibits the activity of MRE11 (PubMed:31353207). Interacts with AGER/RAGE (PubMed:33918759). AGER is recruited to DNA double-strand break sites where it enhances MRE11 endonuclease activity to promote DNA repair (By similarity)"},{"topic":"Subunit","text":"(Microbial infection) Interacts with herpes simplex virus 1 protein UL12 (PubMed:20943970)"}],"isoforms":[{"accession":"P49959-2","name":"2","synonyms":[],"notes":[],"length":680,"transcripts":{"ensembl":["ENST00000323977.7","ENST00000856312.1"],"refseq":["NM_001440474.1","NM_001440475.1","NM_001440476.1","NM_005590.4"],"refseqProteins":["NP_001427403.1","NP_001427404.1","NP_001427405.1","NP_005581.2"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,594],[595,623,86]],"edits":[{"start":595,"end":622,"original":"ADTGLETSTRSRNSKTAVSASRNMSIID","replacement":"","added":0}],"missing":28,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMissing":0,"features":[[30,1,0]],"interfaces":{},"model":{"entry":"AF-P49959-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P49959-2-F1-model_v6.cif","meanPlddt":77.4,"plddt":[[0,2],[50,5],[70,2],[90,85],[70,2],[90,1],[70,3],[90,1],[70,6],[90,26],[70,3],[90,19],[70,5],[90,44],[70,3],[90,14],[70,4],[90,91],[70,4],[90,2],[70,2],[90,1],[70,1],[90,44],[70,2],[90,1],[70,1],[90,4],[70,2],[90,19],[70,2],[50,2],[0,22],[50,5],[70,8],[50,7],[70,44],[50,2],[70,38],[50,5],[0,145],[50,1]],"losingConfidence":0}},{"accession":"P49959-3","name":"3","synonyms":[],"notes":[],"length":711,"transcripts":{"ensembl":["ENST00000407439.7"],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,1],[11,8,701]],"edits":[{"start":1,"end":7,"original":"MSTADAL","replacement":"MNRNISHQKG","added":10}],"missing":0,"replaced":6,"novel":9,"foldedAbsent":0,"foldedMissing":0,"features":[[0,0,1],[1,0,1]],"interfaces":{},"model":{"entry":"AF-P49959-3-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P49959-3-F1-model_v6.cif","meanPlddt":74.8,"plddt":[[0,9],[50,1]