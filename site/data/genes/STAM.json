0097). Interacts with E3 ligase DTX3L; the interaction brings together STAM and HSG, promotes their recruitment to early endosomes and decreases STAM and HGS ubiquitination by ITCH (PubMed:24790097). Interacts with STAMBP/AMSH (PubMed:10383417). Interacts with PDGFRB (PubMed:20494825). Interacts with LITAF; the interaction is direct (PubMed:23166352). Identified in a complex with HGS and LITAF (PubMed:23166352). Interacts with HAVCR1 (PubMed:29742433)"}],"isoforms":[{"accession":"Q92783-2","name":"2","synonyms":[],"notes":[],"length":403,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,391]],"edits":[{"start":392,"end":540,"original":"YYMQSSGVSGSQVYAGPPPSGAYLVAGNAQMSHLQSYSLP","replacement":"GSGPTIRKPSPS","added":12}],"missing":149,"replaced":0,"novel":12,"foldedAbsent":0,"foldedMissing":0,"features":[],"interfaces":{},"model":{"entry":"AF-Q92783-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q92783-2-F1-model_v6.cif","meanPlddt":77.2,"plddt":[[0,3],[50,2],[70,2],[90,14],[70,1],[90,14],[70,1],[90,1],[70,2],[90,59],[70,1],[90,16],[70,2],[90,1],[70,5],[90,13],[70,3],[90,1],[70,4],[50,11],[0,11],[50,3],[70,1],[50,1],[70,11],[50,6],[0,22],[50,1],[70,2],[90,4],[70,2],[90,2],[70,5],[90,1],[70,1],[90,2],[70,3],[90,5],[70,7],[90,5],[70,4],[90,5],[70,1],[90,1],[70,1],[90,1],[70,4],[50,1],[0,1],[50,1],[0,13],[50,1],[0,11],[50,4],[70,40],[90,31],[70,6],[50,5],[0,1],[50,6],[0,5],[50,9]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000136738.16"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000136738","name":"STAM","chromosome":"chr10","readthrough":false}],"gencode":5,"mapped":1},"explorer":{"gene":null,"isoforms":null},"locus":"chr10:17644151-17716824","exons":{"transcript":"ENST00000377524.8","first":1,"junctions":[40,125,201,297,444,535,728,823,912,1000,1055,1209,1385]},"structures":{"Q92783-1":{"transcript":"ENST00000377524.8","strand":1,"coding":[17