BBP1A and DDX21. Interacts with C1QBP. Interacts with JUN (PubMed:11823437, PubMed:18180292). Interacts with WDR46 (PubMed:23848194). Interacts with MCM3AP isoform GANP (PubMed:23652018). Interacts with WDR43 (By similarity). Interacts with KPNA3 (PubMed:34564892). Interacts with GID4 (PubMed:38773330)"}],"isoforms":[{"accession":"Q9NR30-2","name":"2","synonyms":[],"notes":[],"length":715,"transcripts":{"ensembl":["ENST00000620315.2","ENST00000690316.1"],"refseq":["NM_001256910.2"],"refseqProteins":["NP_001243839.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,69,715]],"edits":[{"start":1,"end":68,"original":"MPGKLRSDAGLESDTAMKKGETLRKQTEEKEKKEKPKSDK","replacement":"","added":0}],"missing":68,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMissing":0,"features":[[0,1,0],[1,1,0],[2,1,0],[3,1,0]],"interfaces":{},"model":{"entry":"AF-Q9NR30-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9NR30-2-F1-model_v6.cif","meanPlddt":74.5,"plddt":[[0,3],[50,2],[0,1],[50,1],[0,102],[50,2],[70,7],[90,43],[70,6],[90,14],[70,3],[50,1],[70,2],[90,2],[70,1],[90,9],[70,5],[90,1],[70,2],[90,18],[70,3],[90,43],[70,12],[90,10],[70,6],[90,7],[70,15],[90,2],[70,1],[90,6],[70,3],[50,3],[70,7],[90,10],[70,1],[90,6],[70,1],[90,2],[70,8],[90,6],[70,1],[90,12],[70,1],[90,1],[70,2],[90,5],[70,7],[90,1],[70,2],[90,2],[70,2],[90,1],[70,4],[90,7],[70,2],[50,10],[70,2],[90,7],[70,16],[50,1],[70,4],[90,19],[70,3],[90,5],[70,36],[90,6],[70,1],[90,3],[70,12],[50,6],[70,3],[50,3],[70,76],[50,5],[70,1],[50,2],[0,37],[50,1],[0,29]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000165732.15"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000165732","name":"DDX21","chromosome":"chr10","readthrough":false}],"gencode":13,"mapped":3},"explorer":{"gene":null,"isoforms":null},"locus":"chr10:68956170-68985417","exons":{"transcript":"ENST00000354185.9","first":1,"junctions":[87,531,607,786,904,1090,1236,1386,1548,1668,1742,1902,2037,2082]},"structure