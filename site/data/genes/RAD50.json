 with MRNIP (PubMed:27568553). Interacts with CYREN (via XLF motif) (By similarity). Interacts with C1QBP and MRE11; interaction takes place in absence of DNA damage to form the MRC (MRE11-RAD50-C1QBP) complex that inhibits the activity of MRE11 (PubMed:31353207)"},{"topic":"Subunit","text":"(Microbial infection) Interacts with herpes simplex virus 1 protein UL12 (PubMed:20943970)"}],"isoforms":[{"accession":"Q92878-2","name":"2","synonyms":[],"notes":[],"length":1318,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,1],[12,6,1307]],"edits":[{"start":1,"end":5,"original":"MSRIE","replacement":"MLIFSVRDMFA","added":11}],"missing":0,"replaced":4,"novel":10,"foldedAbsent":4,"foldedMissing":0,"features":[],"interfaces":{},"model":{"entry":"AF-Q92878-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q92878-2-F1-model_v6.cif","meanPlddt":82.1,"plddt":[[0,6],[50,2],[70,3],[90,13],[70,3],[90,6],[70,4],[90,4],[70,4],[90,14],[70,2],[90,1],[70,9],[90,5],[70,5],[90,11],[70,7],[90,11],[70,5],[90,3],[70,4],[90,3],[70,2],[50,2],[70,8],[50,3],[70,16],[90,1],[70,2],[90,3],[70,7],[90,2],[70,16],[50,1],[70,12],[90,2],[70,3],[90,1],[70,1],[90,6],[70,2],[90,1],[70,3],[90,5],[70,1],[90,3],[70,1],[90,8],[70,1],[90,2],[70,54],[50,13],[70,65],[90,1],[70,98],[50,6],[70,52],[50,13],[70,56],[90,1],[70,2],[90,2],[70,2],[90,2],[70,2],[90,1],[70,3],[90,1],[70,2],[90,2],[70,1],[90,2],[70,2],[90,1],[70,13],[50,5],[70,11],[90,4],[70,2],[90,1],[70,1],[90,1],[70,12],[90,1],[70,14],[90,1],[70,15],[90,1],[70,18],[90,1],[70,24],[90,2],[70,1],[90,22],[70,43],[50,5],[0,1],[50,1],[0,2],[50,1],[0,1],[50,6],[70,51],[50,2],[70,132],[50,1],[70,1],[50,1],[70,1],[50,1],[70,2],[50,1],[70,3],[50,1],[70,16],[50,1],[70,1],[50,10],[70,27],[90,1],[70,3],[90,2],[70,1],[90,2],[70,14],[90,18],[70,1],[90,3],[70,17],[90,3],[70,1],[90,2],[70,2],[90,1],[70,8],[90,6],[70,3],[50,14],[70,3],[90,4],[70,4],[90,4],[70,2],[90,1],[70,8],[90,2],[70,1],[90,3],[