ransmembrane","start":186,"end":207,"description":"Helical; Name=4"},{"type":"Topological domain","start":208,"end":230,"description":"Extracellular"},{"type":"Transmembrane","start":231,"end":255,"description":"Helical; Name=5"},{"type":"Topological domain","start":256,"end":279,"description":"Cytoplasmic"},{"type":"Transmembrane","start":280,"end":306,"description":"Helical; Name=6"},{"type":"Topological domain","start":307,"end":314,"description":"Extracellular"},{"type":"Transmembrane","start":315,"end":338,"description":"Helical; Name=7"},{"type":"Motif","start":334,"end":338,"description":"NPxxY; plays a role in stabilizing the activated conformation of the receptor"},{"type":"Topological domain","start":339,"end":400,"description":"Cytoplasmic"},{"type":"Lipidation","start":353,"end":353,"description":"S-palmitoyl cysteine"},{"type":"Modified residue","start":365,"end":365,"description":"Phosphoserine"},{"type":"Modified residue","start":372,"end":372,"description":"Phosphothreonine"},{"type":"Modified residue","start":377,"end":377,"description":"Phosphoserine"},{"type":"Modified residue","start":396,"end":396,"description":"Phosphothreonine"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Forms homooligomers and heterooligomers with other GPCRs, such as OPRD1, OPRK1, OPRL1, NPFFR2, ADRA2A, SSTR2, CNR1 and CCR5 (probably in dimeric forms) (PubMed:12413885, PubMed:15778451, PubMed:15967873, PubMed:17224450). Interacts with heterotrimeric G proteins; interaction with a heterotrimeric complex containing GNAI1, GNB1 and GNG2 stabilizes the active conformation of the receptor and increases its affinity for endomorphin-2, the synthetic opioid peptide DAMGO and for morphinan agonists (By similarity). Interacts with PPL; the interaction disrupts agonist-mediated G protein activation (PubMed:12810704). Interacts (via C-terminus) with DNAJB4 (via C-terminus) (PubMed:16542645). Interacts with calmodulin; the interaction inhibits the constitutive activity of OPRM1; it abolishes basal and attenuates agonist-stimulated G protein coupling (PubMed:10419536, PubMed:10899953). Interacts with FLNA, PLD2, RANBP9 and WLS and GPM6A (PubMed:12519790, PubMed:14573758, PubMed:19788913, PubMed:20214800). Interacts with RTP4 (By similarity). Interacts with SYP and GNAS (By similarity). Interacts with RGS9, RGS17, RGS20, RGS4, PPP1R9B and HINT1 (By similarity). Interacts with SIGMAR1 (By similarity)"}],"isoforms":[{"accession":"P35372-2","name":"2","synonyms":["MOR1A","MOR-1A"],"notes":[],"length":392,"transcripts":{"ensembl":["ENST00000428397.6"],"refseq":["NM_001008504.4"],"refseqProteins":["NP_001008504.2"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,388]],"edits":[{"start":389,"end":400,"original":"LENLEAETAPLP","replacement":"VRSL","added":4}],"missing":12,"replaced":0,"novel":4,"foldedAbsent":0,"foldedMissing":0,"features":[[22,12,0],[27,1,0]],"interfaces":{},"model":{"entry":"AF-P35372-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P35372-2-F1-model_v6.cif","meanPlddt":77,"plddt":[[0,44],[50,1],[0,17],[50,3],[70,8],[90,20],[70,1],[90,3],[70,5],[90,2],[70,1],[90,24],[70,2],[90,1],[70,1],[90,30],[70,1],[90,2],[70,1],[90,3],[70,1],[90,41],[70,2],[90,13],[70,1],[90,25],[70,1],[90,2],[70,2],[90,2],[70,31],[90,10],[70,2],[90,1],[70,14],[90,13],[70,6],[50,8],[70,9],[50,4],[0,1],[50,16],[0,1],[50,1],[0,15]],"losingConfidence":0}},{"accession":"P35372-3","name":"3","synonyms":["MOR-1R","MOR-1X"],"notes":[],"length":446,"transcripts":{"ensembl":["ENST00000229768.9"],"refseq":["NM_001008505.2"],"refseqProteins":["NP_001008505.2"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,388]],"edits":[{"start":389,"end":400,"original":"LENLEAETAPLP","replacement":"CLPIPSLSCWALEQGCLVVYPGPLQGPLVRYDLPAILHSS","added":58}],"missing":0,"replaced":12,"novel":58,"foldedAbsent":0,"foldedMissing":0,"features":[[22,0,12],[27,0,1]],"interfaces":{},"model":{"entry":"AF-P35372-3-F1","cif":"https://alphafold.ebi.ac.uk/files/