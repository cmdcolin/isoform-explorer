1153). Interacts with ASPM; the katanin complex formation KATNA1:KATNB1 is required for the association of ASPM (By similarity). Interacts with dynein and NDEL1. Associates with the E3 ligase complex containing DYRK2, EDD/UBR5, DDB1 and DCAF1 proteins (EDVP complex) (PubMed:19287380). Interacts with KLHL42 (via the kelch domains). Interacts with CUL3; the interaction is enhanced by KLHL42 (PubMed:19261606). Interacts with KATNB1 and KATNBL1 (PubMed:26929214). Interacts with CAMSAP2 and CAMSAP3; leading to regulate the length of CAMSAP-decorated microtubule stretches (PubMed:24486153, PubMed:28386021)"}],"isoforms":[{"accession":"O75449-2","name":"2","synonyms":[],"notes":[],"length":311,"transcripts":{"ensembl":["ENST00000335643.12"],"refseq":["NM_001204076.2"],"refseqProteins":["NP_001191005.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,167],[168,244,140]],"edits":[{"start":168,"end":243,"original":"NKSPAAVTEPETNKFDSTGYDKDLVEALERDIISQNPNVR","replacement":"","added":0},{"start":384,"end":491,"original":"AKGREELLRISLRELELADDVDLASIAENMEGYSGADITN","replacement":"GMRP","added":4}],"missing":184,"replaced":0,"novel":4,"foldedAbsent":162,"foldedMissing":162,"features":[[2,18,0],[6,1,0]],"interfaces":{},"model":{"entry":"AF-O75449-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-O75449-2-F1-model_v6.cif","meanPlddt":70.2,"plddt":[[50,2],[70,7],[90,9],[70,3],[90,11],[70,21],[90,16],[70,1],[90,1],[70,5],[50,2],[0,23],[50,1],[0,1],[50,1],[0,7],[50,1],[0,52],[50,2],[70,2],[90,5],[70,4],[90,8],[70,2],[90,2],[70,4],[90,4],[70,6],[50,4],[70,8],[90,3],[70,9],[90,5],[70,7],[50,7],[70,16],[50,3],[0,5],[50,5],[70,3],[90,6],[70,16],[90,3],[70,4],[50,1],[0,2],[50,1]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000186625.15"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000186625","name":"KATNA1","chromosome":"chr6","readthrough":false}],"gencode":18,"mapped":11},"explorer":{"gene":null,"isoforms":null},"locus":"ch