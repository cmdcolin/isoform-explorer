},{"type":"Region","start":344,"end":489,"description":"Middle domain"},{"type":"Region","start":448,"end":685,"description":"Interaction with GSK3B"},{"type":"Region","start":502,"end":569,"description":"B domain"},{"type":"Modified residue","start":529,"end":529,"description":"Phosphoserine"},{"type":"Cross-link","start":532,"end":532,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO)"},{"type":"Cross-link","start":535,"end":535,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO)"},{"type":"Modified residue","start":548,"end":548,"description":"Phosphoserine"},{"type":"Cross-link","start":558,"end":558,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO)"},{"type":"Cross-link","start":568,"end":568,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO)"},{"type":"Glycosylation","start":585,"end":585,"description":"O-linked (GlcNAc) threonine"},{"type":"Glycosylation","start":586,"end":586,"description":"O-linked (GlcNAc) threonine"},{"type":"Cross-link","start":594,"end":594,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO)"},{"type":"Modified residue","start":597,"end":597,"description":"N6-acetyllysine; alternate"},{"type":"Cross-link","start":597,"end":597,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO); alternate"},{"type":"Cross-link","start":606,"end":606,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO)"},{"type":"Modified residue","start":607,"end":607,"description":"Phosphoserine"},{"type":"Cross-link","start":608,"end":608,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO)"},{"type":"Modified residue","start":616,"end":616,"description":"Phosphoserine; by CDK1 and PINK1"},{"type":"Modified residue","start":637,"end":637,"description":"Phosphoserine; by CAMK1 and PKA"},{"type":"Modified residue","start":644,"end":644,"description":"S-nitrosocysteine"},{"type":"Domain","start":644,"end":735,"description":"GED"},{"type":"Region","start":654,"end":668,"description":"Important for homodimerization"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Homotetramer; dimerizes through the N-terminal GTP-middle region of one molecule binding to the GED domain of another DNM1L molecule (PubMed:17553808, PubMed:23530241, PubMed:23584531, PubMed:23977156). Oligomerizes in a GTP-dependent manner to form membrane-associated tubules with a spiral pattern (PubMed:23584531). Interacts with GSK3B and MARCHF5 (PubMed:10749171, PubMed:16874301, PubMed:16936636, PubMed:9731200). Interacts (via the GTPase and B domains) with UBE2I; the interaction promotes sumoylation of DNM1L, mainly in its B domain (PubMed:19638400). Interacts with PPP3CA; the interaction dephosphorylates DNM1L and regulates its transition to mitochondria (PubMed:18838687). Interacts with BCL2L1 isoform BCL-X(L) and CLTA; DNM1L and BCL2L1 isoform BCL-X(L) may form a complex in synaptic vesicles that also contains clathrin and MFF (PubMed:23792689). Interacts with MFF; the interaction is inhibited by C11orf65/MFI (By similarity). Interacts with FIS1; may form part of a larger protein complex at the endoplasmic reticulum-mitochondrial interface during mitochondrial fission (PubMed:18695047, PubMed:24196833). Interacts with CANX (PubMed:24196833). Interacts with BCAP31 (PubMed:24196833). Interacts with MIEF2 and MIEF1; GTP-dependent, regulates GTP hydrolysis and DNM1L oligomerization (PubMed:21508961). Interacts with PGAM5; this interaction leads to dephosphorylation at Ser-656 and activation of GTPase activity and eventually to mitochondria fragmentation (PubMed:22265414). Interacts with RALBP1; during mitosis, recruits DNM1L to the mitochondrion and mediates its activation by the mitotic kinase cyclin B-CDK1 (PubMed:21822277). Interacts with FUNDC1; this interaction recruits DNM1L/DRP1 at ER-mitochondria contact sites (PubMed:27145933)"}],"isoforms":[{"accession":"O00429-2","name":"4","synonyms":["HdynIV-11","DLP1c"],"notes":[{"topic":"Function","text":"Inhibits peroxisomal division when overexpressed"}],"length":725,"transcripts":{"ensembl":["ENST00000547312.5"],"refseq":["NM_001278463.2"],"refseqProteins":["NP_001265392.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,558],[559,570,167]],"edits":[{"start":559,"end":569,"original":"LIQDSRRETKN","replacement":"","added":0}],"missing":11,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMissing":0,"features":[[11,11,0],[12,11,0],[18,1,0]],"interfaces":{},"model":{"entry":"AF-O00429-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-O00429-2-F1-model_v6.cif","meanPlddt":77.4,"plddt":[[0,1],[50,2],[70,13],[50,7],[70,4],[90,6],[70,4],[90,1],[70,1],[90,7],[70,14],[90,7],[70,4],[50,4],[0,6],[50,1],[0,2],[50,3],[70,9],[50,1],[70,9],[90,5],[70,18],[90,3],[70,1],[90,1],[70,9],[90,5],[70,15],[90,12],[70,3],[90,9],[70,7],[90,24],[70,10],[90,3],[70,5],[90,11],[70,3],[90,1],[70,2],[90,1],[70,5],[90,12],[70,1],[90,1],[70,4],[90,15],[70,17],[90,1],[70,2],[90,1],[70,9],[50,1],[70,1],[50,2],[70,7],[90,1],[70,2],[90,13],[70,13],[90,20],[70,8],[90,3],[70,17],[90,32],[70,6],[50,4],[70,6],[90,35],[70,10],[50,19],[0,91],[50,1],[0,4],[50,1],[0,1],[50,1],[0,1],[50,2],[70,12],[90,1],[70,1],[90,41],[70,39],[50,5],[0,2]],"losingConfidence":0}},{"accession":"O00429-3","name":"2","synonyms":["DLP1a"],"notes":[],"length":710,"transcripts":{"ensembl":["ENST00000452533.6"],"refseq":["NM_012063.4"],"refseqProteins":["NP_036193.2"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,532],[533,559,178]],"edits":[{"start":533,"end":558,"original":"SSKVPSALAPASQEPSPAASAEADGK","replacement":"","added":0}],"missing":26,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMissing":0,"features":[[11,26,0],[12,26,0],[15,1,0],[16,1,0],[17,1,0]],"interfaces":{},"model":{"entry":"AF-O00429-3-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-O00429-3