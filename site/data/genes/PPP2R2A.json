 PPP2R1A (PubMed:38123684). Interacts with TP53 (PubMed:17245430). Interacts with IER5 (PubMed:25816751). Interacts with MFHAS1; the interaction is direct (PubMed:28609714). Interacts with PABIR1/FAM122A (via its N-terminus); the interaction is direct and inhibits PP2A activity (PubMed:27588481, PubMed:33108758, PubMed:38123684). Interacts with ARPP19; the interaction is direct and inhibits PP2A activity (PubMed:27588481, PubMed:33108758, PubMed:38123684). Interacts with CRTC3 (PubMed:30611118)"}],"isoforms":[{"accession":"P63151-2","name":"2","synonyms":[],"notes":[],"length":457,"transcripts":{"ensembl":["ENST00000315985.7"],"refseq":["NM_001177591.2"],"refseqProteins":["NP_001171062.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,1],[13,3,445]],"edits":[{"start":1,"end":2,"original":"MA","replacement":"MFPKFSLRSMFH","added":12}],"missing":0,"replaced":1,"novel":11,"foldedAbsent":0,"foldedMissing":0,"features":[[0,0,1]],"interfaces":{},"model":{"entry":"AF-P63151-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P63151-2-F1-model_v6.cif","meanPlddt":90.8,"plddt":[[0,17],[50,1],[70,2],[90,8],[70,7],[90,32],[70,2],[50,9],[70,2],[90,14],[70,1],[90,1],[70,2],[90,16],[70,1],[90,21],[70,1],[90,2],[70,4],[90,2],[70,18],[90,7],[70,1],[90,101],[70,2],[90,7],[70,9],[90,102],[70,7],[90,8],[70,3],[50,1],[70,6],[90,37],[70,2],[50,1]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000221914.12"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000221914","name":"PPP2R2A","chromosome":"chr8","readthrough":false}],"gencode":7,"mapped":2},"explorer":{"gene":null,"isoforms":null},"locus":"chr8:26291508-26372692","exons":{"transcript":"ENST00000380737.8","first":1,"junctions":[7,82,180,346,459,637,802,972,1064]},"structures":{"P63151-1":{"transcript":"ENST00000380737.8","strand":1,"coding":[26291820,26370413],"exons":[[26291508,26291826],[26293666,26293740],[26338890,26338987],[26354468,26354633],[26360169,26360281],[263