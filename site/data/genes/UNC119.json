{"page":"UNC119","gene":"UNC119","accession":"Q13432","protein":"Protein unc-119 homolog A","length":240,"events":["Alternative splicing"],"canonical":{"accession":"Q13432-1","name":"A","synonyms":[],"notes":[],"transcripts":{"ensembl":["ENST00000335765.9"],"refseq":["NM_005148.4"],"refseqProteins":["NP_005139.1"],"maneSelect":true,"decay":[],"onlyDecay":false},"model":{"entry":"AF-Q13432-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q13432-F1-model_v6.cif","meanPlddt":77.9,"plddt":[[0,48],[50,3],[0,2],[50,1],[0,2],[50,1],[70,2],[90,43],[70,1],[90,1],[70,4],[50,6],[0,1],[50,1],[0,1],[50,1],[0,1],[50,6],[70,2],[90,69],[70,2],[90,39],[70,1],[50,2]]}},"features":[{"type":"Region","start":1,"end":59,"description":"Required for midbody localization"},{"type":"Modified residue","start":37,"end":37,"description":"Phosphoserine; by CK2"},{"type":"Modified residue","start":39,"end":39,"description":"Phosphoserine; by CK2"},{"type":"Modified residue","start":41,"end":41,"description":"Phosphoserine; by CK2"},{"type":"Region","start":121,"end":240,"description":"Required for centrosome localization"},{"type":"Binding site","start":131,"end":131,"description":"tetradecanoate"}],"interfaces":{"ARL2":[66,149,164,171,172,174,178,179,180,181,182,183,184,186,187,188,189,190,191,192,193,197],"ARL3":[94,96,142,146,149,176,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195]},"subunit":[{"topic":"Subunit","text":"Interacts with CABP4; in the absence of calcium (By similarity). Interacts with DNM1; leading to a decrease of DNM1 GTPase activity (By similarity). May interact with GTP-bound ARL1. Interacts with ARL2 and ARL3 (GTP-bound forms); this promotes the release of myyristoylated cargo proteins (PubMed:22960633, PubMed:30945270). Found in a complex with ARL3, RP2 and UNC119; RP2 induces hydrolysis of GTP ARL3 in the complex, leading to the release of UNC119. Interacts with NPHP3 (when myristoylated). Interacts with CYS1 (when myristoylated). Interacts with MACIR; interaction only takes place when UNC119 is not liganded with myristoylated proteins. Interacts with LCK; this interaction plays a crucial role in activation of LCK. Interacts with FYN. Interacts with RAB11A; in a cell cycle-dependent manner. Interacts with LYN (via SH2 and SH3 domains); leading to LYN activation. Found in a complex with ABL1, ABL2, CRK and UNC119; leading to the inhibition of CRK phosphorylation by ABL kinases. Interacts with CD44; leading to Shigella invasion. Interacts with KLHL18 (via kelch repeats) (PubMed:31696965). Interacts with PPP3CA, PPP3CB and PPP3CC (By similarity). Interacts with USP48; this interaction promotes UNC119 stability (PubMed:36293380)"}],"isoforms":[{"accession":"Q13432-2","name":"B","synonyms":[],"notes":[],"length":220,"transcripts":{"ensembl":["ENST00000301032.8"],"refseq":["NM_054035.2"],"refseqProteins":["NP_473376.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,203]],"edits":[{"start":204,"end":240,"original":"ISEMIRHPYETQSDSFYFVDDRLVMHNKADYSYSGTP","replacement":"SARAGSSGSGEVGASRD","added":17}],"missing":37,"replaced":0,"novel":17,"foldedAbsent":35,"foldedMissing":35,"features":[[4,37,0]],"interfaces":{},"model":{"entry":"AF-Q13432-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q13432-2-F1-model_v6.cif","meanPlddt":70,"plddt":[[0,51],[50,6],[70,2],[90,13],[70,3],[90,2],[70,3],[90,24],[70,1],[90,1],[70,3],[50,5],[0,1],[50,1],[0,1],[50,1],[0,1],[50,6],[70,16],[90,15],[70,1],[90,8],[70,8],[90,6],[70,2],[90,13],[70,13],[50,3],[0,10]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000109103.13"],"unmapped":{"ensembl":[],"refseq":["NM_001330166.2"],"refseqProteins":["NP_001317095.1"]},"coding":{"genes":[{"id":"ENSG00000109103","name":"UNC119","chromosome":"chr17","readthrough":false}],"gencode":6,"mapped":2},"explorer":{"gene":"UNC119","isoforms":"UNC119"},"locus":"chr17:28546708-28552653","exons":{"transcript":"ENST00000335765.9","first":1,"junctions":[220,334,437,610]},"structures":{"Q13432-1":