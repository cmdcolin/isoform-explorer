V irradiation. Interacts (via N-terminus) with PRKN/parkin (via first RING-type domain) (PubMed:16135753). Interacts with TARS3 (PubMed:24312579)"}],"isoforms":[{"accession":"Q13155-2","name":"2","synonyms":["DX2"],"notes":[],"length":251,"transcripts":{"ensembl":["ENST00000395236.2"],"refseq":["NM_001326607.2"],"refseqProteins":["NP_001313536.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,45],[46,115,206]],"edits":[{"start":46,"end":114,"original":"EESNLSLQALESRQDDILKRLYELKAAVDGLSKMIQTPDA","replacement":"","added":0}],"missing":69,"replaced":0,"novel":0,"foldedAbsent":37,"foldedMissing":37,"features":[[0,33,0]],"interfaces":{"AIMP2":[3,0,25]},"model":{"entry":"AF-Q13155-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q13155-2-F1-model_v6.cif","meanPlddt":83.2,"plddt":[[0,1],[50,1],[0,1],[50,7],[0,1],[50,1],[0,1],[50,7],[0,1],[50,1],[0,2],[50,2],[0,3],[50,2],[0,17],[50,2],[70,2],[90,48],[70,1],[50,5],[70,6],[90,17],[70,1],[50,4],[70,3],[90,16],[70,1],[90,22],[70,1],[90,41],[70,2],[50,3],[70,2],[90,23],[70,3]],"losingConfidence":2}}],"ensemblGenes":["ENSG00000106305.11"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"genes":[{"id":"ENSG00000106305","name":"AIMP2","chromosome":"chr7","readthrough":false}],"gencode":4,"mapped":2},"explorer":{"gene":"AIMP2","isoforms":"AIMP2"},"locus":"chr7:6009245-6024655","exons":{"transcript":"ENST00000223029.8","first":1,"junctions":[135,342,574]},"structures":{"Q13155-1":{"transcript":"ENST00000223029.8","strand":1,"coding":[6009364,6023691],"exons":[[6009272,6009498],[6015146,6015352],[6017814,6018045],[6023303,6023834]]},"Q13155-2":{"transcript":"ENST00000395236.2","strand":1,"coding":[6009364,6023691],"exons":[[6009316,6009498],[6017814,6018045],[6023303,6023747]]}}}