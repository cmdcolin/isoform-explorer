{"page":"LDB1","gene":"LDB1","accession":"Q86U70","protein":"LIM domain-binding protein 1","length":411,"events":["Alternative splicing"],"canonical":{"accession":"Q86U70-1","name":"1","synonyms":[],"notes":[],"transcripts":{"ensembl":["ENST00000673968.1"],"refseq":["NM_001113407.3"],"refseqProteins":["NP_001106878.1"],"maneSelect":true,"decay":[],"onlyDecay":false},"model":{"entry":"AF-Q86U70-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q86U70-F1-model_v6.cif","meanPlddt":70.4,"plddt":[[0,22],[50,1],[0,25],[50,1],[0,14],[50,1],[70,2],[90,43],[70,3],[90,56],[70,5],[90,39],[70,1],[90,2],[70,1],[90,5],[70,2],[90,2],[70,2],[90,18],[70,15],[90,2],[70,2],[90,1],[70,1],[90,5],[70,2],[90,2],[70,2],[90,2],[70,5],[50,3],[0,49],[50,1],[0,1],[50,8],[0,4],[50,14],[0,1],[50,1],[0,27],[50,1],[0,2],[50,1],[0,12],[50,1],[0,1]]}},"features":[{"type":"Modified residue","start":2,"end":2,"description":"N-acetylserine"},{"type":"Modified residue","start":61,"end":61,"description":"Phosphothreonine"},{"type":"Modified residue","start":265,"end":265,"description":"Phosphoserine"},{"type":"Modified residue","start":302,"end":302,"description":"Phosphoserine"},{"type":"Domain","start":336,"end":375,"description":"LIM interaction domain (LID)"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Interacts with ESR1 (PubMed:19117995). Forms homodimers and heterodimers. Interacts with and activates LHX1/LIM1. Interacts with the LIM domains of ISL1 and LMO2. Can assemble in a complex with LMO2 and TAL1/SCL but does not interact with TAL1/SCL directly. Strongly interacts with the LIM2 domain of LMX1A and more weakly with the LIM1 domain. Homodimerization is not required for, and does not effect, LMX1A-binding. Component of a nuclear TAL-1 complex composed at least of CBFA2T3, LDB1, TAL1 and TCF3. Interacts with LHX6 and LHX9. At neuronal promoters, forms a complex with LHX3 involved in the specification of interneurons, in motor neurons, it is displaced by ISL1 to form a ternary complex in which ISL1 contacts both LHX3 and LDB1. Interacts with SLK; leading to negatively regulate SLK kinase activity (By similarity). Interacts with YWHAZ. Interacts with PRDM1/BLIMP1 (PubMed:32417234). Interacts with LMO4. Interacts with RLIM/RNF12; the interaction inhibits the ubiquitination of LMO proteins (By similarity)"}],"isoforms":[{"accession":"Q86U70-2","name":"3","synonyms":["a"],"notes":[],"length":375,"transcripts":{"ensembl":["ENST00000361198.9"],"refseq":["NM_003893.5"],"refseqProteins":["NP_003884.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,37,375]],"edits":[{"start":1,"end":36,"original":"MSVGCACPGCSSKSFKLYSPKEPPNGNAFPPFHPGT","replacement":"","added":0}],"missing":36,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMissing":0,"features":[[0,1,0]],"interfaces":{},"model":{"entry":"AF-Q86U70-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q86U70-2-F1-model_v6.cif","meanPlddt":73.2,"plddt":[[0,1],[50,1],[0,1],[50,1],[0,1],[50,5],[0,2],[50,1],[0,14],[50,1],[70,2],[90,43],[70,3],[90,56],[70,4],[90,40],[70,1],[90,8],[70,2],[90,2],[70,2],[90,19],[70,14],[90,1],[70,3],[90,1],[70,1],[90,5],[70,2],[90,2],[70,2],[90,2],[70,5],[50,3],[0,51],[50,1],[0,1],[50,3],[0,1],[50,2],[0,5],[50,18],[0,35],[50,1],[0,1],[50,1],[0,1],[50,1],[0,2]],"losingConfidence":0}},{"accession":"Q86U70-3","name":"2","synonyms":["b"],"notes":[{"topic":"Miscellaneous","text":"Due to intron retention. Lacks LIM-binding domain"}],"length":316,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,37,299]],"edits":[{"start":1,"end":36,"original":"MSVGCACPGCSSKSFKLYSPKEPPNGNAFPPFHPGT","replacement":"","added":0},{"start":336,"end":411,"original":"DVMVVGEPTLMGGEFGDEDERLITRLENTQFDAANGIDDE","replacement":"VSISAFFSLLGCPTTHP","added":17}],"missing":112,"replaced":0,"novel":17,"foldedAbsent":0,"foldedMissing":0,"features":[[0,1,0],[4,40,0]],"interfaces":{},"model":{"entry":"AF-Q86U70-3-F1","cif":"https://alphafo