ernate"},{"type":"Modified residue","start":444,"end":444,"description":"Omega-N-methylarginine; by PRMT1; alternate"},{"type":"Repeat","start":448,"end":450,"description":"1-1"},{"type":"Region","start":448,"end":559,"description":"8 X 3 AA repeats of R-G-G"},{"type":"Repeat","start":451,"end":453,"description":"1-2"},{"type":"Repeat","start":460,"end":464,"description":"2-1"},{"type":"Region","start":460,"end":488,"description":"3 X 4 AA repeats of Y-Y-G-Y"},{"type":"Repeat","start":469,"end":472,"description":"2-2"},{"type":"Repeat","start":478,"end":480,"description":"1-3"},{"type":"Repeat","start":485,"end":488,"description":"2-3"},{"type":"Modified residue","start":496,"end":496,"description":"Omega-N-methylarginine; by PRMT1"},{"type":"Repeat","start":498,"end":500,"description":"1-4"},{"type":"Modified residue","start":510,"end":510,"description":"Asymmetric dimethylarginine; by PRMT1"},{"type":"Modified residue","start":518,"end":518,"description":"Asymmetric dimethylarginine; by PRMT1; alternate"},{"type":"Modified residue","start":518,"end":518,"description":"Omega-N-methylarginine; by PRMT1; alternate"},{"type":"Region","start":518,"end":549,"description":"Interaction with SMN"},{"type":"Modified residue","start":526,"end":526,"description":"Asymmetric dimethylarginine; by PRMT1; alternate"},{"type":"Modified residue","start":526,"end":526,"description":"Omega-N-methylarginine; by PRMT1; alternate"},{"type":"Repeat","start":526,"end":528,"description":"1-5"},{"type":"Modified residue","start":536,"end":536,"description":"Asymmetric dimethylarginine; by PRMT1; alternate"},{"type":"Modified residue","start":536,"end":536,"description":"Omega-N-methylarginine; by PRMT1; alternate"},{"type":"Modified residue","start":539,"end":539,"description":"Asymmetric dimethylarginine; by PRMT1; alternate"},{"type":"Modified residue","start":539,"end":539,"description":"Omega-N-methylarginine; by PRMT1; alternate"},{"type":"Repeat","start":539,"end":541,"description":"1-6"},{"type":"Repeat","start":554,"end":556,"description":"1-7"},{"type":"Repeat","start":557,"end":559,"description":"1-8"},{"type":"Motif","start":564,"end":578,"description":"Bipartite nuclear localization signal"},{"type":"Modified residue","start":587,"end":587,"description":"Phosphoserine"},{"type":"Cross-link","start":607,"end":607,"description":"Glycyl lysine isopeptide (Lys-Gly) (interchain with G-Cter in SUMO2)"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Isoform 1 is a component of the APOB mRNA editosome complex and interacts with APOBEC1 and A1CF (APOBEC1 complementation factor). Part of a complex associated with the FOS mCRD domain and consisting of PABPC1, PAIP1, CSDE1/UNR, HNRPD and SYNCRIP. Isoform 3 interacts with HNRPR. Interacts with POLR2A hyperphosphorylated C-terminal domain. Isoform 1, isoform 2 and isoform 3 interact with SMN. Isoform 3 interacts through its C-terminal domain with SYT7, SYT8 and SYT9 (By similarity). The non-phosphorylated and phosphorylated forms are colocalized with PAIP1 in polysomes (By similarity). Interacts with HABP4 (PubMed:19523114). Identified in a histone pre-mRNA complex, at least composed of ERI1, LSM11, SLBP, SNRPB, SYNCRIP and YBX1 (By similarity). Identified in the spliceosome C complex. Component of the coding region determinant (CRD)-mediated complex, composed of DHX9, HNRNPU, IGF2BP1, SYNCRIP and YBX1. Identified in a mRNP complex, at least composed of DHX9, DDX3X, ELAVL1, HNRNPU, IGF2BP1, ILF3, PABPC1, PCBP2, PTBP2, STAU1, STAU2, SYNCRIP and YBX1. Identified in a mRNP granule complex, at least composed of ACTB, ACTN4, DHX9, ERG, HNRNPA1, HNRNPA2B1, HNRNPAB, HNRNPD, HNRNPL, HNRNPR, HNRNPU, HSPA1, HSPA8, IGF2BP1, ILF2, ILF3, NCBP1, NUCLEOLIN, PABPC1, PABPC4, PABPN1, RPLP0, RPS3, RPS3A, RPS4X, RPS8, RPS9, SYNCRIP, YBX1 and untranslated mRNAs. Interacts with GTPBP1. Component of the GAIT complex; in humans the complex assembly seems to be a two-step process in which EPRS1 first associates with SYNCRIP to form a pre-GAIT complex which is deficient in GAIT element binding"},{"topic":"Subunit","text":"(Microbial infection) Interacts with minute virus of mice (MVM) NS1 protein"},{"topic":"Subunit","text":"(Microbial infection) Interacts with herpes virus 8/HHV-8 protein vIRF-1; this interaction induces ubiquitination and degradation of SYNCRIP"}],"isoforms":[{"accession":"O60506-2","name":"2","synonyms":["hnRNP Q2"],"notes":[{"topic":"Miscellaneous","text":"May be due to a competing donor splice site"}],"length":588,"transcripts":{"ensembl":["ENST00000678930.1"],"refseq":["NM_001159675.2"],"refseqProteins":["NP_001153147.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,301],[302,337,287]],"edits":[{"start":302,"end":336,"original":"ARRRLMSGKVKVWGNVGTVEWADPIEDPDPEVMAK","replacement":"","added":0}],"missing":35,"replaced":0,"novel":0,"foldedAbsent":31,"foldedMissing":31,"features":[[5,24,0]],"interfaces":{},"model":{"entry":"AF-O60506-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-O60506-2-F1-model_v6.cif","meanPlddt":68.2,"plddt":[[0,5],[50,1],[0,7],[50,1],[0,4],[50,3],[70,5],[90,2],[70,1],[90,3],[70,1],[90,15],[70,3],[90,2],[70,1],[90,27],[70,9],[90,2],[70,1],[90,3],[70,1],[90,3],[70,1],[90,2],[70,6],[50,3],[0,3],[50,2],[70,4],[90,16],[70,3],[90,5],[70,16],[90,34],[70,6],[90,37],[70,2],[50,2],[70,2],[50,1],[70,3],[50,1],[70,16],[50,2],[70,27],[50,8],[70,11],[90,13],[70,1],[90,2],[70,2],[90,1],[70,8],[90,1],[70,1],[90,1],[70,7],[90,2],[70,3],[90,1],[70,9],[90,1],[70,4],[50,3],[0,2],[50,23],[0,2],[50,3],[0,1],[50,4],[0,64],[50,1],[0,6],[50,3],[0,106]],"losingConfidence":1}},{"accession":"O60506-3","name":"3","synonyms":["hnRNP Q1"],"notes":[{"topic":"Miscellaneous","text":"May be due to a competing donor splice site and to an exon inclusion"}],"length":562,"transcripts":{"ensembl":["ENST00000355238.11","ENST00000444272.2","ENST00000676637.1","ENST00000678528.1","ENST00000682083.1","ENST00000683364.1","ENST00000684220.1"],"refseq":["NM_00115