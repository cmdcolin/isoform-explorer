iption":"N-linked (GlcNAc...) asparagine"},{"type":"Disulfide bond","start":137,"end":181,"description":""},{"type":"Domain","start":141,"end":230,"description":"Ig-like C2-type 2"},{"type":"Disulfide bond","start":160,"end":212,"description":""},{"type":"Glycosylation","start":196,"end":196,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Glycosylation","start":209,"end":209,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Domain","start":242,"end":348,"description":"Ig-like C2-type 3"},{"type":"Disulfide bond","start":266,"end":332,"description":""},{"type":"Glycosylation","start":299,"end":299,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Transmembrane","start":368,"end":388,"description":"Helical"},{"type":"Topological domain","start":389,"end":570,"description":"Cytoplasmic"},{"type":"Domain","start":403,"end":546,"description":"TIR"},{"type":"Active site","start":482,"end":482,"description":""},{"type":"Modified residue","start":557,"end":557,"description":"Phosphoserine"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"The interleukin-36 receptor complex is a heterodimer of IL1RL2 and IL1RAP; the association is inhibited by IL36RN (By similarity). The interleukin-1 receptor complex is a heterodimer of IL1R1 and IL1RAP. Associates with IL1R2 to form a non-signaling interleukin-1 receptor complex. Isoform 4 interacts with IL1R1 in an interleukin-1-dependent manner. Interacts with IL-33-bound IL1RL1 to form the minimal interleukin-33 signaling complex with a 1:1:1 stoichiometry. Interacts with KIT (independently of stimulation with KITLG/SCF). A mast cell-specific KITLG/SCF-induced interleukin-33 signaling complex contains IL1RL1, IL1RAP, KIT and MYD88 (By similarity). Interacts (via the first immunoglobulin domain) with PTPRD (via the third immunoglobulin domain); induces pre- and postsynaptic differentiation of neurons (By similarity)"}],"isoforms":[{"accession":"Q9NPH3-2","name":"2","synonyms":["Soluble IL-1RAcP","sIL-1RAcP"],"notes":[{"topic":"Function","text":"Associates with secreted ligand-bound IL1R2 and increases the affinity of secreted IL1R2 for IL1B; this complex formation may be the dominant mechanism for neutralization of IL1B by secreted/soluble receptors (PubMed:12530978). Enhances the ability of secreted IL1R1 to inhibit IL-33 signaling (By similarity)"}],"length":356,"transcripts":{"ensembl":["ENST00000422485.5","ENST00000422940.5"],"refseq":["NM_001167930.2","NM_134470.4"],"refseqProteins":["NP_001161402.1","NP_608273.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,350]],"edits":[{"start":351,"end":570,"original":"VPAPRYTVELACGFGATVLLVVILIVVYHVYWLEMVLFYR","replacement":"GNRCGQ","added":6}],"missing":220,"replaced":0,"novel":6,"foldedAbsent":191,"foldedMissing":191,"features":[[2,17,0],[18,21,0],[19,182,0],[20,144,0],[21,1,0],[22,1,0]],"interfaces":{},"model":{"entry":"AF-Q9NPH3-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9NPH3-2-F1-model_v6.cif","meanPlddt":90.8,"plddt":[[0,5],[50,2],[0,13],[50,2],[70,1],[90,5],[70,6],[90,16],[70,6],[90,19],[70,1],[90,1],[70,1],[90,107],[70,1],[90,88],[70,2],[90,12],[70,7],[90,54],[70,2],[50,1],[0,4]],"losingConfidence":0}},{"accession":"Q9NPH3-3","name":"3","synonyms":["Soluble IL-1RAcP-beta","sIL-1RAcP-beta"],"notes":[{"topic":"Miscellaneous","text":"May be produced at very low levels due to a premature stop codon in the mRNA, leading to nonsense-mediated mRNA decay"}],"length":346,"transcripts":{"ensembl":["ENST00000342550.6","ENST00000413869.5"],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":["ENST00000342550.6","ENST00000413869.5"],"onlyDecay":true},"segments":[[1,1,301]],"edits":[{"start":302,"end":570,"original":"ISHSRTEDETRTQILSIKKVTSEDLKRSYVCHARSAKGEV","replacement":"ASSKIHSGTGLWFWSHSPASGDSHCCLPCLLARDGPILPG","added":45}],"missing":269,"replaced":0,"novel":45,"foldedAbsent":240,"foldedMissing":240,"features":[[2,66,0],[15,47,0],[16,1,0],[18,21,0],[19,182,0],[20,144,0],[21,1,0],[22,1,0]]