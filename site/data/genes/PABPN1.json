ternate"},{"type":"Modified residue","start":259,"end":259,"description":"Asymmetric dimethylarginine; alternate"},{"type":"Modified residue","start":259,"end":259,"description":"Omega-N-methylarginine; alternate"},{"type":"Modified residue","start":263,"end":263,"description":"Asymmetric dimethylarginine; alternate"},{"type":"Modified residue","start":263,"end":263,"description":"Omega-N-methylarginine; alternate"},{"type":"Modified residue","start":265,"end":265,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":267,"end":267,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":269,"end":269,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":277,"end":277,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":279,"end":279,"description":"Asymmetric dimethylarginine"},{"type":"Region","start":286,"end":306,"description":"Interaction with PAPOLA"},{"type":"Modified residue","start":287,"end":287,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":289,"end":289,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":291,"end":291,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":294,"end":294,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":296,"end":296,"description":"Asymmetric dimethylarginine"},{"type":"Modified residue","start":298,"end":298,"description":"Asymmetric dimethylarginine"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"May interact with SETX (PubMed:21700224). Monomer and homooligomer. Binds RNA as a monomer and oligomerizes when bound to poly(A). Interacts with PAPOLA, but only in presence of oligo(A) RNA. Interacts with transportin. Identified in a IGF2BP1-dependent mRNP granule complex containing untranslated mRNAs. Association in a ternary complex with CPSF4 and influenza A virus NS1 blocks pre-mRNAs processing, thereby preventing nuclear export of host cell mRNAs. Associates in a single complex with SKIP and MYOD1 and interacts with SKIP in differentiated myocytes. Interacts with NUDT21/CPSF5. Interacts (via RRM domain and C-terminal arginine-rich region) with ZFP36 (via hypophosphorylated form); this interaction occurs in the nucleus in a RNA-independent manner, decreases in presence of single-stranded poly(A) RNA-oligomer and in a p38-dependent-manner and may down-regulated RNA poly(A) polymerase activity (By similarity). Component of the poly(A) tail exosome targeting (PAXT) complex made of accessory factors, such as PABPN1, ZFC3H1 and MTREX (PubMed:27871484). Interacts with ZFC3H1 in a RNase-insensitive manner (PubMed:27871484). Interacts with FRG1 (PubMed:17103222). Interacts with ZC3H11A (PubMed:37356722)"}],"isoforms":[{"accession":"Q86U42-2","name":"2","synonyms":[],"notes":[{"topic":"Miscellaneous","text":"May be due to a competing donor splice site"}],"length":296,"transcripts":{"ensembl":["ENST00000397276.6"],"refseq":["NM_001360551.3"],"refseqProteins":["NP_001347480.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,294]],"edits":[{"start":295,"end":306,"original":"GRARATSWYSPY","replacement":"SG","added":2}],"missing":12,"replaced":0,"novel":2,"foldedAbsent":1,"foldedMissing":1,"features":[[9,12,0],[23,12,0],[28,1,0],[29,1,0]],"interfaces":{},"model":{"entry":"AF-Q86U42-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q86U42-2-F1-model_v6.cif","meanPlddt":69,"plddt":[[50,1],[0,2],[50,3],[0,1],[50,12],[70,1],[50,5],[70,1],[50,1],[70,1],[50,31],[0,2],[50,1],[70,7],[50,4],[70,2],[50,1],[70,1],[50,2],[70,1],[50,10],[0,1],[50,4],[0,1],[50,6],[0,2],[50,1],[0,2],[50,2],[0,4],[50,3],[70,1],[50,2],[70,24],[50,1],[70,1],[50,7],[0,4],[50,5],[70,6],[90,39],[70,5],[90,36],[70,3],[50,9],[0,3],[50,1],[0,23],[50,3],[0,1],[50,6]],"losingConfidence":0}}],"ensemblGenes":["ENSG00000100836.12"],"unmapped":{"ensembl":[],"refseq":[],"refseqProteins":[]},"coding":{"gen