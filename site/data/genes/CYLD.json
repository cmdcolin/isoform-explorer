tion":"Phosphoserine; by IKKE"},{"type":"Modified residue","start":422,"end":422,"description":"Phosphoserine"},{"type":"Region","start":470,"end":554,"description":"Interaction with IKBKG/NEMO"},{"type":"Domain","start":492,"end":535,"description":"CAP-Gly 3"},{"type":"Domain","start":592,"end":950,"description":"USP"},{"type":"Active site","start":601,"end":601,"description":"Nucleophile"},{"type":"Region","start":781,"end":833,"description":"B-box"},{"type":"Binding site","start":788,"end":788,"description":"Zn(2+)"},{"type":"Binding site","start":791,"end":791,"description":"Zn(2+)"},{"type":"Binding site","start":799,"end":799,"description":"Zn(2+)"},{"type":"Binding site","start":802,"end":802,"description":"Zn(2+)"},{"type":"Binding site","start":817,"end":817,"description":"Zn(2+)"},{"type":"Binding site","start":820,"end":820,"description":"Zn(2+)"},{"type":"Binding site","start":825,"end":825,"description":"Zn(2+)"},{"type":"Binding site","start":833,"end":833,"description":"Zn(2+)"},{"type":"Active site","start":871,"end":871,"description":"Proton acceptor"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Interacts (via CAP-Gly domain) with IKBKG/NEMO (via proline-rich C-terminal region) (PubMed:12917689, PubMed:12917690, PubMed:12917691, PubMed:15341735). Interacts with TRAF2 and TRIP (PubMed:12917691, PubMed:14676304). Interacts with PLK1, DVL1, DVL3, MAVS, TBK1, IKKE and RIGI (PubMed:17495026, PubMed:18636086, PubMed:20227366, PubMed:32185393). Interacts (via CAP-Gly domain) with microtubules (PubMed:19893491). Interacts with HDAC6 and BCL3 (PubMed:19893491). Interacts with MAP3K7 (By similarity). Identified in a complex with TRAF6 and SQSTM1 (By similarity). Interacts with OPTN and SQSTM1 (PubMed:32185393). Interacts with CEP350 (PubMed:25134987). Interacts with RNF31; the interaction is indirect and is mediated via SPATA2 (PubMed:26997266). Interacts with SPATA2 (via the PUB domain); the interaction is direct and recruits CYLD to the LUBAC complex, thereby regulating TNF-induced necroptosis (PubMed:27307491, PubMed:27458237, PubMed:27545878, PubMed:27591049)"}],"isoforms":[{"accession":"Q9NQC7-2","name":"2","synonyms":[],"notes":[],"length":953,"transcripts":{"ensembl":["ENST00000398568.6","ENST00000564326.5","ENST00000569418.5","ENST00000872836.1","ENST00000872837.1","ENST00000872839.1","ENST00000872840.1","ENST00000872843.1","ENST00000872846.1","ENST00000872849.1","ENST00000872852.1","ENST00000872853.1","ENST00000872854.1","ENST00000872855.1","ENST00000920612.1","ENST00000920613.1","ENST00000967677.1","ENST00000967678.1","ENST00000967679.1","ENST00000967682.1","ENST00000967684.1","ENST00000967687.1"],"refseq":["NM_001042355.2","NM_001042412.3","NM_001378744.1","NM_001378745.1","NM_001378746.1","NM_001378747.1","NM_001378748.1","NM_001378749.1","NM_001378750.1"],"refseqProteins":["NP_001035814.1","NP_001035877.1","NP_001365673.1","NP_001365674.1","NP_001365675.1","NP_001365676.1","NP_001365677.1","NP_001365678.1","NP_001365679.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,304],[305,308,649]],"edits":[{"start":305,"end":307,"original":"ALS","replacement":"","added":0}],"missing":3,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMissing":0,"features":[[0,3,0]],"interfaces":{},"model":{"entry":"AF-Q9NQC7-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9NQC7-2-F1-model_v6.cif","meanPlddt":74.3,"plddt":[[0,17],[50,1],[70,2],[90,5],[70,5],[50,7],[70,5],[90,5],[70,3],[50,2],[0,14],[50,2],[70,9],[50,1],[70,10],[90,5],[70,1],[90,9],[70,5],[90,7],[70,7],[90,12],[70,6],[90,11],[70,2],[50,4],[70,3],[90,8],[70,11],[90,1],[70,4],[90,4],[70,4],[90,12],[70,2],[50,1],[0,19],[50,2],[70,6],[90,3],[70,8],[90,7],[70,11],[90,7],[70,5],[90,1],[70,18],[90,5],[70,6],[50,1],[0,158],[50,2],[70,7],[90,1],[70,7],[90,7],[70,1],[90,1],[70,7],[90,6],[70,7],[90,2],[70,1],[90,1],[70,4],[90,4],[70,4],[90,6],[70,9],[50,2],[0,8],[50,1],[0,7],[50,4],[70,4],[90,1],[70,5],[90,1],[70,8],[90,12],[70,1],[90,70],[70,3],[