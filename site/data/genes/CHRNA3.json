2,294,295,296,297,299,300,301,305,308,309,312,313,316,319,320,323,324,326,327,330,331,333,334,335,336,337,440,441,443,444,445,446,447,448,449,450,451,453,454,455,458],"CHRND":[45,47,49,50,51,53,56,77,78,79,80,94,95,120,122,124,125,126,127,128,158,159,160,176,180,181,182,183,186,219,221,222,223,224,226,228,270,271,272,273,274,277,280,281,284,285,287,288,291,292,293,294,295,296,297,299,300,301,305,308,309,312,313,316,319,320,323,324,326,327,330,331,332,334,335,336,440,441,443,444,447,448,450,451,454,455,457,458,459,461,462],"CHRNE":[47,49,50,51,53,54,56,77,78,79,80,94,95,120,122,124,126,127,128,131,158,159,160,176,180,181,182,183,186,219,221,222,225,226,228,267,269,270,271,272,273,274,277,278,280,281,284,285,287,288,291,292,294,295,296,297,299,300,301,305,309,312,313,316,319,320,323,326,327,330,332,334,440,441,443,444,447,448,450,451,454],"CHRNG":[45,47,49,50,51,52,53,54,55,56,77,78,79,80,94,95,120,122,124,126,127,128,158,159,160,176,180,181,182,183,186,219,221,222,224,228,269,270,271,272,273,274,277,278,280,281,284,285,287,288,289,291,292,294,295,296,297,299,300,301,305,309,312,313,316,319,320,323,326,327,330,332,334,335,336,337,443,444,447,448,450,451,454,458],"HTR3A":[45,47,48,49,50,51,53,54,56,77,78,79,80,94,95,117,118,120,122,123,124,125,126,127,128,158,159,160,180,181,182,183,186,221,222,224,225,226,228,269,270,271,272,273,274,277,278,280,281,284,285,287,288,291,292,294,295,296,297,299,300,301,309,312,313,316,319,320,323,326,327,330,333,334,440,441,443,444,446,447,448,450,451,454,458]},"subunit":[{"topic":"Subunit","text":"Neuronal AChR is composed of two different types of subunits: alpha and beta. CHRNA3/Alpha-3 subunit can be combined to CHRNA5/alpha-5, CHRNB2/beta-2 CHRNB3/beta-3 or CHRNB4/beta-4 to give rise to functional receptors (PubMed:20881005, PubMed:31488329, PubMed:8663494). Forms stoichiometries such as (CHRNA3)2:(CHRNB4)3 or (CHRNA3:CHRNB4)2:CHRNB3 (PubMed:11118490). Part of a complex composed of STUB1/CHIP, VCP/p97, CHRNA3, and UBXN2A that modulates the ubiquitination and endoplasmic reticulum-associated degradation (ERAD) of CHRNA3 (PubMed:26265139). Within the complex UBXN2A acts as a scaffold protein required for the interaction of CHRNA3 with VCP/p97, this interaction also inhibits CHRNA3 ubiquitination by STUB1/CHIP and subsequently ERAD (PubMed:26265139). Interacts with UBXN2A (via SEP domain), the interaction is required for the interaction of CHRNA3 in the STUB1:VCP:UBXN2A complex (PubMed:26265139). Interacts with RIC3; which is required for proper folding and assembly (PubMed:16120769). Interacts with LYPD6 (PubMed:27344019)"}],"isoforms":[{"accession":"P32297-1","name":"1","synonyms":[],"notes":[],"length":504,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,1],[6,7,499]],"edits":[{"start":1,"end":6,"original":"MGSGPL","replacement":"MALAV","added":5}],"missing":0,"replaced":5,"novel":4,"foldedAbsent":0,"foldedMissing":0,"features":[[0,0,5]],"interfaces":{},"model":{"entry":"AF-P32297-1-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P32297-1-F1-model_v6.cif","meanPlddt":81.1,"plddt":[[0,9],[50,8],[70,1],[50,12],[70,2],[90,70],[70,1],[90,22],[70,10],[90,27],[70,3],[90,1],[70,1],[90,76],[70,1],[90,2],[70,3],[90,1],[70,9],[90,36],[70,1],[90,3],[70,1],[90,1],[70,5],[90,35],[70,2],[90,1],[70,12],[50,2],[0,36],[50,2],[0,3],[50,1],[0,1],[50,1],[0,1],[50,1],[0,6],[50,1],[0,22],[50,3],[70,9],[90,40],[70,11],[50,6],[0,2]],"losingConfidence":0}},{"accession":"P32297-3","name":"3","synonyms":[],"notes":[],"length":489,"transcripts":{"ensembl":["ENST00000348639.7"],"refseq":["NM_001166694.2"],"refseqProteins":["NP_001160166.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,463]],"edits":[{"start":464,"end":505,"original":"IQDDWKYVAMVIDRIFLWVFTLVCILGTAGLFLQPLMARE","replacement":"EQKAQEIQQLKRKEKSTETSDQEPGL","added":26}],"missing":0,"replaced":42,"novel":26,"foldedAbsent":34,"foldedMissing":0,"features":[[11,0,11],[1