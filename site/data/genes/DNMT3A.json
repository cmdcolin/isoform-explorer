:41742418). In contrast, short DNA linker regions, which are enriched at promoter regions, promote di-nucleosome bridging, blocking access to linker DNA, preventing methylation (PubMed:41742418). Associates with actively transcribed chromatin (euchromatin): recruited to chromatin by recognizing and binding histone H3 dimethylated and trimethylated at 'Lys-36' (H3K36me2 and H3K36me3) (PubMed:31485078). In contrast to isoform DNMT3A1, lacks the N-terminal UDR domain and does not bind histone H2A ubiquitinated at 'Lys-119' (H2AK119Ub) (PubMed:39043678, PubMed:39528729)"}],"length":723,"transcripts":{"ensembl":["ENST00000380746.8"],"refseq":["NM_153759.3"],"refseqProteins":["NP_715640.2"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,1],[25,214,699]],"edits":[{"start":1,"end":213,"original":"MPAMPSSGPGDTSSSAAEREEDRKDGEEQEEPRGKEERQE","replacement":"MGILERVVRRNGRVDRSLKDECDT","added":24}],"missing":212,"replaced":0,"novel":23,"foldedAbsent":10,"foldedMissing":10,"features":[[0,1,0],[1,1,0],[2,1,0],[3,55,0],[4,1,0],[5,1,0],[6,15,0]],"interfaces":{},"model":{"entry":"AF-Q9Y6K1-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q9Y6K1-2-F1-model_v6.cif","meanPlddt":80.8,"plddt":[[0,4],[50,4],[0,1],[50,1],[0,81],[50,2],[70,7],[90,10],[70,4],[90,8],[70,13],[90,8],[70,5],[90,23],[70,4],[90,16],[70,5],[50,3],[0,5],[50,5],[70,6],[90,11],[70,2],[90,7],[70,5],[50,3],[0,38],[50,4],[70,2],[90,52],[70,4],[90,2],[70,1],[90,6],[70,4],[90,33],[70,2],[90,7],[70,2],[90,13],[70,1],[90,2],[70,2],[90,1],[70,2],[50,6],[70,2],[50,1],[70,3],[90,76],[70,1],[90,16],[70,3],[90,26],[70,1],[90,56],[70,1],[90,3],[70,5],[90,23],[70,7],[90,1],[70,6],[90,6],[70,1],[90,57],[70,1]],"losingConfidence":9}},{"accession":"Q9Y6K1-3","name":"3","synonyms":[],"notes":[{"topic":"Miscellaneous","text":"Produced by alternative splicing"}],"length":166,"transcripts":{"ensembl":["ENST00000406659.3"],"refseq":["NM_001320892.2","NM_175630.1"],"refseqProteins":["NP_001307821.1","NP_783329.1"],"maneSelec