ZNF638 (PubMed:30487602). Interacts with ZNF263; recruited to the SIX3 promoter along with other proteins involved in chromatin modification and transcriptional corepression where it contributes to transcriptional repression (PubMed:32051553). Interacts with PHF13; the interaction probably enhances SETDB1 chromatin-associated levels and activity (PubMed:23034801). Interacts with VRK1 (PubMed:37179361)"}],"isoforms":[{"accession":"Q15047-2","name":"2","synonyms":[],"notes":[{"topic":"Function","text":"Lacks all domains required for histone methyltransferase activity"}],"length":397,"transcripts":{"ensembl":["ENST00000368962.6"],"refseq":["NM_001243491.2","NM_001393964.1","NM_001393965.1","NM_001393966.1"],"refseqProteins":["NP_001230420.1","NP_001380893.1","NP_001380894.1","NP_001380895.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,380]],"edits":[{"start":381,"end":1291,"original":"DDKRCEWIYRGSTRLEPMFSMKTSSASALEKKQGQLRTRP","replacement":"VLFFSTILEAEVGGGGT","added":17}],"missing":911,"replaced":0,"novel":17,"foldedAbsent":402,"foldedMissing":402,"features":[[8,23,0],[9,72,0],[10,74,0],[11,1,0],[12,1,0],[13,1,0],[14,1,0],[15,1,0],[16,1,0],[17,1,0],[18,1,0],[19,1,0],[20,1,0],[21,1,0],[22,1,0],[23,464,0],[24,1,0],[25,1,0],[26,1,0],[27,1,0],[28,1,0],[29,1,0],[30,1,0],[31,1,0],[32,1,0],[33,1,0],[34,1,0],[35,1,0],[36,1,0],[37,1,0],[38,17,0],[39,1,0],[40,1,0],[41,1,0]],"interfaces":{},"model":{"entry":"AF-Q15047-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-Q15047-2-F1-model_v6.cif","meanPlddt":80.6,"plddt":[[0,14],[50,4],[70,23],[90,1],[70,3],[90,2],[70,2],[90,3],[70,3],[90,2],[70,1],[90,1],[70,2],[90,2],[70,2],[90,1],[70,3],[90,1],[70,2],[90,1],[70,3],[90,1],[70,2],[90,2],[70,1],[90,23],[70,4],[50,2],[0,32],[50,4],[70,25],[50,3],[0,13],[50,1],[70,2],[90,44],[70,2],[90,32],[70,3],[90,69],[70,5],[90,11],[70,4],[90,18],[70,2],[50,1],[0,15]],"losingConfidence":0}},{"accession":"Q15047-3","name":"3","synonyms":[],"notes":[],"length":1290,"transcripts