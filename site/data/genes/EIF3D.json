ile subunit that binds to the eIF-3 complex via EIF3B. The eIF-3 complex interacts with RPS6KB1 under conditions of nutrient depletion. Mitogenic stimulation leads to binding and activation of a complex composed of MTOR and RPTOR, leading to phosphorylation and release of RPS6KB1 and binding of EIF4B to eIF-3"},{"topic":"Subunit","text":"(Microbial infection) Interacts with Norwalk virus VPg protein (PubMed:12773399)"}],"isoforms":[{"accession":"O15371-2","name":"2","synonyms":[],"notes":[],"length":499,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,53],[54,103,446]],"edits":[{"start":54,"end":102,"original":"RYTNKYSSQFGGGSQYAYFHEEDESSFQLVDTARTQKTAY","replacement":"","added":0}],"missing":49,"replaced":0,"novel":0,"foldedAbsent":0,"foldedMissing":0,"features":[],"interfaces":{},"model":{"entry":"AF-O15371-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-O15371-2-F1-model_v6.cif","meanPlddt":88.6,"plddt":[[50,1],[70,2],[90,4],[70,3],[90,4],[70,1],[90,1],[70,2],[90,1],[70,7],[90,1],[70,21],[50,17],[0,7],[50,10],[70,2],[50,1],[70,2],[50,9],[0,9],[50,1],[70,3],[90,123],[70,2],[90,16],[70,5],[90,26],[70,1],[90,13],[70,7],[90,31],[70,4],[90,137],[70,5],[50,1],[0,1],[50,18]],"losingConfidence":0}},{"accession":"O15371-3","name":"3","synonyms":[],"notes":[],"length":533,"transcripts":{"ensembl":[],"refseq":[],"refseqProteins":[],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,136],[137,152,397]],"edits":[{"start":137,"end":151,"original":"QKKFQKQFGVRQKWD","replacement":"","added":0}],"missing":15,"replaced":0,"novel":0,"foldedAbsent":3,"foldedMissing":3,"features":[],"interfaces":{},"model":{"entry":"AF-O15371-3-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-O15371-3-F1-model_v6.cif","meanPlddt":87.7,"plddt":[[50,1],[70,2],[90,14],[70,1],[90,18],[70,2],[90,5],[70,24],[90,5],[70,14],[50,8],[0,3],[50,1],[0,2],[50,3],[0,1],[50,3],[0,3],[50,1],[0,10],[50,15],[0,3],[50,2],[70,3],[9