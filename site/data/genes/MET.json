ond","start":697,"end":709,"description":""},{"type":"Domain","start":742,"end":836,"description":"IPT/TIG 3"},{"type":"Glycosylation","start":761,"end":761,"description":"O-linked (Man) threonine"},{"type":"Glycosylation","start":785,"end":785,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Glycosylation","start":879,"end":879,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Glycosylation","start":930,"end":930,"description":"N-linked (GlcNAc...) asparagine"},{"type":"Transmembrane","start":933,"end":955,"description":"Helical"},{"type":"Topological domain","start":956,"end":1390,"description":"Cytoplasmic"},{"type":"Modified residue","start":966,"end":966,"description":"Phosphoserine"},{"type":"Modified residue","start":977,"end":977,"description":"Phosphothreonine"},{"type":"Modified residue","start":990,"end":990,"description":"Phosphoserine"},{"type":"Modified residue","start":997,"end":997,"description":"Phosphoserine"},{"type":"Modified residue","start":1000,"end":1000,"description":"Phosphoserine"},{"type":"Site","start":1003,"end":1003,"description":"Required for ligand-induced CBL-mediated ubiquitination"},{"type":"Modified residue","start":1003,"end":1003,"description":"Phosphotyrosine"},{"type":"Site","start":1009,"end":1010,"description":"Breakpoint for translocation to form TPR-MET oncogene"},{"type":"Domain","start":1078,"end":1345,"description":"Protein kinase"},{"type":"Binding site","start":1084,"end":1092,"description":"ATP"},{"type":"Binding site","start":1110,"end":1110,"description":"ATP"},{"type":"Active site","start":1204,"end":1204,"description":"Proton acceptor"},{"type":"Region","start":1212,"end":1390,"description":"Interaction with RANBP9"},{"type":"Modified residue","start":1230,"end":1230,"description":"Phosphotyrosine"},{"type":"Modified residue","start":1234,"end":1234,"description":"Phosphotyrosine; by autocatalysis"},{"type":"Modified residue","start":1235,"end":1235,"description":"Phosphotyrosine; by autocatalysis"},{"type":"Modified residue","start":1289,"end":1289,"description":"Phosphothreonine"},{"type":"Region","start":1320,"end":1359,"description":"Interaction with MUC20"},{"type":"Modified residue","start":1349,"end":1349,"description":"Phosphotyrosine; by autocatalysis"},{"type":"Modified residue","start":1356,"end":1356,"description":"Phosphotyrosine; by autocatalysis"},{"type":"Modified residue","start":1365,"end":1365,"description":"Phosphotyrosine"}],"interfaces":{},"subunit":[{"topic":"Subunit","text":"Heterodimer made of an alpha chain (50 kDa) and a beta chain (145 kDa) which are disulfide linked. Binds PLXNB1. Interacts when phosphorylated with downstream effectors including STAT3, PIK3R1, SRC, PCLG1, GRB2 and GAB1. Interacts with SPSB1, SPSB2 and SPSB4 (By similarity). Interacts with INPP5D/SHIP1. When phosphorylated at Tyr-1356, interacts with INPPL1/SHIP2. Interacts with RANBP9 and RANBP10, as well as SPSB1, SPSB2, SPSB3 and SPSB4. SPSB1 binding occurs in the presence and in the absence of HGF, however HGF treatment has a positive effect on this interaction. Interacts with MUC20; prevents interaction with GRB2 and suppresses hepatocyte growth factor-induced cell proliferation. Interacts with GRB10. Interacts with PTPN1 and PTPN2. Interacts with LECT2; this interaction may have an antagonistic effect on receptor activation (PubMed:27334921). Interacts with HSP90AA1 and HSP90AB1; the interaction suppresses MET kinase activity (PubMed:26517842). Interacts with tensin TNS3 (PubMed:24814316). Interacts (when phosphorylated) with tensin TNS4 (via SH2 domain); the interaction increases MET protein stability by inhibiting MET endocytosis and subsequent lysosomal degradation (PubMed:24814316)"},{"topic":"Subunit","text":"(Microbial infection) Interacts via extracytoplasmic residues 25-656 with L.monocytogenes InlB; MET can bind HGF, its endogenous ligand, and InlB simultaneously (PubMed:11081636, PubMed:17662939). InlB probably dimerizes upon binding to MET, which encourages subsequent dimerization of MET (Probable)"}],"isoforms":[{"accession":"P08581-2","name":"2","synonyms":[],"notes":[],"length":1408,"transcripts":{"ensembl":["ENST00000318493.11"],"refseq":["NM_001127500.3"],"refseqProteins":["NP_001120972.1"],"maneSelect":false,"decay":[],"onlyDecay":false},"segments":[[1,1,755],[774,756,635]],"edits":[{"start":755,"end":755,"original":"S","replacement":"STWWKEPLNIVSFLFCFAS","added":19}],"missing":0,"replaced":0,"novel":18,"foldedAbsent":0,"foldedMissing":0,"features":[],"interfaces":{},"model":{"entry":"AF-P08581-2-F1","cif":"https://alphafold.ebi.ac.uk/files/AF-P08581-2-F1-model_v6.cif","meanPlddt":78,"plddt":[[0,24],[50,10],[70,8],[90,16],[70,1],[90,27],[70,1],[90,1],[70,24],[90,13],[70,3],[90,8],[70,2],[90,8],[70,7],[90,2],[70,1],[90,7],[70,8],[90,17],[70,4],[90,9],[70,3],[50,4],[70,2],[90,18],[70,4],[90,6],[70,2],[90,1],[70,5],[90,9],[70,2],[90,9],[70,7],[90,8],[70,3],[50,2],[70,4],[90,1],[70,1],[90,7],[70,2],[50,2],[0,6],[50,1],[70,2],[90,21],[70,2],[90,15],[70,4],[90,17],[70,5],[50,6],[70,6],[90,1],[70,5],[50,6],[0,1],[50,2],[0,3],[50,4],[0,3],[50,3],[70,7],[90,6],[70,4],[90,1],[70,2],[90,10],[70,3],[90,18],[70,2],[50,3],[70,7],[90,1],[70,2],[90,11],[70,4],[50,1],[70,1],[90,15],[70,23],[90,4],[70,3],[90,4],[70,2],[90,1],[70,4],[90,2],[70,5],[90,1],[70,1],[90,13],[70,1],[90,6],[70,8],[50,3],[70,5],[90,5],[70,4],[90,4],[70,7],[90,8],[70,8],[90,5],[70,4],[90,4],[70,2],[90,34],[70,2],[90,5],[70,2],[90,20],[70,3],[90,14],[70,3],[90,13],[70,2],[90,1],[70,4],[50,2],[0,17],[50,2],[70,5],[90,3],[70,7],[90,6],[70,15],[50,2],[70,21],[90,7],[70,6],[90,5],[70,8],[50,1],[70,7],[50,5],[70,31],[50,3],[70,11],[50,5],[70,7],[50,5],[70,7],[50,4],[0,2],[50,10],[70,1],[50,2],[70,3],[50,1],[70,2],[50,1],[70,1],[50,6],[0,95],[50,6],[70,17],[90,2],[70,1],[90,1],[70,6],[50,5],[70,3],[90,5],[70,6],[90,5],[70,3],[50,7],[70,15],[90,11],[70,3],[50,3],[70,4],[90,5],[70,3],[90,3],[70,1],[90,2],[70,9],[90,20],[70,3],[90,1],[70,2],[90,9],[70,1],