        "index": {
          "location": {
            "uri": "https://jbrowse.org/ucsc/hg38/gencode.v49.annotation.sorted.gff3.gz.csi",
            "locationType": "UriLocation"
          },
          "indexType": "CSI"
        }
      },
      "category": [
        "Genes and Gene Predictions"
      ],
      "assemblyNames": [
        "hg38"
      ]
    }
