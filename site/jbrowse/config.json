      "assemblyNames": [
        "hg38"
      ],
      "adapter": {
        "type": "Gff3TabixAdapter",
        "gffGzLocation": {
          "uri": "https://jbrowse.org/ucsc/hg38/ncbiRefSeqCurated.gff.gz"
        },
        "index": {
          "indexType": "CSI",
          "location": {
            "uri": "https://jbrowse.org/ucsc/hg38/ncbiRefSeqCurated.gff.gz.csi"
          }
        }
      },
      "metadata": {
        "ucsc": {
          "baseColorDefault": "genomicCodons",
          "baseColorUseCds": "given",
          "color": "12,12,120",
          "idXref": "ncbiRefSeqLink mrnaAcc name",
          "longLabel": "NCBI RefSeq genes, curated subset (NM_*, NR_*, NP_* or YP_*)",
          "parent": "refSeqComposite on",
          "priority": "2",
          "shortLabel": "RefSeq Curated",
          "track": "ncbiRefSeqCurated",
          "html": ""
        },
        "differsFromUcsc": {
          "note": "UCSC's table has no NCBI transcript attributes. Where a transcript's accession.version, span and exons match NCBI's GFF3 exactly, this track adds NCBI's feature type, tag (MANE Select, RefSeq Select), exception and transl_except. JBrowse picks a gene's representative isoform by that tag and translates selenocysteine through transl_except, so those transcripts can draw and translate differently than in the UCSC Genome Browser.",
          "ncbiAnnotationSource": "NCBI RefSeq GCF_000001405.40-RS_2025_08",
          "ncbiAnnotationDate": "2025-08-01",
          "matchedTranscripts": "104996 of 105019"
        }
      },
      "description": "NCBI RefSeq genes, curated subset (NM_*, NR_*, NP_* or YP_*) (differs from UCSC: NCBI's tags and transl_except added where transcripts match NCBI's annotation)",
      "category": [
        "Genes and Gene Predictions"
      ]
    },
    {
      "type": "FeatureTrack",
      "trackId": "hg38-gencodeComp",
      "name": "GENCODE V49 - Comprehensive gene annotation",
      "adapter": {
